{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.datapan.dev/datapan.credential-runtime-review-handoff.v1.schema.json",
  "title": "Datapan Credential Runtime Review Handoff v1",
  "description": "Reviewer-facing handoff for credential runtime receipt evidence requirements and manual-review relief blockers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "goal_issue",
    "handoff_ticket",
    "queue_ticket",
    "provider",
    "summary",
    "operator_contract",
    "release_boundary",
    "global_review_requirements",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "datapan.credential-runtime-review-handoff.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "goal_issue": {
      "const": 344
    },
    "handoff_ticket": {
      "const": 385
    },
    "queue_ticket": {
      "const": 375
    },
    "provider": {
      "const": "datapan-registry"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "operator_contract": {
      "$ref": "#/$defs/operator_contract"
    },
    "release_boundary": {
      "$ref": "#/$defs/release_boundary"
    },
    "global_review_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/global_requirement"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "receipt_state": {
      "enum": [
        "absent",
        "staged_only",
        "reviewed_rejected",
        "reviewed_accepted",
        "relief_eligible"
      ]
    },
    "review_state": {
      "enum": ["none", "reviewed_accepted", "reviewed_rejected"]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "credential_gated_sources",
        "pending_review_sources",
        "reviewed_receipts_checked_in",
        "relief_eligible_sources",
        "global_manual_review_relief_allowed",
        "manual_review_required",
        "default_ci_requires_credentials",
        "checked_in_secrets_allowed",
        "handoff_status"
      ],
      "properties": {
        "sources": {
          "$ref": "#/$defs/count"
        },
        "credential_gated_sources": {
          "$ref": "#/$defs/count"
        },
        "pending_review_sources": {
          "$ref": "#/$defs/count"
        },
        "reviewed_receipts_checked_in": {
          "$ref": "#/$defs/count"
        },
        "relief_eligible_sources": {
          "$ref": "#/$defs/count"
        },
        "global_manual_review_relief_allowed": {
          "type": "boolean"
        },
        "manual_review_required": {
          "type": "boolean"
        },
        "default_ci_requires_credentials": {
          "const": false
        },
        "checked_in_secrets_allowed": {
          "const": false
        },
        "handoff_status": {
          "enum": ["review_required", "relief_ready"]
        }
      }
    },
    "operator_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "queue",
        "handoff_check_command",
        "queue_check_command",
        "collection_runner_script",
        "receipt_promotion_script",
        "receipt_validation_command",
        "reviewed_receipt_glob",
        "default_ci_mode"
      ],
      "properties": {
        "queue": {
          "const": "reports/credential-runtime-receipt-collection-queue.json"
        },
        "handoff_check_command": {
          "const": "python3 scripts/generate-credential-runtime-review-handoff.py --check"
        },
        "queue_check_command": {
          "const": "python3 scripts/generate-credential-runtime-receipt-collection-queue.py --check"
        },
        "collection_runner_script": {
          "const": "scripts/run-credential-runtime-collection.py"
        },
        "receipt_promotion_script": {
          "const": "scripts/promote-credential-runtime-receipt.py"
        },
        "receipt_validation_command": {
          "const": "python3 scripts/validate-credential-runtime-receipts.py"
        },
        "reviewed_receipt_glob": {
          "const": "reports/credential-runtime-receipts/*-credentialed-receipt.json"
        },
        "default_ci_mode": {
          "const": "secret_free_review_handoff_validation"
        }
      }
    },
    "release_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_registry_compatible",
        "manual_review_required",
        "compatibility_effect",
        "live_evidence_claim",
        "relief_decision"
      ],
      "properties": {
        "canonical_registry_compatible": {
          "const": true
        },
        "manual_review_required": {
          "type": "boolean"
        },
        "compatibility_effect": {
          "const": "review_handoff_only"
        },
        "live_evidence_claim": {
          "const": "not_claimed_until_reviewed_receipts_exist"
        },
        "relief_decision": {
          "enum": [
            "blocked_until_all_sources_relief_eligible",
            "allowed_by_all_reviewed_validated_receipts"
          ]
        }
      }
    },
    "global_requirement": {
      "enum": [
        "one_reviewed_redacted_receipt_per_credential_gated_source",
        "all_reviewed_receipts_validate_in_default_ci",
        "all_reviewed_receipts_have_reviewed_accepted_state",
        "all_reviewed_receipts_have_verified_outcome_and_no_error_class",
        "no_secret_values_hashes_headers_or_service_keys_checked_in",
        "source_runtime_remediation_and_consumer_compatibility_counts_recompute_after_promotion"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "provider",
        "current_receipt_state",
        "checked_in_review_state",
        "checked_in_receipt_present",
        "receipt_relief_eligible",
        "expected_evidence",
        "operator_commands",
        "review_packet_requirements",
        "relief_blockers",
        "next_reviewer_action"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "provider": {
          "$ref": "#/$defs/non_empty_string"
        },
        "current_receipt_state": {
          "$ref": "#/$defs/receipt_state"
        },
        "checked_in_review_state": {
          "$ref": "#/$defs/review_state"
        },
        "checked_in_receipt_present": {
          "type": "boolean"
        },
        "receipt_relief_eligible": {
          "type": "boolean"
        },
        "expected_evidence": {
          "$ref": "#/$defs/expected_evidence"
        },
        "operator_commands": {
          "$ref": "#/$defs/operator_commands"
        },
        "review_packet_requirements": {
          "type": "array",
          "minItems": 5,
          "items": {
            "$ref": "#/$defs/review_packet_requirement"
          }
        },
        "relief_blockers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relief_blocker"
          }
        },
        "next_reviewer_action": {
          "enum": [
            "collect_validate_review_and_promote_redacted_receipt",
            "keep_manual_review_boundary_or_request_new_receipt",
            "confirm_verified_no_error_outcome_or_keep_global_relief_blocked",
            "wait_for_remaining_sources_before_global_relief",
            "maintain_reviewed_receipt_evidence"
          ]
        }
      }
    },
    "expected_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_batch",
        "runtime_evidence_plan",
        "staged_receipt_path",
        "reviewed_receipt_path"
      ],
      "properties": {
        "candidate_batch": {
          "$ref": "#/$defs/non_empty_string"
        },
        "runtime_evidence_plan": {
          "$ref": "#/$defs/non_empty_string"
        },
        "staged_receipt_path": {
          "$ref": "#/$defs/non_empty_string"
        },
        "reviewed_receipt_path": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "operator_commands": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collection_preflight",
        "collection_run",
        "staged_receipt_validation",
        "reviewed_receipt_promotion",
        "reviewed_receipt_validation"
      ],
      "properties": {
        "collection_preflight": {
          "$ref": "#/$defs/non_empty_string"
        },
        "collection_run": {
          "$ref": "#/$defs/non_empty_string"
        },
        "staged_receipt_validation": {
          "$ref": "#/$defs/non_empty_string"
        },
        "reviewed_receipt_promotion": {
          "$ref": "#/$defs/non_empty_string"
        },
        "reviewed_receipt_validation": {
          "const": "python3 scripts/validate-credential-runtime-receipts.py"
        }
      }
    },
    "review_packet_requirement": {
      "enum": [
        "staged_receipt_schema_valid",
        "staged_receipt_redaction_safe",
        "review_metadata_present_before_check_in",
        "review_decision_matches_receipt_outcome",
        "reviewed_receipt_validates_in_default_ci"
      ]
    },
    "relief_blocker": {
      "enum": [
        "reviewed_receipt_absent",
        "credentialed_runtime_check_not_reviewed",
        "staged_receipt_not_checked_in",
        "review_metadata_absent",
        "review_decision_keeps_manual_review_boundary",
        "source_receipt_not_relief_eligible",
        "waiting_for_remaining_credential_gated_sources",
        "global_manual_review_reduction_blocked"
      ]
    }
  }
}
