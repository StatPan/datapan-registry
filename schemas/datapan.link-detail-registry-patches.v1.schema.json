{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.datapan.dev/datapan.link-detail-registry-patches.v1.schema.json",
  "title": "Datapan Link Detail Registry Patches v1",
  "description": "Adapter-safe operation patch evidence generated from data.go.kr link-detail enrichment.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "summary", "patches"],
  "properties": {
    "schema_version": {
      "const": "datapan.link-detail-registry-patches.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "patches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/patch"
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "failed": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_label",
        "organization",
        "input_apis",
        "details_fetched",
        "patches",
        "operations_to_add",
        "skipped",
        "failed",
        "registered_hosts"
      ],
      "properties": {
        "batch_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "organization": {
          "$ref": "#/$defs/non_empty_string"
        },
        "input_apis": {
          "$ref": "#/$defs/count"
        },
        "details_fetched": {
          "$ref": "#/$defs/count"
        },
        "patches": {
          "$ref": "#/$defs/count"
        },
        "operations_to_add": {
          "$ref": "#/$defs/count"
        },
        "skipped": {
          "$ref": "#/$defs/count"
        },
        "failed": {
          "$ref": "#/$defs/count"
        },
        "registered_hosts": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "title",
        "organization",
        "action",
        "operation_count",
        "hosts",
        "operations"
      ],
      "properties": {
        "dataset_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "title": {
          "$ref": "#/$defs/non_empty_string"
        },
        "organization": {
          "$ref": "#/$defs/non_empty_string"
        },
        "action": {
          "const": "replace_empty_operations"
        },
        "operation_count": {
          "type": "integer",
          "minimum": 1
        },
        "hosts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "uniqueItems": true
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/operation"
          }
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "endpoint", "source"],
      "properties": {
        "name": {
          "$ref": "#/$defs/non_empty_string"
        },
        "endpoint": {
          "$ref": "#/$defs/non_empty_string"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "url", "raw"],
      "properties": {
        "system": {
          "const": "data.go.kr"
        },
        "url": {
          "$ref": "#/$defs/non_empty_string"
        },
        "raw": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean", "null"]
          }
        }
      }
    }
  }
}
