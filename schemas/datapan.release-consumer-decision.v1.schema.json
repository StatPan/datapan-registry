{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.datapan.dev/datapan.release-consumer-decision.v1.schema.json",
  "title": "Datapan Release Consumer Decision v1",
  "description": "Machine-readable release decision that folds registry distribution, compatibility, manual-review, and goal audit evidence into a consumer-facing action.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "goal_issue",
    "decision_ticket",
    "provider",
    "inputs",
    "summary",
    "decision_factors",
    "consumer_actions"
  ],
  "properties": {
    "schema_version": {
      "const": "datapan.release-consumer-decision.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "goal_issue": {
      "const": 344
    },
    "decision_ticket": {
      "const": 395
    },
    "provider": {
      "const": "datapan-registry"
    },
    "inputs": {
      "$ref": "#/$defs/inputs"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "decision_factors": {
      "$ref": "#/$defs/decision_factors"
    },
    "consumer_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/consumer_action"
      }
    }
  },
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "bytes": {
      "type": "integer",
      "minimum": 0
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest",
        "release_consumer_compatibility",
        "release_distribution_footprint",
        "manual_review_acceptance",
        "goal_completion_audit",
        "self_artifact_excluded"
      ],
      "properties": {
        "manifest": {
          "const": "manifest.json"
        },
        "release_consumer_compatibility": {
          "const": "reports/release-consumer-compatibility.json"
        },
        "release_distribution_footprint": {
          "const": "reports/release-distribution-footprint.json"
        },
        "manual_review_acceptance": {
          "const": "reports/credential-runtime-manual-review-acceptance.json"
        },
        "goal_completion_audit": {
          "const": "docs/release-ledger-goal-completion-audit.json"
        },
        "self_artifact_excluded": {
          "const": true
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_decision",
        "canonical_registry_consumption",
        "shard_assets_required",
        "manual_review_required",
        "manual_review_accepted",
        "reviewed_credential_receipts",
        "goal_completion_allowed",
        "goal_status"
      ],
      "properties": {
        "release_decision": {
          "enum": ["safe_to_consume", "manual_review_required", "blocked"]
        },
        "canonical_registry_consumption": {
          "const": "compatible"
        },
        "shard_assets_required": {
          "const": false
        },
        "manual_review_required": {
          "type": "boolean"
        },
        "manual_review_accepted": {
          "type": "boolean"
        },
        "reviewed_credential_receipts": {
          "$ref": "#/$defs/count"
        },
        "goal_completion_allowed": {
          "type": "boolean"
        },
        "goal_status": {
          "enum": ["complete", "not_complete"]
        }
      }
    },
    "decision_factors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_registry_path",
        "canonical_registry_bytes",
        "registry_footprint_status",
        "canonical_registry_required",
        "monolith_fallback_required",
        "compatibility_effect",
        "manual_review_acceptance_status",
        "manual_review_boundary_accepted",
        "manual_review_goal_completion_effect",
        "credential_handoff_status",
        "credential_collection_preflight_status",
        "credential_collection_preflight_reviewed_receipts_missing",
        "credential_collection_preflight_operator_environment_required_sources",
        "credential_queue_status",
        "credential_handoff_relief_eligible_sources",
        "credential_handoff_global_manual_review_relief_allowed",
        "manual_review_reduction_allowed",
        "goal_audit_decision"
      ],
      "properties": {
        "canonical_registry_path": {
          "const": "data/data-go-kr.registry.json"
        },
        "canonical_registry_bytes": {
          "$ref": "#/$defs/bytes"
        },
        "registry_footprint_status": {
          "enum": ["large_monolith_shard_additive", "within_monolith_budget"]
        },
        "canonical_registry_required": {
          "const": true
        },
        "monolith_fallback_required": {
          "const": true
        },
        "compatibility_effect": {
          "$ref": "#/$defs/non_empty_string"
        },
        "manual_review_acceptance_status": {
          "$ref": "#/$defs/non_empty_string"
        },
        "manual_review_boundary_accepted": {
          "type": "boolean"
        },
        "manual_review_goal_completion_effect": {
          "$ref": "#/$defs/non_empty_string"
        },
        "credential_handoff_status": {
          "$ref": "#/$defs/non_empty_string"
        },
        "credential_collection_preflight_status": {
          "enum": [
            "collection_required_operator_environment_needed",
            "collection_inputs_ready_operator_environment_needed",
            "reviewed_receipts_complete"
          ]
        },
        "credential_collection_preflight_reviewed_receipts_missing": {
          "$ref": "#/$defs/count"
        },
        "credential_collection_preflight_operator_environment_required_sources": {
          "$ref": "#/$defs/count"
        },
        "credential_queue_status": {
          "$ref": "#/$defs/non_empty_string"
        },
        "credential_handoff_relief_eligible_sources": {
          "$ref": "#/$defs/count"
        },
        "credential_handoff_global_manual_review_relief_allowed": {
          "type": "boolean"
        },
        "manual_review_reduction_allowed": {
          "type": "boolean"
        },
        "goal_audit_decision": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "consumer_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumer", "action", "reason"],
      "properties": {
        "consumer": {
          "$ref": "#/$defs/non_empty_string"
        },
        "action": {
          "enum": [
            "consume_canonical_registry",
            "manual_review_before_release_adoption",
            "keep_shards_optional",
            "do_not_finish_goal"
          ]
        },
        "reason": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    }
  }
}
