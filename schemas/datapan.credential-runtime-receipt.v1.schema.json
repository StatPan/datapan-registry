{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.datapan.dev/datapan.credential-runtime-receipt.v1.schema.json",
  "title": "Datapan Credential Runtime Receipt v1",
  "description": "Redacted receipt for operator-run credential-gated source runtime evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "source_id",
    "provider",
    "candidate_batch",
    "runtime_evidence_plan",
    "credential_configured",
    "credential_envs",
    "bounded",
    "execution",
    "outcome",
    "error_class",
    "redaction"
  ],
  "properties": {
    "schema_version": {
      "const": "datapan.credential-runtime-receipt.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "candidate_batch": {
      "type": "string",
      "minLength": 1
    },
    "runtime_evidence_plan": {
      "type": "string",
      "minLength": 1
    },
    "credential_configured": {
      "type": "boolean"
    },
    "credential_envs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "bounded": {
      "const": true
    },
    "execution": {
      "$ref": "#/$defs/execution"
    },
    "outcome": {
      "enum": ["verified", "failed", "skipped", "manual_review_required"]
    },
    "error_class": {
      "enum": ["none", "credential", "rate_limit", "provider", "parser", "network", "timeout", "unknown", "not_run"]
    },
    "response_metadata": {
      "$ref": "#/$defs/metadata"
    },
    "redaction": {
      "$ref": "#/$defs/redaction"
    }
  },
  "$defs": {
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "finished_at", "duration_ms", "request_count"],
      "properties": {
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "request_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 512
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "propertyNames": {
        "not": {
          "enum": [
            "credential_value",
            "credential_hash",
            "authorization_header",
            "service_key",
            "serviceKey",
            "api_key",
            "apiKey",
            "secret"
          ]
        }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secret_values_present",
        "secret_hashes_present",
        "forbidden_fields_checked"
      ],
      "properties": {
        "secret_values_present": {
          "const": false
        },
        "secret_hashes_present": {
          "const": false
        },
        "forbidden_fields_checked": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  }
}
