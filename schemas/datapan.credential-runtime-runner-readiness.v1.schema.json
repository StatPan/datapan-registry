{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.datapan.dev/datapan.credential-runtime-runner-readiness.v1.schema.json",
  "title": "Datapan Credential Runtime Runner Readiness v1",
  "description": "Secret-free checked-in readiness evidence for the credential runtime collection runner in default CI mode.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "goal_issue",
    "runner_readiness_ticket",
    "provider",
    "inputs",
    "summary",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "datapan.credential-runtime-runner-readiness.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "goal_issue": {
      "const": 344
    },
    "runner_readiness_ticket": {
      "const": 431
    },
    "provider": {
      "const": "datapan-registry"
    },
    "inputs": {
      "$ref": "#/$defs/inputs"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "env_name": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "queue",
        "runner",
        "runner_plan_schema_version",
        "runner_plan_mode",
        "environment_mode",
        "local_session_output",
        "local_session_review_plan_output"
      ],
      "properties": {
        "queue": {
          "const": "reports/credential-runtime-receipt-collection-queue.json"
        },
        "runner": {
          "const": "scripts/run-credential-runtime-collection.py"
        },
        "runner_plan_schema_version": {
          "const": "datapan.credential-runtime-collection-runner-plan.v1"
        },
        "runner_plan_mode": {
          "const": "secret_free_default_ci_readiness"
        },
        "environment_mode": {
          "const": "credential_env_values_not_read"
        },
        "local_session_output": {
          "const": ".datapan/runtime-evidence/credential-runtime-collection-session.json"
        },
        "local_session_review_plan_output": {
          "const": ".datapan/runtime-evidence/credential-runtime-session-review-plan.json"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "credential_gated_sources",
        "candidate_batches_present",
        "candidate_batches_missing",
        "ready_to_run_without_credentials",
        "blocked_on_operator_env",
        "blocked_on_candidate_batch",
        "staged_receipts_present",
        "reviewed_receipts_present",
        "reviewed_receipts_missing",
        "default_ci_requires_credentials",
        "checked_in_secrets_allowed",
        "manual_review_reduction_allowed",
        "local_session_artifacts_checked_in",
        "runner_status",
        "release_evidence_status"
      ],
      "properties": {
        "sources": {
          "$ref": "#/$defs/count"
        },
        "credential_gated_sources": {
          "$ref": "#/$defs/count"
        },
        "candidate_batches_present": {
          "$ref": "#/$defs/count"
        },
        "candidate_batches_missing": {
          "$ref": "#/$defs/count"
        },
        "ready_to_run_without_credentials": {
          "const": 0
        },
        "blocked_on_operator_env": {
          "$ref": "#/$defs/count"
        },
        "blocked_on_candidate_batch": {
          "$ref": "#/$defs/count"
        },
        "staged_receipts_present": {
          "$ref": "#/$defs/count"
        },
        "reviewed_receipts_present": {
          "$ref": "#/$defs/count"
        },
        "reviewed_receipts_missing": {
          "$ref": "#/$defs/count"
        },
        "default_ci_requires_credentials": {
          "const": false
        },
        "checked_in_secrets_allowed": {
          "const": false
        },
        "manual_review_reduction_allowed": {
          "type": "boolean"
        },
        "local_session_artifacts_checked_in": {
          "const": false
        },
        "runner_status": {
          "enum": [
            "operator_credentials_required",
            "candidate_batches_missing",
            "reviewed_receipts_complete"
          ]
        },
        "release_evidence_status": {
          "const": "checked_in_runner_readiness_only"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "provider",
        "credential_envs",
        "credential_envs_present",
        "missing_credential_envs",
        "readiness_blockers",
        "candidate_batch",
        "candidate_batch_present",
        "staged_receipt_path",
        "staged_receipt_present",
        "reviewed_receipt_path",
        "reviewed_receipt_present",
        "can_run_without_credentials",
        "collection_command",
        "staged_receipt_validation_command",
        "reviewed_receipt_promotion_command",
        "next_action"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "provider": {
          "$ref": "#/$defs/non_empty_string"
        },
        "credential_envs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/env_name"
          },
          "uniqueItems": true
        },
        "credential_envs_present": {
          "const": false
        },
        "missing_credential_envs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/env_name"
          },
          "uniqueItems": true
        },
        "readiness_blockers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "missing_credential_env",
              "missing_candidate_batch",
              "reviewed_receipt_present"
            ]
          },
          "uniqueItems": true
        },
        "candidate_batch": {
          "$ref": "#/$defs/non_empty_string"
        },
        "candidate_batch_present": {
          "type": "boolean"
        },
        "staged_receipt_path": {
          "$ref": "#/$defs/non_empty_string"
        },
        "staged_receipt_present": {
          "type": "boolean"
        },
        "reviewed_receipt_path": {
          "$ref": "#/$defs/non_empty_string"
        },
        "reviewed_receipt_present": {
          "type": "boolean"
        },
        "can_run_without_credentials": {
          "const": false
        },
        "collection_command": {
          "$ref": "#/$defs/non_empty_string"
        },
        "staged_receipt_validation_command": {
          "$ref": "#/$defs/non_empty_string"
        },
        "reviewed_receipt_promotion_command": {
          "$ref": "#/$defs/non_empty_string"
        },
        "next_action": {
          "enum": [
            "provide_operator_credentials_then_run_collection",
            "restore_candidate_batch_before_operator_collection",
            "reviewed_receipt_already_present"
          ]
        }
      }
    }
  }
}
