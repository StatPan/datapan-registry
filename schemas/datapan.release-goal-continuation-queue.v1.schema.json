{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.datapan.dev/datapan.release-goal-continuation-queue.v1.schema.json",
  "title": "Datapan Release Goal Continuation Queue v1",
  "description": "Machine-readable continuation queue for selecting safe next child work when the long-running registry-ledger goal remains open.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "goal_issue",
    "continuation_ticket",
    "provider",
    "inputs",
    "summary",
    "finish_boundary",
    "release_evidence_refresh",
    "blocking_evidence",
    "candidates"
  ],
  "properties": {
    "schema_version": {
      "const": "datapan.release-goal-continuation-queue.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "goal_issue": {
      "const": 344
    },
    "continuation_ticket": {
      "const": 403
    },
    "provider": {
      "const": "datapan-registry"
    },
    "inputs": {
      "$ref": "#/$defs/inputs"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "finish_boundary": {
      "$ref": "#/$defs/finish_boundary"
    },
    "release_evidence_refresh": {
      "$ref": "#/$defs/release_evidence_refresh"
    },
    "blocking_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/blocking_evidence"
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    }
  },
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal_completion_audit",
        "release_goal_finish_preflight",
        "release_consumer_decision",
        "credential_collection_preflight",
        "credential_runner_readiness",
        "credential_review_handoff",
        "release_operational_pressure"
      ],
      "properties": {
        "goal_completion_audit": {
          "const": "docs/release-ledger-goal-completion-audit.json"
        },
        "release_goal_finish_preflight": {
          "const": "reports/release-goal-finish-preflight.json"
        },
        "release_consumer_decision": {
          "const": "reports/release-consumer-decision.json"
        },
        "credential_collection_preflight": {
          "const": "reports/credential-runtime-collection-preflight.json"
        },
        "credential_runner_readiness": {
          "const": "reports/credential-runtime-runner-readiness.json"
        },
        "credential_review_handoff": {
          "const": "reports/credential-runtime-review-handoff.json"
        },
        "release_operational_pressure": {
          "const": "reports/release-operational-pressure.json"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finish_allowed",
        "goal_status",
        "release_decision",
        "operational_pressure_decision",
        "distribution_pressure_present",
        "credential_pressure_present",
        "goal_completion_allowed",
        "reviewed_credential_receipts",
        "reviewed_receipts_missing",
        "manual_review_required",
        "manual_review_accepted",
        "candidate_count",
        "primary_candidate",
        "next_action",
        "goal_closure_allowed"
      ],
      "properties": {
        "finish_allowed": {
          "type": "boolean"
        },
        "goal_status": {
          "enum": ["complete", "not_complete"]
        },
        "release_decision": {
          "enum": ["safe_to_consume", "manual_review_required", "blocked"]
        },
        "operational_pressure_decision": {
          "enum": [
            "distribution_and_credential_pressure",
            "distribution_latency_pressure",
            "credential_runtime_pressure",
            "goal_boundary_pressure",
            "operational_pressure_resolved"
          ]
        },
        "distribution_pressure_present": {
          "type": "boolean"
        },
        "credential_pressure_present": {
          "type": "boolean"
        },
        "goal_completion_allowed": {
          "type": "boolean"
        },
        "reviewed_credential_receipts": {
          "$ref": "#/$defs/count"
        },
        "reviewed_receipts_missing": {
          "$ref": "#/$defs/count"
        },
        "manual_review_required": {
          "type": "boolean"
        },
        "manual_review_accepted": {
          "type": "boolean"
        },
        "candidate_count": {
          "$ref": "#/$defs/count"
        },
        "primary_candidate": {
          "$ref": "#/$defs/non_empty_string"
        },
        "next_action": {
          "enum": ["create_child_ticket", "goal_finish_allowed"]
        },
        "goal_closure_allowed": {
          "type": "boolean"
        }
      }
    },
    "finish_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finish_guard_command",
        "finish_preflight",
        "finish_allowed",
        "next_action",
        "blocking_evidence_count"
      ],
      "properties": {
        "finish_guard_command": {
          "const": "python3 scripts/guard-release-goal-finish.py"
        },
        "finish_preflight": {
          "const": "reports/release-goal-finish-preflight.json"
        },
        "finish_allowed": {
          "type": "boolean"
        },
        "next_action": {
          "enum": ["do_not_finish_goal", "goal_finish_allowed"]
        },
        "blocking_evidence_count": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "release_evidence_refresh": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "refresh_command",
        "check_command",
        "max_iterations",
        "applies_after",
        "goal_closure_effect"
      ],
      "properties": {
        "refresh_command": {
          "const": "python3 scripts/refresh-release-ledger-evidence.py --write --max-iterations 5"
        },
        "check_command": {
          "const": "python3 scripts/refresh-release-ledger-evidence.py --check"
        },
        "max_iterations": {
          "const": 5
        },
        "applies_after": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "reviewed_credential_receipt_collection",
              "reviewed_credential_receipt_promotion",
              "manual_review_acceptance_decision",
              "shard_preferred_consumer_compatibility"
            ]
          },
          "uniqueItems": true
        },
        "goal_closure_effect": {
          "const": "refresh_may_update_evidence_but_does_not_close_goal_without_goal_finish_preflight"
        }
      }
    },
    "blocking_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "finding"],
      "properties": {
        "id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "path": {
          "$ref": "#/$defs/non_empty_string"
        },
        "finding": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "id",
        "title",
        "capability_planes",
        "evidence_inputs",
        "safe_start_conditions",
        "blocked_finish_conditions",
        "proposed_acceptance_criteria",
        "post_completion_commands",
        "goal_closure_allowed",
        "rationale"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "title": {
          "$ref": "#/$defs/non_empty_string"
        },
        "capability_planes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "uniqueItems": true
        },
        "evidence_inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "uniqueItems": true
        },
        "safe_start_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "blocked_finish_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "proposed_acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "post_completion_commands": {
          "type": "array",
          "prefixItems": [
            {
              "const": "python3 scripts/refresh-release-ledger-evidence.py --write --max-iterations 5"
            },
            {
              "const": "python3 scripts/refresh-release-ledger-evidence.py --check"
            }
          ],
          "items": false
        },
        "goal_closure_allowed": {
          "const": false
        },
        "rationale": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    }
  }
}
