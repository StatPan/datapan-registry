{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.datapan.dev/datapan.failure-recovery-rollup.v1.schema.json",
  "title": "Datapan Failure Recovery Rollup v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "generated_at", "policy", "observations", "summary", "failures", "work_items", "recovery_receipts"],
  "properties": {
    "schema_version": {"const": "datapan.failure-recovery-rollup.v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "policy": {"type": "string", "const": "policy/failure-recovery.json"},
    "observations": {"type": "string", "const": "reports/failure-observations.json"},
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["identities", "active", "transient", "persistent", "recovered", "owned", "unowned", "overdue", "durable_work_items"],
      "properties": {"identities": {"$ref": "#/$defs/count"}, "active": {"$ref": "#/$defs/count"}, "transient": {"$ref": "#/$defs/count"}, "persistent": {"$ref": "#/$defs/count"}, "recovered": {"$ref": "#/$defs/count"}, "owned": {"$ref": "#/$defs/count"}, "unowned": {"$ref": "#/$defs/count"}, "overdue": {"$ref": "#/$defs/count"}, "durable_work_items": {"$ref": "#/$defs/count"}}
    },
    "failures": {"type": "array", "items": {"$ref": "#/$defs/failure"}},
    "work_items": {"type": "array", "items": {"$ref": "#/$defs/work_item"}},
    "recovery_receipts": {"type": "array", "items": {"$ref": "#/$defs/recovery"}}
  },
  "$defs": {
    "count": {"type": "integer", "minimum": 0},
    "failure": {
      "type": "object", "additionalProperties": false,
      "required": ["failure_id", "source_id", "failure_class", "subject_id", "status", "severity", "owner", "recurrence_count", "recurrence_threshold", "first_observed_at", "last_observed_at", "due_at", "overdue", "retry", "recovery_action", "evidence"],
      "properties": {
        "failure_id": {"type": "string", "pattern": "^failure:[a-z_]+:[a-z0-9_]+:[a-f0-9]{16}$"},
        "source_id": {"type": "string"}, "failure_class": {"type": "string"}, "subject_id": {"type": "string"},
        "status": {"enum": ["transient", "persistent", "recovered"]}, "severity": {"type": "string"},
        "owner": {"type": ["string", "null"]}, "recurrence_count": {"$ref": "#/$defs/count"},
        "recurrence_threshold": {"type": "integer", "minimum": 1}, "first_observed_at": {"type": "string", "format": "date-time"},
        "last_observed_at": {"type": "string", "format": "date-time"}, "due_at": {"type": "string", "format": "date-time"},
        "overdue": {"type": "boolean"}, "retry": {"type": "object"}, "recovery_action": {"type": "string"},
        "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "work_item": {
      "type": "object", "additionalProperties": false,
      "required": ["work_key", "status", "ticket", "owner", "failure_ids", "evidence", "next_action"],
      "properties": {
        "work_key": {"type": "string", "pattern": "^failure-work:[a-z0-9:_-]+$"},
        "status": {"enum": ["existing", "create", "recovered"]}, "ticket": {"type": ["integer", "null"]},
        "owner": {"type": "string"}, "failure_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "next_action": {"type": "string", "minLength": 1}
      }
    },
    "recovery": {
      "type": "object", "additionalProperties": false,
      "required": ["failure_id", "recovered_at", "evidence", "coverage_update_required"],
      "properties": {"failure_id": {"type": "string"}, "recovered_at": {"type": "string", "format": "date-time"}, "evidence": {"type": "string"}, "coverage_update_required": {"const": true}}
    }
  }
}
