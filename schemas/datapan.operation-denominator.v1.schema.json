{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.datapan.dev/datapan.operation-denominator.v1.schema.json",
  "title": "Datapan supported operation denominator v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "source_id",
    "provider",
    "scope",
    "provenance",
    "identity_fields",
    "summary",
    "operations",
    "maintenance"
  ],
  "properties": {
    "schema_version": {
      "const": "datapan.operation-denominator.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "definition",
        "unknown_upstream_operations_covered"
      ],
      "properties": {
        "kind": {
          "enum": [
            "enumerated_supported_operations",
            "aggregate_supported_catalog"
          ]
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "unknown_upstream_operations_covered": {
          "const": false
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_profile",
        "catalog_artifact",
        "reviewed_at"
      ],
      "properties": {
        "source_profile": {
          "type": "string",
          "minLength": 1
        },
        "catalog_artifact": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_at": {
          "type": "string",
          "format": "date"
        },
        "documentation_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact_path",
            "artifact_sha256",
            "schema_uri",
            "source_id",
            "operation_id",
            "source_document_sha256",
            "source_locator"
          ],
          "properties": {
            "artifact_path": {
              "type": "string",
              "minLength": 1
            },
            "artifact_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "schema_uri": {
              "const": "https://schemas.datapan.dev/datapan.operation-document-evidence.v2.schema.json"
            },
            "source_id": {
              "const": "kosis"
            },
            "operation_id": {
              "const": "kosis-statistics-data-dt-1b41"
            },
            "source_document_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "source_locator": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "kind",
                "byte_start",
                "byte_end"
              ],
              "properties": {
                "source_id": {
                  "const": "kosis_official_devguide"
                },
                "kind": {
                  "const": "html_byte_range"
                },
                "byte_start": {
                  "type": "integer",
                  "minimum": 0
                },
                "byte_end": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    },
    "identity_fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operations",
        "callable_operations"
      ],
      "properties": {
        "operations": {
          "type": "integer",
          "minimum": 1
        },
        "callable_operations": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "method",
          "endpoint_template",
          "callable"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "endpoint_template": {
            "type": "string",
            "minLength": 1
          },
          "callable": {
            "type": "boolean"
          }
        }
      }
    },
    "maintenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "refresh_owner",
        "refresh_trigger"
      ],
      "properties": {
        "refresh_owner": {
          "const": "datapan-registry"
        },
        "refresh_trigger": {
          "enum": [
            "scheduled_catalog_observation",
            "source_profile_or_candidate_change"
          ]
        }
      }
    }
  }
}
