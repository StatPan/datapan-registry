{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.datapan.dev/datapan.credential-runtime-session-review-plan.v1.schema.json",
  "title": "Datapan Credential Runtime Session Review Plan v1",
  "description": "Secret-free local reviewer plan derived from a validated credential runtime collection session.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_from",
    "summary",
    "checked_in_boundaries",
    "review_plan"
  ],
  "properties": {
    "schema_version": {
      "const": "datapan.credential-runtime-session-review-plan.v1"
    },
    "generated_from": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session",
        "queue",
        "session_schema",
        "session_validation_command"
      ],
      "properties": {
        "session": {
          "$ref": "#/$defs/path"
        },
        "queue": {
          "$ref": "#/$defs/path"
        },
        "session_schema": {
          "const": "schemas/datapan.credential-runtime-collection-session.v1.schema.json"
        },
        "session_validation_command": {
          "$ref": "#/$defs/safe_string"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "succeeded",
        "skipped_not_ready",
        "failed",
        "staged_receipts_to_review",
        "next_action"
      ],
      "properties": {
        "sources": {
          "$ref": "#/$defs/count"
        },
        "succeeded": {
          "$ref": "#/$defs/count"
        },
        "skipped_not_ready": {
          "$ref": "#/$defs/count"
        },
        "failed": {
          "$ref": "#/$defs/count"
        },
        "staged_receipts_to_review": {
          "$ref": "#/$defs/count"
        },
        "next_action": {
          "enum": [
            "validate_and_review_staged_receipts",
            "resolve_readiness_or_failures_before_review"
          ]
        }
      }
    },
    "checked_in_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checked_in_session_output_allowed",
        "checked_in_review_plan_allowed",
        "checked_in_secrets_allowed",
        "goal_completion_effect"
      ],
      "properties": {
        "checked_in_session_output_allowed": {
          "const": false
        },
        "checked_in_review_plan_allowed": {
          "const": false
        },
        "checked_in_secrets_allowed": {
          "const": false
        },
        "goal_completion_effect": {
          "const": "progress_evidence_only_goal_remains_open"
        }
      }
    },
    "review_plan": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/succeeded_item"
          },
          {
            "$ref": "#/$defs/skipped_item"
          },
          {
            "$ref": "#/$defs/failed_item"
          }
        ]
      }
    }
  },
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9_]+$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\\\]+$",
      "not": {
        "pattern": "(?i)(<secret>|authorization|bearer)"
      }
    },
    "safe_string": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "(?i)(<secret>|credential_value|authorization:|bearer\\s+|api[_-]?secret|service[_-]?key=)"
      }
    },
    "safe_string_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/safe_string"
      },
      "uniqueItems": true
    },
    "env_name_list": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "uniqueItems": true
    },
    "base_item": {
      "type": "object",
      "required": ["source_id", "status", "review_action", "next_action"],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/source_id"
        },
        "status": {
          "enum": ["succeeded", "skipped_not_ready", "failed"]
        },
        "review_action": {
          "$ref": "#/$defs/safe_string"
        },
        "next_action": {
          "$ref": "#/$defs/safe_string"
        }
      }
    },
    "succeeded_item": {
      "allOf": [
        {
          "$ref": "#/$defs/base_item"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_id",
            "status",
            "review_action",
            "staged_receipt_path",
            "reviewed_receipt_path",
            "staged_receipt_validation_command",
            "reviewed_receipt_promotion_command",
            "required_reviewer_inputs",
            "promotion_gate",
            "next_action"
          ],
          "properties": {
            "source_id": {
              "$ref": "#/$defs/source_id"
            },
            "status": {
              "const": "succeeded"
            },
            "review_action": {
              "const": "validate_staged_receipt_then_promote_or_reject"
            },
            "staged_receipt_path": {
              "$ref": "#/$defs/path"
            },
            "reviewed_receipt_path": {
              "$ref": "#/$defs/path"
            },
            "staged_receipt_validation_command": {
              "$ref": "#/$defs/safe_string"
            },
            "reviewed_receipt_promotion_command": {
              "$ref": "#/$defs/safe_string"
            },
            "required_reviewer_inputs": {
              "$ref": "#/$defs/safe_string_list"
            },
            "promotion_gate": {
              "$ref": "#/$defs/safe_string"
            },
            "next_action": {
              "const": "review_staged_receipt_before_promotion"
            }
          }
        }
      ]
    },
    "skipped_item": {
      "allOf": [
        {
          "$ref": "#/$defs/base_item"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_id",
            "status",
            "review_action",
            "readiness_blockers",
            "missing_credential_envs",
            "candidate_batch",
            "reviewed_receipt_path",
            "next_action"
          ],
          "properties": {
            "source_id": {
              "$ref": "#/$defs/source_id"
            },
            "status": {
              "const": "skipped_not_ready"
            },
            "review_action": {
              "const": "resolve_readiness_then_rerun_collection"
            },
            "readiness_blockers": {
              "$ref": "#/$defs/safe_string_list"
            },
            "missing_credential_envs": {
              "$ref": "#/$defs/env_name_list"
            },
            "candidate_batch": {
              "$ref": "#/$defs/path"
            },
            "reviewed_receipt_path": {
              "$ref": "#/$defs/path"
            },
            "next_action": {
              "const": "resolve_readiness_then_rerun_batch"
            }
          }
        }
      ]
    },
    "failed_item": {
      "allOf": [
        {
          "$ref": "#/$defs/base_item"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_id",
            "status",
            "review_action",
            "error",
            "next_action"
          ],
          "properties": {
            "source_id": {
              "$ref": "#/$defs/source_id"
            },
            "status": {
              "const": "failed"
            },
            "review_action": {
              "const": "inspect_collection_error_then_rerun_or_keep_manual_review_boundary"
            },
            "error": {
              "$ref": "#/$defs/safe_string"
            },
            "next_action": {
              "const": "inspect_source_error_then_rerun_or_keep_manual_review_boundary"
            }
          }
        }
      ]
    }
  }
}
