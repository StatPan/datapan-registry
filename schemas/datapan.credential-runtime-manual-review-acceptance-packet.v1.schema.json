{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.datapan.dev/datapan.credential-runtime-manual-review-acceptance-packet.v1.schema.json",
  "title": "Datapan Credential Runtime Manual-Review Acceptance Packet v1",
  "description": "Secret-free operator packet for asserting a digest-bound manual-review release acceptance decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "goal_issue",
    "acceptance_packet_ticket",
    "decision_ticket",
    "acceptance_ticket",
    "provider",
    "inputs",
    "summary",
    "current_digests",
    "required_human_inputs",
    "accepted_decision_template",
    "revalidation_triggers",
    "operator_commands",
    "release_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "datapan.credential-runtime-manual-review-acceptance-packet.v1"
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "goal_issue": {
      "const": 344
    },
    "acceptance_packet_ticket": {
      "const": 407
    },
    "decision_ticket": {
      "const": 391
    },
    "acceptance_ticket": {
      "const": 389
    },
    "provider": {
      "const": "datapan-registry"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credential_runtime_manual_review_decision",
        "credential_runtime_manual_review_acceptance",
        "credential_runtime_review_handoff",
        "release_consumer_compatibility"
      ],
      "properties": {
        "credential_runtime_manual_review_decision": {
          "const": "reports/credential-runtime-manual-review-decision.json"
        },
        "credential_runtime_manual_review_acceptance": {
          "const": "reports/credential-runtime-manual-review-acceptance.json"
        },
        "credential_runtime_review_handoff": {
          "const": "reports/credential-runtime-review-handoff.json"
        },
        "release_consumer_compatibility": {
          "const": "reports/release-consumer-compatibility.json"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted",
        "decision_status",
        "acceptance_status",
        "manual_review_required",
        "pending_review_sources",
        "reviewed_receipts_checked_in",
        "relief_eligible_sources",
        "manual_review_accepted",
        "goal_closure_allowed",
        "default_ci_requires_credentials",
        "checked_in_secrets_allowed",
        "packet_status"
      ],
      "properties": {
        "accepted": {
          "type": "boolean"
        },
        "decision_status": {
          "enum": ["not_asserted", "accepted"]
        },
        "acceptance_status": {
          "enum": ["not_accepted", "accepted"]
        },
        "manual_review_required": {
          "type": "boolean"
        },
        "pending_review_sources": {
          "type": "integer",
          "minimum": 0
        },
        "reviewed_receipts_checked_in": {
          "type": "integer",
          "minimum": 0
        },
        "relief_eligible_sources": {
          "type": "integer",
          "minimum": 0
        },
        "manual_review_accepted": {
          "type": "boolean"
        },
        "goal_closure_allowed": {
          "type": "boolean"
        },
        "default_ci_requires_credentials": {
          "const": false
        },
        "checked_in_secrets_allowed": {
          "const": false
        },
        "packet_status": {
          "enum": ["acceptance_not_asserted", "accepted_decision_ready_for_regeneration"]
        }
      }
    },
    "current_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handoff_path", "handoff_sha256", "compatibility_path", "compatibility_sha256"],
      "properties": {
        "handoff_path": {
          "const": "reports/credential-runtime-review-handoff.json"
        },
        "handoff_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "compatibility_path": {
          "const": "reports/release-consumer-compatibility.json"
        },
        "compatibility_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "required_human_inputs": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "required", "description"],
        "properties": {
          "field": {
            "enum": ["reviewer", "reviewed_at", "reason", "expires_at"]
          },
          "required": {
            "const": true
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "accepted_decision_template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted",
        "decision_status",
        "reviewer",
        "reviewed_at",
        "reason",
        "handoff_sha256",
        "compatibility_sha256",
        "expires_at",
        "revalidation_triggers"
      ],
      "properties": {
        "accepted": {
          "const": true
        },
        "decision_status": {
          "const": "accepted"
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_at": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "handoff_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "compatibility_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "expires_at": {
          "type": "string",
          "minLength": 1
        },
        "revalidation_triggers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "revalidation_triggers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "operator_commands": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validate_current_decision",
        "generate_acceptance_boundary",
        "post_decision_regeneration"
      ],
      "properties": {
        "validate_current_decision": {
          "const": "python3 scripts/validate-credential-runtime-manual-review-decision.py"
        },
        "generate_acceptance_boundary": {
          "const": "python3 scripts/generate-credential-runtime-manual-review-acceptance.py"
        },
        "post_decision_regeneration": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "release_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_registry_compatible",
        "manual_review_required",
        "manual_review_release_boundary_accepted",
        "goal_closure_allowed",
        "goal_closure_effect"
      ],
      "properties": {
        "canonical_registry_compatible": {
          "const": true
        },
        "manual_review_required": {
          "type": "boolean"
        },
        "manual_review_release_boundary_accepted": {
          "type": "boolean"
        },
        "goal_closure_allowed": {
          "type": "boolean"
        },
        "goal_closure_effect": {
          "enum": [
            "goal_remains_open_until_reviewed_receipts_or_explicit_acceptance",
            "manual_review_acceptance_can_feed_goal_preflight"
          ]
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
