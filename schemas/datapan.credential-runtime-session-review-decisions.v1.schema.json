{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.datapan.dev/datapan.credential-runtime-session-review-decisions.v1.schema.json",
  "title": "Datapan Credential Runtime Session Review Decisions v1",
  "description": "Secret-free local reviewer decisions used to batch-promote credential runtime session review-plan items.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_from",
    "summary",
    "checked_in_boundaries",
    "reviewer",
    "decisions"
  ],
  "properties": {
    "schema_version": {
      "const": "datapan.credential-runtime-session-review-decisions.v1"
    },
    "generated_from": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_plan", "session", "queue"],
      "properties": {
        "review_plan": {
          "$ref": "#/$defs/path"
        },
        "session": {
          "$ref": "#/$defs/path"
        },
        "queue": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "decisions",
        "ready_to_promote",
        "default_ci_requires_credentials",
        "checked_in_decisions_allowed",
        "checked_in_secrets_allowed",
        "goal_closure_allowed"
      ],
      "properties": {
        "sources": {
          "$ref": "#/$defs/count"
        },
        "decisions": {
          "$ref": "#/$defs/count"
        },
        "ready_to_promote": {
          "type": "boolean"
        },
        "default_ci_requires_credentials": {
          "const": false
        },
        "checked_in_decisions_allowed": {
          "const": false
        },
        "checked_in_secrets_allowed": {
          "const": false
        },
        "goal_closure_allowed": {
          "const": false
        }
      }
    },
    "checked_in_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checked_in_session_output_allowed",
        "checked_in_review_plan_allowed",
        "checked_in_decisions_allowed",
        "checked_in_secrets_allowed",
        "goal_completion_effect"
      ],
      "properties": {
        "checked_in_session_output_allowed": {
          "const": false
        },
        "checked_in_review_plan_allowed": {
          "const": false
        },
        "checked_in_decisions_allowed": {
          "const": false
        },
        "checked_in_secrets_allowed": {
          "const": false
        },
        "goal_completion_effect": {
          "const": "progress_evidence_only_goal_remains_open_until_reviewed_receipts_refresh_release_evidence"
        }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "reviewed_at"],
      "properties": {
        "reviewer": {
          "oneOf": [
            {
              "$ref": "#/$defs/safe_string"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewed_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    }
  },
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\\\]+$",
      "not": {
        "pattern": "(?i)(<secret>|authorization|bearer)"
      }
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9_]+$"
    },
    "safe_string": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "(?i)(<secret>|credential_value|authorization:|bearer\\s+|api[_-]?secret|service[_-]?key=|token=)"
      }
    },
    "review_state": {
      "enum": ["pending_review", "reviewed_accepted", "reviewed_rejected"]
    },
    "review_decision": {
      "enum": ["pending_review", "allows_manual_review_reduction", "keeps_manual_review_boundary"]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "staged_receipt_path",
        "reviewed_receipt_path",
        "state",
        "decision",
        "reason",
        "ready_to_promote"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/source_id"
        },
        "staged_receipt_path": {
          "$ref": "#/$defs/path"
        },
        "reviewed_receipt_path": {
          "$ref": "#/$defs/path"
        },
        "state": {
          "$ref": "#/$defs/review_state"
        },
        "decision": {
          "$ref": "#/$defs/review_decision"
        },
        "reason": {
          "$ref": "#/$defs/safe_string"
        },
        "ready_to_promote": {
          "type": "boolean"
        }
      }
    }
  }
}
