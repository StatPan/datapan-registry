{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.datapan.dev/datapan.runtime-freshness-run-receipt.v1.schema.json",
  "title": "Datapan runtime freshness run receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "run_id", "summary", "combined_verification", "shards", "redaction"],
  "properties": {
    "schema_version": {"const": "datapan.runtime-freshness-run-receipt.v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "run_id": {"type": "string", "minLength": 1},
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["expected_shards", "shards", "planned_operations", "reported_results", "verified", "failed", "skipped", "unknown"],
      "properties": {
        "expected_shards": {"type": "integer", "minimum": 1},
        "shards": {"type": "integer", "minimum": 1},
        "planned_operations": {"type": "integer", "minimum": 1},
        "reported_results": {"type": "integer", "minimum": 0},
        "verified": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0},
        "unknown": {"type": "integer", "minimum": 0}
      }
    },
    "combined_verification": {"$ref": "#/$defs/file"},
    "shards": {
      "type": "array", "minItems": 1, "items": {
        "type": "object", "additionalProperties": false,
        "required": ["shard_index", "operation_count", "exit_code", "batch_plan", "verification"],
        "properties": {
          "shard_index": {"type": "integer", "minimum": 0},
          "operation_count": {"type": "integer", "minimum": 1},
          "exit_code": {"type": "integer", "minimum": 0},
          "batch_plan": {"$ref": "#/$defs/file"},
          "verification": {"$ref": "#/$defs/file"}
        }
      }
    },
    "redaction": {
      "type": "object", "additionalProperties": false,
      "required": ["secret_values_present", "secret_hashes_present", "request_urls_present", "response_bodies_present"],
      "properties": {
        "secret_values_present": {"const": false},
        "secret_hashes_present": {"const": false},
        "request_urls_present": {"const": false},
        "response_bodies_present": {"const": false}
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
