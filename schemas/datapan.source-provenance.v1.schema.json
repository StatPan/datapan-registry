{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.datapan.dev/datapan.source-provenance.v1.schema.json",
  "title": "Datapan source provenance v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "authority", "pack_contract", "source", "inputs", "rights", "freshness", "consumer_pin"],
  "properties": {
    "schema_version": {"const": "datapan.source-provenance.v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "authority": {"const": "datapan-registry"},
    "pack_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"const": "korea.regional_baseline.v0"},
        "version": {"const": "regional-baseline-v0.1"}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "provider", "source_profile", "endpoint_family"],
      "properties": {
        "source_id": {"const": "kosis"},
        "provider": {"const": "KOSIS"},
        "source_profile": {"$ref": "#/$defs/artifact_reference"},
        "endpoint_family": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "url", "method", "authentication"],
          "properties": {
            "id": {"const": "kosis_e_region_index"},
            "url": {"const": "https://kosis.kr/visual/eRegionIndex/selectAllRegionDataList.do"},
            "method": {"const": "POST"},
            "authentication": {"const": "none"}
          }
        }
      }
    },
    "inputs": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["metric_id", "indicator_id", "table_id", "table_title", "publisher"],
        "properties": {
          "metric_id": {"type": "string", "minLength": 1},
          "indicator_id": {"pattern": "^[0-9]+$"},
          "table_id": {"pattern": "^DT_[A-Z0-9_]+$"},
          "table_title": {"type": "string", "minLength": 1},
          "publisher": {"type": "string", "minLength": 1}
        }
      }
    },
    "rights": {
      "type": "object", "additionalProperties": false,
      "required": ["assessment", "reviewed_at", "usage_guide_url", "terms_url", "attribution_required", "scope", "usage_surface", "credential_scope", "prohibited_uses", "exclusions", "revalidation_triggers"],
      "properties": {
        "assessment": {"const": "conditional_domestic_statistics_reuse"},
        "reviewed_at": {"type": "string", "format": "date"},
        "usage_guide_url": {"const": "https://kosis.kr/nsistN/kosisUseGuide.do"},
        "terms_url": {"const": "https://kosis.kr/openapi/introduce/introduce_02List.do"},
        "attribution_required": {"const": true},
        "scope": {"const": "configured_domestic_statistics_only"},
        "usage_surface": {"const": "kosis_web_parsing_domestic_statistics"},
        "credential_scope": {"const": "no_openapi_credential_or_entitlement_asserted"},
        "prohibited_uses": {
          "type": "array", "minItems": 1, "maxItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["code", "description"],
            "properties": {
              "code": {"const": "unchanged_raw_paid_redistribution"},
              "description": {"type": "string", "minLength": 1}
            }
          }
        },
        "exclusions": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
        "revalidation_triggers": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "freshness": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "reason", "source_cadence", "pack_currentness_authority"],
      "properties": {
        "mode": {"const": "not_asserted"},
        "reason": {"type": "string", "minLength": 1},
        "source_cadence": {"const": "source-dependent"},
        "pack_currentness_authority": {"const": "datapan-data"}
      }
    },
    "consumer_pin": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_path", "required_release_fields"],
      "properties": {
        "artifact_path": {"const": "reports/regional-baseline-source-provenance.json"},
        "required_release_fields": {
          "const": ["registry_tag", "registry_manifest_sha256", "provenance_artifact_sha256"]
        }
      }
    }
  },
  "$defs": {
    "artifact_reference": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"const": "sources/kosis.json"},
        "sha256": {"pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
