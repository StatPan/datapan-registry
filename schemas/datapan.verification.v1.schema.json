{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.datapan.dev/datapan.verification.v1.schema.json",
  "title": "Datapan Verification Report v1",
  "description": "Runtime evidence for public-data API operations.",
  "type": "object",
  "additionalProperties": false,
  "required": ["generated_at", "provider", "limit", "truncated", "filtered_count", "summary", "results"],
  "properties": {
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "registry": {
      "type": "string"
    },
    "ref": {
      "type": "string"
    },
    "operation": {
      "type": "string"
    },
    "limit": {
      "type": "integer",
      "minimum": 0
    },
    "timeout": {
      "type": "string",
      "minLength": 1
    },
    "exclude_input": {
      "type": "string",
      "minLength": 1
    },
    "truncated": {
      "type": "boolean"
    },
    "filters": {
      "$ref": "#/$defs/filters"
    },
    "filtered_count": {
      "type": "integer",
      "minimum": 0
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/result"
      }
    }
  },
  "$defs": {
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": ["verified", "failed", "skipped", "unknown"]
        },
        "provider": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "data_go_kr_gateway",
            "external_endpoint",
            "service_root",
            "no_endpoint",
            "malformed_endpoint",
            "soap",
            "wms"
          ]
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "verified", "failed", "skipped", "unknown"],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "verified": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "unknown": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "title",
        "operation",
        "provider",
        "dependency_class",
        "status"
      ],
      "properties": {
        "identity_key": {
          "type": "string",
          "minLength": 1
        },
        "contract_binding": {
          "$ref": "#/$defs/contract_binding"
        },
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "endpoint_host": {
          "type": "string"
        },
        "dependency_class": {
          "enum": [
            "data_go_kr_gateway",
            "external_endpoint",
            "service_root",
            "no_endpoint",
            "malformed_endpoint",
            "soap",
            "wms"
          ]
        },
        "status": {
          "enum": ["verified", "failed", "skipped", "unknown"]
        },
        "reason": {
          "type": "string"
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "http_status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "semantic_status": {
          "type": "string"
        },
        "provider_status": {
          "$ref": "#/$defs/provider_status"
        },
        "url": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "missing_params": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "body_shape": {
          "type": "string"
        }
      }
    },
    "contract_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "identity_key", "source_id", "dataset_id", "upstream_api_id", "operation_key",
        "source_identity_sha256", "method_action_sha256", "parameter_contract_sha256", "contract_sha256",
        "source_snapshot_sha256", "operation_manifest_sha256", "run_id", "plan_sha256"
      ],
      "properties": {
        "schema_version": {"const": "datapan.runtime-evidence-contract-binding.v1"},
        "identity_key": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "dataset_id": {"type": "string", "minLength": 1},
        "upstream_api_id": {"type": "string", "minLength": 1},
        "operation_key": {"type": "string", "minLength": 1},
        "source_identity_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "method_action_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "parameter_contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "operation_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "run_id": {"type": "string", "minLength": 1},
        "plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "provider_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "source"],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "source": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "reason_code": {
          "type": "string"
        },
        "auth_message": {
          "type": "string"
        },
        "error_message": {
          "type": "string"
        }
      }
    }
  }
}
