{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.datapan.dev/datapan.credential-runtime-manual-review-acceptance.v1.schema.json",
  "title": "Datapan Credential Runtime Manual-Review Acceptance v1",
  "description": "Release evidence boundary that records whether credential-gated runtime manual-review release acceptance has been explicitly asserted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "goal_issue",
    "acceptance_ticket",
    "decision_ticket",
    "handoff_ticket",
    "consumer_compatibility_ticket",
    "provider",
    "inputs",
    "summary",
    "review_scope",
    "release_boundary",
    "acceptance_routing",
    "required_acceptance_evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "datapan.credential-runtime-manual-review-acceptance.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "goal_issue": {
      "const": 344
    },
    "acceptance_ticket": {
      "const": 389
    },
    "decision_ticket": {
      "const": 391
    },
    "handoff_ticket": {
      "const": 385
    },
    "consumer_compatibility_ticket": {
      "const": 387
    },
    "provider": {
      "const": "datapan-registry"
    },
    "inputs": {
      "$ref": "#/$defs/inputs"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "review_scope": {
      "$ref": "#/$defs/review_scope"
    },
    "release_boundary": {
      "$ref": "#/$defs/release_boundary"
    },
    "acceptance_routing": {
      "$ref": "#/$defs/acceptance_routing"
    },
    "required_acceptance_evidence": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "#/$defs/required_evidence"
      }
    }
  },
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credential_runtime_review_handoff",
        "release_consumer_compatibility",
        "credential_runtime_manual_review_decision"
      ],
      "properties": {
        "credential_runtime_review_handoff": {
          "const": "reports/credential-runtime-review-handoff.json"
        },
        "release_consumer_compatibility": {
          "const": "reports/release-consumer-compatibility.json"
        },
        "credential_runtime_manual_review_decision": {
          "const": "reports/credential-runtime-manual-review-decision.json"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted",
        "acceptance_status",
        "acceptance_decision",
        "decision_status",
        "decision_reason",
        "credential_handoff_status",
        "pending_review_sources",
        "reviewed_receipts_checked_in",
        "relief_eligible_sources",
        "global_manual_review_relief_allowed",
        "compatibility_manual_review_required",
        "compatibility_effect",
        "default_ci_requires_credentials",
        "checked_in_secrets_allowed"
      ],
      "properties": {
        "accepted": {
          "type": "boolean"
        },
        "acceptance_status": {
          "enum": [
            "not_accepted",
            "accepted",
            "revalidation_required",
            "unproven"
          ]
        },
        "acceptance_decision": {
          "enum": [
            "blocked_until_explicit_manual_review_acceptance",
            "accepted_manual_review_release_boundary"
          ]
        },
        "decision_status": {
          "enum": [
            "not_asserted",
            "accepted"
          ]
        },
        "decision_reason": {
          "$ref": "#/$defs/non_empty_string"
        },
        "credential_handoff_status": {
          "enum": [
            "review_required",
            "relief_ready"
          ]
        },
        "pending_review_sources": {
          "$ref": "#/$defs/count"
        },
        "reviewed_receipts_checked_in": {
          "$ref": "#/$defs/count"
        },
        "relief_eligible_sources": {
          "$ref": "#/$defs/count"
        },
        "global_manual_review_relief_allowed": {
          "type": "boolean"
        },
        "compatibility_manual_review_required": {
          "type": "boolean"
        },
        "compatibility_effect": {
          "enum": [
            "manual_review_required_until_runtime_blockers_resolved",
            "runtime_evidence_clear"
          ]
        },
        "default_ci_requires_credentials": {
          "const": false
        },
        "checked_in_secrets_allowed": {
          "const": false
        }
      }
    },
    "review_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_version",
        "historical_decision_valid",
        "historical_decision",
        "scope_status",
        "effective_accepted",
        "reason_codes",
        "decision_expires_at",
        "decision_expired",
        "reviewed_binding",
        "current_binding"
      ],
      "properties": {
        "scope_version": {
          "const": "datapan.manual-review-scope.v1"
        },
        "historical_decision_valid": {
          "const": true
        },
        "historical_decision": {
          "type": "boolean"
        },
        "scope_status": {
          "enum": [
            "unchanged",
            "explicitly_revalidated",
            "revalidation_required",
            "unproven"
          ]
        },
        "effective_accepted": {
          "type": "boolean"
        },
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "decision_expires_at": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/review_scope/$defs/utc_timestamp"
            }
          ]
        },
        "decision_expired": {
          "type": "boolean"
        },
        "reviewed_binding": {
          "$ref": "#/$defs/review_scope/$defs/reviewed_binding"
        },
        "current_binding": {
          "$ref": "#/$defs/review_scope/$defs/current_binding"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scope_status": {
                "const": "unchanged"
              }
            }
          },
          "then": {
            "properties": {
              "historical_decision": {
                "const": true
              },
              "effective_accepted": {
                "const": true
              },
              "decision_expired": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "scope_status": {
                "const": "explicitly_revalidated"
              }
            }
          },
          "then": {
            "properties": {
              "historical_decision": {
                "const": false
              },
              "effective_accepted": {
                "const": true
              },
              "decision_expired": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "scope_status": {
                "enum": [
                  "revalidation_required",
                  "unproven"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "effective_accepted": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "decision_expired": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "scope_status": {
                "const": "revalidation_required"
              },
              "effective_accepted": {
                "const": false
              }
            }
          }
        }
      ],
      "$defs": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "git_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "utc_timestamp": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "source_registry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "bytes",
            "sha256"
          ],
          "properties": {
            "path": {
              "const": "data/data-go-kr.registry.json"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "sha256": {
              "$ref": "#/$defs/review_scope/$defs/sha256"
            }
          }
        },
        "scope_document": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope_version",
            "source_registry",
            "compatibility_sha256",
            "handoff_sha256",
            "health_plan_sha256",
            "health_selection_sha256"
          ],
          "properties": {
            "scope_version": {
              "const": "datapan.manual-review-scope.v1"
            },
            "source_registry": {
              "$ref": "#/$defs/review_scope/$defs/source_registry"
            },
            "compatibility_sha256": {
              "$ref": "#/$defs/review_scope/$defs/sha256"
            },
            "handoff_sha256": {
              "$ref": "#/$defs/review_scope/$defs/sha256"
            },
            "health_plan_sha256": {
              "$ref": "#/$defs/review_scope/$defs/sha256"
            },
            "health_selection_sha256": {
              "$ref": "#/$defs/review_scope/$defs/sha256"
            }
          }
        },
        "reviewed_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decision_sha256",
            "compatibility_sha256",
            "handoff_sha256",
            "source_registry",
            "health_plan_sha256",
            "health_selection_sha256",
            "review_scope_version",
            "review_scope_sha256",
            "review_scope",
            "historical_decision_compatibility_sha256",
            "historical_reviewed_at",
            "historical_expires_at",
            "reviewed_commit",
            "health_selection_commit"
          ],
          "properties": {
            "decision_sha256": {
              "$ref": "#/$defs/review_scope/$defs/sha256"
            },
            "compatibility_sha256": {
              "$ref": "#/$defs/review_scope/$defs/sha256"
            },
            "handoff_sha256": {
              "$ref": "#/$defs/review_scope/$defs/sha256"
            },
            "source_registry": {
              "$ref": "#/$defs/review_scope/$defs/source_registry"
            },
            "health_plan_sha256": {
              "$ref": "#/$defs/review_scope/$defs/sha256"
            },
            "health_selection_sha256": {
              "$ref": "#/$defs/review_scope/$defs/sha256"
            },
            "review_scope_version": {
              "const": "datapan.manual-review-scope.v1"
            },
            "review_scope_sha256": {
              "$ref": "#/$defs/review_scope/$defs/sha256"
            },
            "review_scope": {
              "$ref": "#/$defs/review_scope/$defs/scope_document"
            },
            "historical_decision_compatibility_sha256": {
              "$ref": "#/$defs/review_scope/$defs/sha256"
            },
            "historical_reviewed_at": {
              "$ref": "#/$defs/review_scope/$defs/utc_timestamp"
            },
            "historical_expires_at": {
              "$ref": "#/$defs/review_scope/$defs/utc_timestamp"
            },
            "reviewed_commit": {
              "$ref": "#/$defs/review_scope/$defs/git_commit"
            },
            "health_selection_commit": {
              "$ref": "#/$defs/review_scope/$defs/git_commit"
            }
          }
        },
        "current_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "compatibility_sha256",
            "source_registry",
            "handoff_sha256",
            "health_plan_sha256",
            "health_selection_sha256",
            "decision_sha256",
            "compatibility_binding_sha256",
            "compatibility_review_binding_sha256",
            "handoff_file_sha256",
            "review_scope_version",
            "review_scope_sha256",
            "review_scope"
          ],
          "properties": {
            "compatibility_sha256": {
              "$ref": "#/$defs/review_scope/$defs/sha256"
            },
            "source_registry": {
              "$ref": "#/$defs/review_scope/$defs/source_registry"
            },
            "handoff_sha256": {
              "$ref": "#/$defs/review_scope/$defs/sha256"
            },
            "health_plan_sha256": {
              "$ref": "#/$defs/review_scope/$defs/sha256"
            },
            "health_selection_sha256": {
              "$ref": "#/$defs/review_scope/$defs/sha256"
            },
            "decision_sha256": {
              "$ref": "#/$defs/review_scope/$defs/sha256"
            },
            "compatibility_binding_sha256": {
              "$ref": "#/$defs/review_scope/$defs/sha256"
            },
            "compatibility_review_binding_sha256": {
              "$ref": "#/$defs/review_scope/$defs/sha256"
            },
            "handoff_file_sha256": {
              "$ref": "#/$defs/review_scope/$defs/sha256"
            },
            "review_scope_version": {
              "const": "datapan.manual-review-scope.v1"
            },
            "review_scope_sha256": {
              "$ref": "#/$defs/review_scope/$defs/sha256"
            },
            "review_scope": {
              "$ref": "#/$defs/review_scope/$defs/scope_document"
            }
          }
        }
      }
    },
    "release_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_registry_compatible",
        "manual_review_required",
        "manual_review_release_boundary_accepted",
        "live_evidence_claim",
        "consumer_compatibility_effect",
        "goal_completion_effect"
      ],
      "properties": {
        "canonical_registry_compatible": {
          "const": true
        },
        "manual_review_required": {
          "type": "boolean"
        },
        "manual_review_release_boundary_accepted": {
          "type": "boolean"
        },
        "live_evidence_claim": {
          "const": "not_claimed_until_reviewed_receipts_exist"
        },
        "consumer_compatibility_effect": {
          "enum": [
            "manual_review_required_until_runtime_blockers_resolved",
            "runtime_evidence_clear"
          ]
        },
        "goal_completion_effect": {
          "enum": [
            "goal_remains_open_until_reviewed_receipts_or_explicit_acceptance",
            "manual_review_boundary_accepted_for_release"
          ]
        }
      }
    },
    "acceptance_routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_goal_issue",
        "accepted",
        "acceptance_status",
        "manual_review_required",
        "manual_review_release_boundary_accepted",
        "first_safe_action",
        "requires_accountable_reviewer",
        "required_acceptance_evidence_ids",
        "decision_intake_path",
        "decision_validation_command",
        "acceptance_generation_command",
        "acceptance_check_command",
        "acceptance_packet_check_command",
        "post_decision_refresh_commands",
        "consumer_compatibility_effect",
        "goal_completion_effect",
        "goal_closure_allowed",
        "default_ci_requires_credentials",
        "checked_in_secrets_allowed",
        "routing_note"
      ],
      "properties": {
        "parent_goal_issue": {
          "const": 344
        },
        "accepted": {
          "type": "boolean"
        },
        "acceptance_status": {
          "enum": [
            "not_accepted",
            "accepted",
            "revalidation_required",
            "unproven"
          ]
        },
        "manual_review_required": {
          "type": "boolean"
        },
        "manual_review_release_boundary_accepted": {
          "type": "boolean"
        },
        "first_safe_action": {
          "enum": [
            "assert_manual_review_decision_with_required_evidence",
            "revalidate_manual_review_decision_for_current_scope",
            "refresh_release_evidence_after_manual_review_acceptance"
          ]
        },
        "requires_accountable_reviewer": {
          "const": true
        },
        "required_acceptance_evidence_ids": {
          "type": "array",
          "minItems": 5,
          "items": {
            "enum": [
              "reviewer_identity",
              "reviewed_handoff_packet",
              "consumer_compatibility_decision",
              "expiry_or_revalidation_trigger",
              "no_secret_material"
            ]
          }
        },
        "decision_intake_path": {
          "const": "reports/credential-runtime-manual-review-decision.json"
        },
        "decision_validation_command": {
          "const": "python3 scripts/validate-credential-runtime-manual-review-decision.py"
        },
        "acceptance_generation_command": {
          "const": "python3 scripts/generate-credential-runtime-manual-review-acceptance.py"
        },
        "acceptance_check_command": {
          "const": "python3 scripts/generate-credential-runtime-manual-review-acceptance.py --check"
        },
        "acceptance_packet_check_command": {
          "const": "python3 scripts/generate-credential-runtime-manual-review-acceptance-packet.py --check"
        },
        "post_decision_refresh_commands": {
          "type": "array",
          "prefixItems": [
            {
              "const": "python3 scripts/refresh-release-ledger-evidence.py --write --max-iterations 5"
            },
            {
              "const": "python3 scripts/refresh-release-ledger-evidence.py --check"
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "consumer_compatibility_effect": {
          "enum": [
            "manual_review_required_until_runtime_blockers_resolved",
            "runtime_evidence_clear"
          ]
        },
        "goal_completion_effect": {
          "enum": [
            "goal_remains_open_until_reviewed_receipts_or_explicit_acceptance",
            "manual_review_boundary_accepted_for_release"
          ]
        },
        "goal_closure_allowed": {
          "const": false
        },
        "default_ci_requires_credentials": {
          "const": false
        },
        "checked_in_secrets_allowed": {
          "const": false
        },
        "routing_note": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "required_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "required",
        "description"
      ],
      "properties": {
        "id": {
          "enum": [
            "reviewer_identity",
            "reviewed_handoff_packet",
            "consumer_compatibility_decision",
            "expiry_or_revalidation_trigger",
            "no_secret_material"
          ]
        },
        "required": {
          "const": true
        },
        "description": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    }
  }
}
