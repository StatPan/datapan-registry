{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.datapan.dev/datapan.credential-runtime-manual-review-acceptance.v1.schema.json",
  "title": "Datapan Credential Runtime Manual-Review Acceptance v1",
  "description": "Release evidence boundary that records whether credential-gated runtime manual-review release acceptance has been explicitly asserted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "goal_issue",
    "acceptance_ticket",
    "decision_ticket",
    "handoff_ticket",
    "consumer_compatibility_ticket",
    "provider",
    "inputs",
    "summary",
    "release_boundary",
    "required_acceptance_evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "datapan.credential-runtime-manual-review-acceptance.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "goal_issue": {
      "const": 344
    },
    "acceptance_ticket": {
      "const": 389
    },
    "decision_ticket": {
      "const": 391
    },
    "handoff_ticket": {
      "const": 385
    },
    "consumer_compatibility_ticket": {
      "const": 387
    },
    "provider": {
      "const": "datapan-registry"
    },
    "inputs": {
      "$ref": "#/$defs/inputs"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "release_boundary": {
      "$ref": "#/$defs/release_boundary"
    },
    "required_acceptance_evidence": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "#/$defs/required_evidence"
      }
    }
  },
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credential_runtime_review_handoff",
        "release_consumer_compatibility",
        "credential_runtime_manual_review_decision"
      ],
      "properties": {
        "credential_runtime_review_handoff": {
          "const": "reports/credential-runtime-review-handoff.json"
        },
        "release_consumer_compatibility": {
          "const": "reports/release-consumer-compatibility.json"
        },
        "credential_runtime_manual_review_decision": {
          "const": "reports/credential-runtime-manual-review-decision.json"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted",
        "acceptance_status",
        "acceptance_decision",
        "decision_status",
        "decision_reason",
        "credential_handoff_status",
        "pending_review_sources",
        "reviewed_receipts_checked_in",
        "relief_eligible_sources",
        "global_manual_review_relief_allowed",
        "compatibility_manual_review_required",
        "compatibility_effect",
        "default_ci_requires_credentials",
        "checked_in_secrets_allowed"
      ],
      "properties": {
        "accepted": {
          "type": "boolean"
        },
        "acceptance_status": {
          "enum": ["not_accepted", "accepted"]
        },
        "acceptance_decision": {
          "enum": [
            "blocked_until_explicit_manual_review_acceptance",
            "accepted_manual_review_release_boundary"
          ]
        },
        "decision_status": {
          "enum": ["not_asserted", "accepted"]
        },
        "decision_reason": {
          "$ref": "#/$defs/non_empty_string"
        },
        "credential_handoff_status": {
          "enum": ["review_required", "relief_ready"]
        },
        "pending_review_sources": {
          "$ref": "#/$defs/count"
        },
        "reviewed_receipts_checked_in": {
          "$ref": "#/$defs/count"
        },
        "relief_eligible_sources": {
          "$ref": "#/$defs/count"
        },
        "global_manual_review_relief_allowed": {
          "type": "boolean"
        },
        "compatibility_manual_review_required": {
          "type": "boolean"
        },
        "compatibility_effect": {
          "enum": [
            "manual_review_required_until_runtime_blockers_resolved",
            "runtime_evidence_clear"
          ]
        },
        "default_ci_requires_credentials": {
          "const": false
        },
        "checked_in_secrets_allowed": {
          "const": false
        }
      }
    },
    "release_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_registry_compatible",
        "manual_review_required",
        "manual_review_release_boundary_accepted",
        "live_evidence_claim",
        "consumer_compatibility_effect",
        "goal_completion_effect"
      ],
      "properties": {
        "canonical_registry_compatible": {
          "const": true
        },
        "manual_review_required": {
          "type": "boolean"
        },
        "manual_review_release_boundary_accepted": {
          "type": "boolean"
        },
        "live_evidence_claim": {
          "const": "not_claimed_until_reviewed_receipts_exist"
        },
        "consumer_compatibility_effect": {
          "enum": [
            "manual_review_required_until_runtime_blockers_resolved",
            "runtime_evidence_clear"
          ]
        },
        "goal_completion_effect": {
          "enum": [
            "goal_remains_open_until_reviewed_receipts_or_explicit_acceptance",
            "manual_review_boundary_accepted_for_release"
          ]
        }
      }
    },
    "required_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "required", "description"],
      "properties": {
        "id": {
          "enum": [
            "reviewer_identity",
            "reviewed_handoff_packet",
            "consumer_compatibility_decision",
            "expiry_or_revalidation_trigger",
            "no_secret_material"
          ]
        },
        "required": {
          "const": true
        },
        "description": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    }
  }
}
