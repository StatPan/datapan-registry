{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.datapan.dev/datapan.credential-runtime-receipt-collection-queue.v1.schema.json",
  "title": "Datapan Credential Runtime Receipt Collection Queue v1",
  "description": "Operator-facing queue for collecting, reviewing, and promoting credential runtime receipts without requiring credentials in default CI.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "goal_issue",
    "queue_ticket",
    "provider",
    "summary",
    "operator_contract",
    "release_boundary",
    "state_model",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "datapan.credential-runtime-receipt-collection-queue.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "goal_issue": {
      "const": 344
    },
    "queue_ticket": {
      "const": 375
    },
    "provider": {
      "const": "datapan-registry"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "operator_contract": {
      "$ref": "#/$defs/operator_contract"
    },
    "release_boundary": {
      "$ref": "#/$defs/release_boundary"
    },
    "state_model": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "#/$defs/state_definition"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "receipt_state": {
      "enum": [
        "absent",
        "staged_only",
        "reviewed_rejected",
        "reviewed_accepted",
        "relief_eligible"
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "credential_gated_sources",
        "absent",
        "staged_only",
        "reviewed_rejected",
        "reviewed_accepted",
        "relief_eligible",
        "reviewed_receipts_checked_in",
        "manual_review_reduction_allowed",
        "default_ci_requires_credentials",
        "checked_in_secrets_allowed",
        "queue_status"
      ],
      "properties": {
        "sources": {
          "$ref": "#/$defs/count"
        },
        "credential_gated_sources": {
          "$ref": "#/$defs/count"
        },
        "absent": {
          "$ref": "#/$defs/count"
        },
        "staged_only": {
          "$ref": "#/$defs/count"
        },
        "reviewed_rejected": {
          "$ref": "#/$defs/count"
        },
        "reviewed_accepted": {
          "$ref": "#/$defs/count"
        },
        "relief_eligible": {
          "$ref": "#/$defs/count"
        },
        "reviewed_receipts_checked_in": {
          "$ref": "#/$defs/count"
        },
        "manual_review_reduction_allowed": {
          "type": "boolean"
        },
        "default_ci_requires_credentials": {
          "const": false
        },
        "checked_in_secrets_allowed": {
          "const": false
        },
        "queue_status": {
          "enum": ["collection_required", "complete_relief_eligible"]
        }
      }
    },
    "operator_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "queue_check_command",
        "policy_check_command",
        "receipt_validation_command",
        "receipt_promotion_command_template",
        "receipt_promotion_script",
        "collection_runner_script",
        "collection_preflight_command_template",
        "collection_run_command_template",
        "staged_receipt_validation_command",
        "staged_receipt_glob",
        "reviewed_receipt_glob",
        "review_required_for_checked_in_receipts",
        "default_ci_mode"
      ],
      "properties": {
        "policy": {
          "const": "reports/credential-runtime-evidence-policy.json"
        },
        "queue_check_command": {
          "const": "python3 scripts/generate-credential-runtime-receipt-collection-queue.py --check"
        },
        "policy_check_command": {
          "const": "python3 scripts/generate-credential-runtime-evidence-policy.py --check"
        },
        "receipt_validation_command": {
          "const": "python3 scripts/validate-credential-runtime-receipts.py"
        },
        "receipt_promotion_command_template": {
          "$ref": "#/$defs/non_empty_string"
        },
        "receipt_promotion_script": {
          "const": "scripts/promote-credential-runtime-receipt.py"
        },
        "collection_runner_script": {
          "const": "scripts/run-credential-runtime-collection.py"
        },
        "collection_preflight_command_template": {
          "$ref": "#/$defs/non_empty_string"
        },
        "collection_run_command_template": {
          "$ref": "#/$defs/non_empty_string"
        },
        "staged_receipt_validation_command": {
          "$ref": "#/$defs/non_empty_string"
        },
        "staged_receipt_glob": {
          "const": ".datapan/runtime-evidence/*-credentialed-receipt.json"
        },
        "reviewed_receipt_glob": {
          "const": "reports/credential-runtime-receipts/*-credentialed-receipt.json"
        },
        "review_required_for_checked_in_receipts": {
          "const": true
        },
        "default_ci_mode": {
          "const": "secret_free_queue_validation"
        }
      }
    },
    "release_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_registry_compatible",
        "manual_review_required",
        "receipt_backed_relief_status",
        "compatibility_effect",
        "live_evidence_claim"
      ],
      "properties": {
        "canonical_registry_compatible": {
          "const": true
        },
        "manual_review_required": {
          "type": "boolean"
        },
        "receipt_backed_relief_status": {
          "enum": [
            "blocked_until_validated_credential_runtime_receipts_exist",
            "blocked_until_reviewed_validated_credential_runtime_receipts_exist",
            "allowed_by_reviewed_validated_credential_runtime_receipts"
          ]
        },
        "compatibility_effect": {
          "const": "operator_collection_queue_only"
        },
        "live_evidence_claim": {
          "const": "not_claimed_until_reviewed_receipts_exist"
        }
      }
    },
    "state_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "meaning", "relief_eligible"],
      "properties": {
        "state": {
          "$ref": "#/$defs/receipt_state"
        },
        "meaning": {
          "$ref": "#/$defs/non_empty_string"
        },
        "relief_eligible": {
          "type": "boolean"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "provider",
        "candidate_batch",
        "runtime_evidence_plan",
        "staged_receipt_path",
        "reviewed_receipt_path",
        "operator_command",
        "staged_receipt_validation_command",
        "collection_preflight_command",
        "collection_run_command",
        "reviewed_receipt_validation_command",
        "reviewed_receipt_promotion_command",
        "review_required",
        "promotion_gate",
        "current_receipt_state",
        "checked_in_review_state",
        "checked_in_receipt_present",
        "checked_in_receipt_path",
        "receipt_outcome",
        "receipt_relief_eligible",
        "default_ci_requires_credentials",
        "next_action"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "provider": {
          "$ref": "#/$defs/non_empty_string"
        },
        "candidate_batch": {
          "$ref": "#/$defs/non_empty_string"
        },
        "runtime_evidence_plan": {
          "$ref": "#/$defs/non_empty_string"
        },
        "staged_receipt_path": {
          "$ref": "#/$defs/non_empty_string"
        },
        "reviewed_receipt_path": {
          "$ref": "#/$defs/non_empty_string"
        },
        "operator_command": {
          "$ref": "#/$defs/non_empty_string"
        },
        "staged_receipt_validation_command": {
          "$ref": "#/$defs/non_empty_string"
        },
        "collection_preflight_command": {
          "$ref": "#/$defs/non_empty_string"
        },
        "collection_run_command": {
          "$ref": "#/$defs/non_empty_string"
        },
        "reviewed_receipt_validation_command": {
          "const": "python3 scripts/validate-credential-runtime-receipts.py"
        },
        "reviewed_receipt_promotion_command": {
          "$ref": "#/$defs/non_empty_string"
        },
        "review_required": {
          "const": true
        },
        "promotion_gate": {
          "$ref": "#/$defs/non_empty_string"
        },
        "current_receipt_state": {
          "$ref": "#/$defs/receipt_state"
        },
        "checked_in_review_state": {
          "enum": ["none", "reviewed_accepted", "reviewed_rejected"]
        },
        "checked_in_receipt_present": {
          "type": "boolean"
        },
        "checked_in_receipt_path": {
          "$ref": "#/$defs/non_empty_string"
        },
        "receipt_outcome": {
          "$ref": "#/$defs/non_empty_string"
        },
        "receipt_relief_eligible": {
          "type": "boolean"
        },
        "default_ci_requires_credentials": {
          "const": false
        },
        "next_action": {
          "enum": [
            "run_bounded_credentialed_runtime_check_then_review_and_promote_receipt",
            "keep_manual_review_boundary_or_collect_new_redacted_receipt",
            "collect_remaining_reviewed_receipts_before_requesting_global_relief",
            "wait_for_all_credential_gated_sources_to_be_relief_eligible",
            "maintain_receipt_backed_compatibility_relief_evidence"
          ]
        }
      }
    }
  }
}
