{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.datapan.dev/datapan.manual-review-scope.v1.schema.json",
  "title": "Datapan Manual Review Scope Evaluation v1",
  "description": "Deterministic comparison of current manual-review evidence with the pinned historical review and its current expiry.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scope_version",
    "historical_decision_valid",
    "historical_decision",
    "scope_status",
    "effective_accepted",
    "reason_codes",
    "decision_expires_at",
    "decision_expired",
    "reviewed_binding",
    "current_binding"
  ],
  "properties": {
    "scope_version": {
      "const": "datapan.manual-review-scope.v1"
    },
    "historical_decision_valid": {
      "const": true
    },
    "historical_decision": {
      "type": "boolean"
    },
    "scope_status": {
      "enum": ["unchanged", "explicitly_revalidated", "revalidation_required", "unproven"]
    },
    "effective_accepted": {
      "type": "boolean"
    },
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decision_expires_at": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/utc_timestamp"}
      ]
    },
    "decision_expired": {
      "type": "boolean"
    },
    "reviewed_binding": {
      "$ref": "#/$defs/reviewed_binding"
    },
    "current_binding": {
      "$ref": "#/$defs/current_binding"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"scope_status": {"const": "unchanged"}}},
      "then": {
        "properties": {
          "historical_decision": {"const": true},
          "effective_accepted": {"const": true},
          "decision_expired": {"const": false}
        }
      }
    },
    {
      "if": {"properties": {"scope_status": {"const": "explicitly_revalidated"}}},
      "then": {
        "properties": {
          "historical_decision": {"const": false},
          "effective_accepted": {"const": true},
          "decision_expired": {"const": false}
        }
      }
    },
    {
      "if": {"properties": {"scope_status": {"enum": ["revalidation_required", "unproven"]}}},
      "then": {"properties": {"effective_accepted": {"const": false}}}
    },
    {
      "if": {"properties": {"decision_expired": {"const": true}}},
      "then": {
        "properties": {
          "scope_status": {"const": "revalidation_required"},
          "effective_accepted": {"const": false}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "git_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "utc_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|\\+00:00)$"
    },
    "source_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"const": "data/data-go-kr.registry.json"},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "scope_document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_version",
        "source_registry",
        "compatibility_sha256",
        "handoff_sha256",
        "health_plan_sha256",
        "health_selection_sha256"
      ],
      "properties": {
        "scope_version": {"const": "datapan.manual-review-scope.v1"},
        "source_registry": {"$ref": "#/$defs/source_registry"},
        "compatibility_sha256": {"$ref": "#/$defs/sha256"},
        "handoff_sha256": {"$ref": "#/$defs/sha256"},
        "health_plan_sha256": {"$ref": "#/$defs/sha256"},
        "health_selection_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "reviewed_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_sha256",
        "compatibility_sha256",
        "handoff_sha256",
        "source_registry",
        "health_plan_sha256",
        "health_selection_sha256",
        "review_scope_version",
        "review_scope_sha256",
        "review_scope",
        "historical_decision_compatibility_sha256",
        "historical_reviewed_at",
        "historical_expires_at",
        "reviewed_commit",
        "health_selection_commit"
      ],
      "properties": {
        "decision_sha256": {"$ref": "#/$defs/sha256"},
        "compatibility_sha256": {"$ref": "#/$defs/sha256"},
        "handoff_sha256": {"$ref": "#/$defs/sha256"},
        "source_registry": {"$ref": "#/$defs/source_registry"},
        "health_plan_sha256": {"$ref": "#/$defs/sha256"},
        "health_selection_sha256": {"$ref": "#/$defs/sha256"},
        "review_scope_version": {"const": "datapan.manual-review-scope.v1"},
        "review_scope_sha256": {"$ref": "#/$defs/sha256"},
        "review_scope": {"$ref": "#/$defs/scope_document"},
        "historical_decision_compatibility_sha256": {"$ref": "#/$defs/sha256"},
        "historical_reviewed_at": {"$ref": "#/$defs/utc_timestamp"},
        "historical_expires_at": {"$ref": "#/$defs/utc_timestamp"},
        "reviewed_commit": {"$ref": "#/$defs/git_commit"},
        "health_selection_commit": {"$ref": "#/$defs/git_commit"}
      }
    },
    "current_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compatibility_sha256",
        "source_registry",
        "handoff_sha256",
        "health_plan_sha256",
        "health_selection_sha256",
        "decision_sha256",
        "compatibility_binding_sha256",
        "compatibility_review_binding_sha256",
        "handoff_file_sha256",
        "review_scope_version",
        "review_scope_sha256",
        "review_scope"
      ],
      "properties": {
        "compatibility_sha256": {"$ref": "#/$defs/sha256"},
        "source_registry": {"$ref": "#/$defs/source_registry"},
        "handoff_sha256": {"$ref": "#/$defs/sha256"},
        "health_plan_sha256": {"$ref": "#/$defs/sha256"},
        "health_selection_sha256": {"$ref": "#/$defs/sha256"},
        "decision_sha256": {"$ref": "#/$defs/sha256"},
        "compatibility_binding_sha256": {"$ref": "#/$defs/sha256"},
        "compatibility_review_binding_sha256": {"$ref": "#/$defs/sha256"},
        "handoff_file_sha256": {"$ref": "#/$defs/sha256"},
        "review_scope_version": {"const": "datapan.manual-review-scope.v1"},
        "review_scope_sha256": {"$ref": "#/$defs/sha256"},
        "review_scope": {"$ref": "#/$defs/scope_document"}
      }
    }
  }
}
