{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.datapan.dev/datapan.registry-distribution.v1.schema.json",
  "title": "Datapan Registry distribution policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "canonical_registry", "preparation_backend", "distribution_manifest", "shard_archive", "consumer_contract"],
  "properties": {
    "schema_version": {"const": "datapan.registry-distribution.v1"},
    "canonical_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "repository", "revision", "path", "manifest_sha256"],
      "properties": {
        "provider": {"const": "huggingface-dataset"},
        "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "path": {"type": "string", "minLength": 1},
        "manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "preparation_backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "repository", "path", "manifest_binding", "upload", "readback"],
      "properties": {
        "provider": {"const": "github-git-lfs"},
        "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "path": {"type": "string", "minLength": 1},
        "manifest_binding": {"const": "release-manifest-sha256"},
        "upload": {"const": "object-oid-only"},
        "readback": {"const": "isolated-lfs-storage"}
      }
    },
    "distribution_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "path", "publication", "consumer_rule"],
      "properties": {
        "schema_version": {"const": "datapan.huggingface-distribution.v1"},
        "path": {"type": "string", "minLength": 1},
        "publication": {"const": "two_phase_immutable_payload"},
        "consumer_rule": {"const": "resolve_pointer_then_fetch_only_from_payload_revision"}
      }
    },
    "shard_archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "inventory_path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "inventory_path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "consumer_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preferred", "fallback", "identity"],
      "properties": {
        "preferred": {"const": "validated_shards"},
        "fallback": {"const": "canonical_registry"},
        "identity": {"const": "manifest_sha256"}
      }
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
