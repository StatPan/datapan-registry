{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.datapan.dev/datapan.credential-runtime-evidence-policy.v1.schema.json",
  "title": "Datapan Credential Runtime Evidence Policy v1",
  "description": "Secret-free policy contract for running credential-gated source runtime evidence without storing credentials in the registry.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "goal_issue",
    "policy_ticket",
    "provider",
    "summary",
    "secret_handling",
    "operator_contract",
    "release_boundary",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "datapan.credential-runtime-evidence-policy.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "goal_issue": {
      "const": 344
    },
    "policy_ticket": {
      "const": 364
    },
    "provider": {
      "const": "datapan-registry"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "secret_handling": {
      "$ref": "#/$defs/secret_handling"
    },
    "operator_contract": {
      "$ref": "#/$defs/operator_contract"
    },
    "release_boundary": {
      "$ref": "#/$defs/release_boundary"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "credential_gated_sources",
        "metadata_only_sources",
        "non_data_runtime_evidence_gaps",
        "credential_required_blockers",
        "manual_review_boundaries",
        "live_credentialed_receipts_checked_in",
        "default_ci_requires_credentials",
        "checked_in_secrets_allowed"
      ],
      "properties": {
        "sources": {
          "$ref": "#/$defs/count"
        },
        "credential_gated_sources": {
          "$ref": "#/$defs/count"
        },
        "metadata_only_sources": {
          "$ref": "#/$defs/count"
        },
        "non_data_runtime_evidence_gaps": {
          "$ref": "#/$defs/count"
        },
        "credential_required_blockers": {
          "$ref": "#/$defs/count"
        },
        "manual_review_boundaries": {
          "$ref": "#/$defs/count"
        },
        "live_credentialed_receipts_checked_in": {
          "const": 0
        },
        "default_ci_requires_credentials": {
          "const": false
        },
        "checked_in_secrets_allowed": {
          "const": false
        }
      }
    },
    "secret_handling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credential_storage",
        "injection_mode",
        "redaction_policy",
        "receipt_policy",
        "default_ci_mode",
        "credential_gated_mode"
      ],
      "properties": {
        "credential_storage": {
          "const": "external_secret_store_or_operator_environment"
        },
        "injection_mode": {
          "const": "environment_variable"
        },
        "redaction_policy": {
          "const": "never_write_secret_values_or_secret_hashes"
        },
        "receipt_policy": {
          "const": "checked_in_receipts_may_record_presence_outcome_and_error_class_only"
        },
        "default_ci_mode": {
          "const": "secret_free_contract_validation"
        },
        "credential_gated_mode": {
          "const": "operator_opt_in_live_runtime_batch"
        }
      }
    },
    "operator_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_check_command",
        "policy_check_command",
        "receipt_schema",
        "receipt_validator",
        "receipt_validation_command",
        "credential_gated_command_template",
        "required_receipt_fields",
        "forbidden_receipt_fields"
      ],
      "properties": {
        "default_check_command": {
          "const": "python3 scripts/generate-credential-runtime-evidence-policy.py --check"
        },
        "policy_check_command": {
          "const": "python3 scripts/generate-credential-runtime-evidence-policy.py --check"
        },
        "receipt_schema": {
          "const": "schemas/datapan.credential-runtime-receipt.v1.schema.json"
        },
        "receipt_validator": {
          "const": "scripts/validate-credential-runtime-receipts.py"
        },
        "receipt_validation_command": {
          "const": "python3 scripts/validate-credential-runtime-receipts.py"
        },
        "credential_gated_command_template": {
          "$ref": "#/$defs/non_empty_string"
        },
        "required_receipt_fields": {
          "type": "array",
          "minItems": 5,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "uniqueItems": true
        },
        "forbidden_receipt_fields": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "uniqueItems": true
        }
      }
    },
    "release_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_registry_compatible",
        "compatibility_effect",
        "manual_review_required",
        "live_evidence_claim"
      ],
      "properties": {
        "canonical_registry_compatible": {
          "const": true
        },
        "compatibility_effect": {
          "const": "credential_safe_manual_review_boundary"
        },
        "manual_review_required": {
          "const": true
        },
        "live_evidence_claim": {
          "const": "not_claimed_until_credentialed_receipts_exist"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "provider",
        "source_profile",
        "runtime_evidence_plan",
        "candidate_batch",
        "auth_type",
        "credential_required",
        "credential_envs",
        "default_ci_behavior",
        "bounded_live_evidence_path",
        "manual_review_boundaries"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "provider": {
          "$ref": "#/$defs/non_empty_string"
        },
        "source_profile": {
          "$ref": "#/$defs/non_empty_string"
        },
        "runtime_evidence_plan": {
          "$ref": "#/$defs/non_empty_string"
        },
        "candidate_batch": {
          "$ref": "#/$defs/non_empty_string"
        },
        "auth_type": {
          "enum": ["api_key", "service_key", "approval_required", "mixed", "oauth2", "session"]
        },
        "credential_required": {
          "const": true
        },
        "credential_envs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "uniqueItems": true
        },
        "default_ci_behavior": {
          "const": "validate_policy_without_credentials"
        },
        "bounded_live_evidence_path": {
          "$ref": "#/$defs/live_path"
        },
        "manual_review_boundaries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/manual_review_boundary"
          }
        }
      }
    },
    "live_path": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "input_batch",
        "operator_command",
        "receipt_artifact",
        "receipt_schema",
        "receipt_validator",
        "promotion_gate"
      ],
      "properties": {
        "status": {
          "const": "defined_not_collected"
        },
        "input_batch": {
          "$ref": "#/$defs/non_empty_string"
        },
        "operator_command": {
          "$ref": "#/$defs/non_empty_string"
        },
        "receipt_artifact": {
          "$ref": "#/$defs/non_empty_string"
        },
        "receipt_schema": {
          "const": "schemas/datapan.credential-runtime-receipt.v1.schema.json"
        },
        "receipt_validator": {
          "const": "scripts/validate-credential-runtime-receipts.py"
        },
        "promotion_gate": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "manual_review_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "release_boundary"],
      "properties": {
        "id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "status": {
          "const": "manual_review_boundary"
        },
        "release_boundary": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    }
  }
}
