{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.datapan.dev/datapan.release-version-decision.v1.schema.json",
  "title": "Datapan Release Version Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "goal_issue", "versioning_ticket", "policy", "allocation_authority", "self_artifact_excluded", "baseline", "candidate", "decision", "change_required", "publication", "consumer_compatibility"],
  "properties": {
    "schema_version": {"const": "datapan.release-version-decision.v1"},
    "goal_issue": {"const": 604},
    "versioning_ticket": {"const": 598},
    "policy": {"const": "policy/release-versioning.json"},
    "allocation_authority": {"type": "string", "minLength": 1},
    "self_artifact_excluded": {"const": true},
    "baseline": {"$ref": "#/$defs/candidate"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "decision": {"enum": ["no_change_no_bump", "changed_input_version_bumped"]},
    "change_required": {"type": "boolean"},
    "publication": {"type": "object", "additionalProperties": false, "required": ["tagged", "huggingface_published", "external_mutation"], "properties": {"tagged": {"const": false}, "huggingface_published": {"const": false}, "external_mutation": {"const": false}}},
    "consumer_compatibility": {"type": "object", "additionalProperties": false, "required": ["manifest_bound", "package_required_paths", "proof"], "properties": {"manifest_bound": {"const": true}, "package_required_paths": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 1}}, "proof": {"type": "string", "minLength": 1}}}
  },
  "$defs": {
    "candidate": {"type": "object", "additionalProperties": false, "required": ["datapan_version", "input"], "properties": {"datapan_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"}, "input": {"$ref": "#/$defs/input"}}},
    "input": {"type": "object", "additionalProperties": false, "required": ["source_revision", "manifest_digest", "ordered_artifact_inventory_digest", "artifact_count_excluding_decision"], "properties": {"source_revision": {"$ref": "#/$defs/digest"}, "manifest_digest": {"$ref": "#/$defs/digest"}, "ordered_artifact_inventory_digest": {"$ref": "#/$defs/digest"}, "artifact_count_excluding_decision": {"type": "integer", "minimum": 1}}},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
