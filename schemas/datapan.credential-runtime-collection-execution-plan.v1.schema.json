{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.datapan.dev/datapan.credential-runtime-collection-execution-plan.v1.schema.json",
  "title": "Datapan Credential Runtime Collection Execution Plan v1",
  "description": "Secret-free checked-in execution plan that binds the credential receipt queue, runner readiness, and operator packets into one batch collection session plan.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "goal_issue",
    "execution_plan_ticket",
    "provider",
    "inputs",
    "summary",
    "batch_execution",
    "operator_workflow",
    "session_review_promotion_workflow",
    "operator_environment",
    "post_collection_review",
    "sources",
    "source_queue_summary"
  ],
  "properties": {
    "schema_version": {
      "const": "datapan.credential-runtime-collection-execution-plan.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "goal_issue": {
      "const": 344
    },
    "execution_plan_ticket": {
      "const": 443
    },
    "provider": {
      "const": "datapan-registry"
    },
    "inputs": {
      "$ref": "#/$defs/inputs"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "batch_execution": {
      "$ref": "#/$defs/batch_execution"
    },
    "operator_workflow": {
      "$ref": "#/$defs/operator_workflow"
    },
    "session_review_promotion_workflow": {
      "$ref": "#/$defs/session_review_promotion_workflow"
    },
    "operator_environment": {
      "$ref": "#/$defs/operator_environment"
    },
    "post_collection_review": {
      "$ref": "#/$defs/post_collection_review"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "source_queue_summary": {
      "$ref": "#/$defs/source_queue_summary"
    }
  },
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "env_name": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "command": {
      "type": "string",
      "minLength": 1,
      "pattern": "^python3 scripts/"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collection_queue", "runner_readiness", "operator_packets"],
      "properties": {
        "collection_queue": {
          "const": "reports/credential-runtime-receipt-collection-queue.json"
        },
        "runner_readiness": {
          "const": "reports/credential-runtime-runner-readiness.json"
        },
        "operator_packets": {
          "const": "reports/credential-runtime-operator-packets.json"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "credential_gated_sources",
        "operator_sources_ready",
        "candidate_batches_present",
        "candidate_batches_missing",
        "blocked_on_operator_env",
        "reviewed_receipts_present",
        "reviewed_receipts_missing",
        "batch_ready_for_operator_credentials",
        "manual_review_required",
        "manual_review_accepted",
        "manual_review_reduction_allowed",
        "default_ci_requires_credentials",
        "checked_in_secrets_allowed",
        "checked_in_session_output_allowed",
        "goal_closure_allowed",
        "session_plan_status",
        "next_action"
      ],
      "properties": {
        "sources": {
          "$ref": "#/$defs/count"
        },
        "credential_gated_sources": {
          "$ref": "#/$defs/count"
        },
        "operator_sources_ready": {
          "$ref": "#/$defs/count"
        },
        "candidate_batches_present": {
          "$ref": "#/$defs/count"
        },
        "candidate_batches_missing": {
          "$ref": "#/$defs/count"
        },
        "blocked_on_operator_env": {
          "$ref": "#/$defs/count"
        },
        "reviewed_receipts_present": {
          "$ref": "#/$defs/count"
        },
        "reviewed_receipts_missing": {
          "$ref": "#/$defs/count"
        },
        "batch_ready_for_operator_credentials": {
          "type": "boolean"
        },
        "manual_review_required": {
          "type": "boolean"
        },
        "manual_review_accepted": {
          "type": "boolean"
        },
        "manual_review_reduction_allowed": {
          "type": "boolean"
        },
        "default_ci_requires_credentials": {
          "const": false
        },
        "checked_in_secrets_allowed": {
          "const": false
        },
        "checked_in_session_output_allowed": {
          "const": false
        },
        "goal_closure_allowed": {
          "const": false
        },
        "session_plan_status": {
          "enum": [
            "operator_credentials_required",
            "candidate_batches_missing",
            "ready_for_operator_collection",
            "reviewed_receipts_complete"
          ]
        },
        "next_action": {
          "enum": [
            "run_batch_collection_session_in_operator_env",
            "restore_candidate_batches_before_operator_collection",
            "refresh_release_evidence_after_reviewed_receipts"
          ]
        }
      }
    },
    "batch_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secret_free_batch_preflight_command",
        "require_env_batch_preflight_command",
        "batch_collection_run_command",
        "batch_collection_run_with_session_output_command",
        "session_output_schema",
        "session_output_schema_path",
        "session_output_path",
        "session_output_validation_command",
        "session_review_plan_output_path",
        "session_review_plan_command",
        "session_review_plan_validation_command",
        "skip_not_ready_allowed",
        "continue_on_error_allowed",
        "checked_in_session_output_allowed",
        "checked_in_review_plan_allowed",
        "checked_in_secrets_allowed",
        "default_ci_requires_credentials"
      ],
      "properties": {
        "secret_free_batch_preflight_command": {
          "$ref": "#/$defs/command"
        },
        "require_env_batch_preflight_command": {
          "$ref": "#/$defs/command"
        },
        "batch_collection_run_command": {
          "$ref": "#/$defs/command"
        },
        "batch_collection_run_with_session_output_command": {
          "$ref": "#/$defs/command"
        },
        "session_output_schema": {
          "const": "datapan.credential-runtime-collection-session.v1"
        },
        "session_output_schema_path": {
          "const": "schemas/datapan.credential-runtime-collection-session.v1.schema.json"
        },
        "session_output_path": {
          "const": ".datapan/runtime-evidence/credential-runtime-collection-session.json"
        },
        "session_output_validation_command": {
          "$ref": "#/$defs/command"
        },
        "session_review_plan_output_path": {
          "const": ".datapan/runtime-evidence/credential-runtime-session-review-plan.json"
        },
        "session_review_plan_command": {
          "$ref": "#/$defs/command"
        },
        "session_review_plan_validation_command": {
          "$ref": "#/$defs/command"
        },
        "skip_not_ready_allowed": {
          "type": "boolean"
        },
        "continue_on_error_allowed": {
          "type": "boolean"
        },
        "checked_in_session_output_allowed": {
          "const": false
        },
        "checked_in_review_plan_allowed": {
          "const": false
        },
        "checked_in_secrets_allowed": {
          "const": false
        },
        "default_ci_requires_credentials": {
          "const": false
        }
      }
    },
    "operator_workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "script",
        "plan_command",
        "run_command",
        "require_env_command",
        "require_env_json_command",
        "github_actions_dispatch_workflow",
        "github_actions_preflight_command",
        "github_actions_collect_command",
        "github_secret_readiness_command",
        "github_secret_readiness_check_command",
        "github_actions_secret_readiness_schema",
        "github_actions_secret_readiness_artifact",
        "check_command",
        "self_test_command",
        "workflow_status",
        "next_action",
        "session_output_path",
        "session_review_plan_output_path",
        "requires_explicit_run",
        "requires_operator_credentials",
        "github_actions_uses_repository_secrets",
        "github_actions_uploads_local_artifacts",
        "github_actions_collect_skips_setup_without_secrets",
        "default_ci_requires_credentials",
        "checked_in_session_output_allowed",
        "checked_in_review_plan_allowed",
        "checked_in_secrets_allowed",
        "goal_closure_allowed"
      ],
      "properties": {
        "script": {
          "const": "scripts/run-credential-runtime-operator-workflow.py"
        },
        "plan_command": {
          "const": "python3 scripts/run-credential-runtime-operator-workflow.py --json"
        },
        "run_command": {
          "const": "python3 scripts/run-credential-runtime-operator-workflow.py --run --json"
        },
        "require_env_command": {
          "const": "python3 scripts/run-credential-runtime-operator-workflow.py --require-env"
        },
        "require_env_json_command": {
          "const": "python3 scripts/run-credential-runtime-operator-workflow.py --require-env --json"
        },
        "github_actions_dispatch_workflow": {
          "const": ".github/workflows/credential-runtime-collection.yml"
        },
        "github_actions_preflight_command": {
          "const": "gh workflow run credential-runtime-collection.yml --repo StatPan/datapan-registry -f mode=preflight"
        },
        "github_actions_collect_command": {
          "const": "gh workflow run credential-runtime-collection.yml --repo StatPan/datapan-registry -f mode=collect"
        },
        "github_secret_readiness_command": {
          "const": "python3 scripts/check-credential-runtime-github-secrets.py --repo StatPan/datapan-registry --json"
        },
        "github_secret_readiness_check_command": {
          "const": "python3 scripts/check-credential-runtime-github-secrets.py --check"
        },
        "github_actions_secret_readiness_schema": {
          "const": "datapan.credential-runtime-github-secret-readiness.v1"
        },
        "github_actions_secret_readiness_artifact": {
          "const": "credential-runtime-secret-readiness"
        },
        "check_command": {
          "const": "python3 scripts/run-credential-runtime-operator-workflow.py --check"
        },
        "self_test_command": {
          "const": "python3 scripts/run-credential-runtime-operator-workflow.py --self-test"
        },
        "workflow_status": {
          "enum": [
            "operator_credentials_required",
            "candidate_batches_missing",
            "ready_for_operator_collection",
            "reviewed_receipts_complete"
          ]
        },
        "next_action": {
          "enum": [
            "run_batch_collection_session_in_operator_env",
            "restore_candidate_batches_before_operator_collection",
            "refresh_release_evidence_after_reviewed_receipts"
          ]
        },
        "session_output_path": {
          "const": ".datapan/runtime-evidence/credential-runtime-collection-session.json"
        },
        "session_review_plan_output_path": {
          "const": ".datapan/runtime-evidence/credential-runtime-session-review-plan.json"
        },
        "requires_explicit_run": {
          "const": true
        },
        "requires_operator_credentials": {
          "const": true
        },
        "github_actions_uses_repository_secrets": {
          "const": true
        },
        "github_actions_uploads_local_artifacts": {
          "const": true
        },
        "github_actions_collect_skips_setup_without_secrets": {
          "const": true
        },
        "default_ci_requires_credentials": {
          "const": false
        },
        "checked_in_session_output_allowed": {
          "const": false
        },
        "checked_in_review_plan_allowed": {
          "const": false
        },
        "checked_in_secrets_allowed": {
          "const": false
        },
        "goal_closure_allowed": {
          "const": false
        }
      }
    },
    "session_review_promotion_workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "script",
        "decision_template_path",
        "init_decisions_command",
        "check_command",
        "run_command",
        "self_test_command",
        "session_review_plan_output_path",
        "requires_session_review_plan",
        "requires_finalized_reviewer_decisions",
        "requires_explicit_run",
        "default_ci_requires_credentials",
        "checked_in_session_output_allowed",
        "checked_in_review_plan_allowed",
        "checked_in_decisions_allowed",
        "checked_in_secrets_allowed",
        "goal_closure_allowed"
      ],
      "properties": {
        "script": {
          "const": "scripts/promote-credential-runtime-session-review.py"
        },
        "decision_template_path": {
          "const": ".datapan/runtime-evidence/credential-runtime-session-review-decisions.json"
        },
        "init_decisions_command": {
          "const": "python3 scripts/promote-credential-runtime-session-review.py --init-decisions"
        },
        "check_command": {
          "const": "python3 scripts/promote-credential-runtime-session-review.py --check"
        },
        "run_command": {
          "const": "python3 scripts/promote-credential-runtime-session-review.py --run"
        },
        "self_test_command": {
          "const": "python3 scripts/promote-credential-runtime-session-review.py --self-test"
        },
        "session_review_plan_output_path": {
          "const": ".datapan/runtime-evidence/credential-runtime-session-review-plan.json"
        },
        "requires_session_review_plan": {
          "const": true
        },
        "requires_finalized_reviewer_decisions": {
          "const": true
        },
        "requires_explicit_run": {
          "const": true
        },
        "default_ci_requires_credentials": {
          "const": false
        },
        "checked_in_session_output_allowed": {
          "const": false
        },
        "checked_in_review_plan_allowed": {
          "const": false
        },
        "checked_in_decisions_allowed": {
          "const": false
        },
        "checked_in_secrets_allowed": {
          "const": false
        },
        "goal_closure_allowed": {
          "const": false
        }
      }
    },
    "operator_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_credential_envs",
        "required_credential_env_count",
        "required_operator_inputs",
        "environment_mode",
        "checked_in_credentials_allowed"
      ],
      "properties": {
        "required_credential_envs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/env_name"
          },
          "uniqueItems": true
        },
        "required_credential_env_count": {
          "$ref": "#/$defs/count"
        },
        "required_operator_inputs": {
          "type": "array",
          "prefixItems": [
            {
              "const": "credential_env_values"
            },
            {
              "const": "reviewer_identity"
            },
            {
              "const": "review_reason"
            },
            {
              "const": "review_decision"
            }
          ],
          "items": false
        },
        "environment_mode": {
          "const": "operator_credentials_required"
        },
        "checked_in_credentials_allowed": {
          "const": false
        }
      }
    },
    "post_collection_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_validation_command",
        "review_plan_generation_command",
        "review_plan_validation_command",
        "post_promotion_commands",
        "goal_closure_effect"
      ],
      "properties": {
        "session_validation_command": {
          "$ref": "#/$defs/command"
        },
        "review_plan_generation_command": {
          "$ref": "#/$defs/command"
        },
        "review_plan_validation_command": {
          "$ref": "#/$defs/command"
        },
        "post_promotion_commands": {
          "type": "array",
          "prefixItems": [
            {
              "const": "python3 scripts/refresh-release-ledger-evidence.py --write --max-iterations 5"
            },
            {
              "const": "python3 scripts/refresh-release-ledger-evidence.py --check"
            }
          ],
          "items": false
        },
        "goal_closure_effect": {
          "const": "no_goal_closure_without_reviewed_receipts_or_explicit_manual_review_acceptance"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "provider",
        "credential_envs",
        "candidate_batch",
        "candidate_batch_present",
        "staged_receipt_path",
        "reviewed_receipt_path",
        "reviewed_receipt_present",
        "readiness_blockers",
        "require_env_preflight_command",
        "bounded_collection_run_command",
        "staged_receipt_validation_command",
        "reviewed_receipt_promotion_command",
        "next_action"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "provider": {
          "$ref": "#/$defs/non_empty_string"
        },
        "credential_envs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/env_name"
          },
          "uniqueItems": true
        },
        "candidate_batch": {
          "$ref": "#/$defs/non_empty_string"
        },
        "candidate_batch_present": {
          "type": "boolean"
        },
        "staged_receipt_path": {
          "$ref": "#/$defs/non_empty_string"
        },
        "reviewed_receipt_path": {
          "$ref": "#/$defs/non_empty_string"
        },
        "reviewed_receipt_present": {
          "type": "boolean"
        },
        "readiness_blockers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "uniqueItems": true
        },
        "require_env_preflight_command": {
          "$ref": "#/$defs/command"
        },
        "bounded_collection_run_command": {
          "$ref": "#/$defs/command"
        },
        "staged_receipt_validation_command": {
          "$ref": "#/$defs/command"
        },
        "reviewed_receipt_promotion_command": {
          "$ref": "#/$defs/command"
        },
        "next_action": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "source_queue_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "queue_status",
        "reviewed_receipts_checked_in",
        "reviewed_receipts_missing"
      ],
      "properties": {
        "queue_status": {
          "$ref": "#/$defs/non_empty_string"
        },
        "reviewed_receipts_checked_in": {
          "$ref": "#/$defs/count"
        },
        "reviewed_receipts_missing": {
          "$ref": "#/$defs/count"
        }
      }
    }
  }
}
