{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.datapan.dev/datapan.release-assembly-receipt.v1.schema.json",
  "title": "Datapan Release Assembly Receipt v1",
  "description": "Machine-readable receipt that binds the registry release assembly command sequence, workflow checks, and current release evidence inputs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "goal_issue",
    "assembly_ticket",
    "provider",
    "operator_command",
    "receipt_contract",
    "summary",
    "release_inputs",
    "phases"
  ],
  "properties": {
    "schema_version": {
      "const": "datapan.release-assembly-receipt.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "goal_issue": {
      "const": 344
    },
    "assembly_ticket": {
      "const": 358
    },
    "provider": {
      "const": "datapan-registry"
    },
    "operator_command": {
      "const": "python3 scripts/generate-release-assembly-receipt.py --check"
    },
    "receipt_contract": {
      "$ref": "#/$defs/receipt_contract"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "release_inputs": {
      "$ref": "#/$defs/release_inputs"
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/phase"
      }
    }
  },
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "receipt_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator", "schema", "output", "validator"],
      "properties": {
        "generator": {
          "const": "scripts/generate-release-assembly-receipt.py"
        },
        "schema": {
          "const": "schemas/datapan.release-assembly-receipt.v1.schema.json"
        },
        "output": {
          "const": "reports/release-assembly-receipt.json"
        },
        "validator": {
          "const": "python3 scripts/generate-release-assembly-receipt.py --check"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase_count",
        "release_ready",
        "readiness_failed",
        "manual_review_required",
        "assembly_status",
        "goal_status",
        "goal_criteria_proven",
        "goal_criteria_gap"
      ],
      "properties": {
        "phase_count": {
          "$ref": "#/$defs/count"
        },
        "release_ready": {
          "type": "boolean"
        },
        "readiness_failed": {
          "$ref": "#/$defs/count"
        },
        "manual_review_required": {
          "type": "boolean"
        },
        "assembly_status": {
          "enum": ["ready", "manual_review_required"]
        },
        "goal_status": {
          "enum": ["complete", "not_complete"]
        },
        "goal_criteria_proven": {
          "$ref": "#/$defs/count"
        },
        "goal_criteria_gap": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "release_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "readiness", "consumer_compatibility", "goal_audit"],
      "properties": {
        "manifest": {
          "$ref": "#/$defs/manifest_input"
        },
        "readiness": {
          "$ref": "#/$defs/readiness_input"
        },
        "consumer_compatibility": {
          "$ref": "#/$defs/consumer_compatibility_input"
        },
        "goal_audit": {
          "$ref": "#/$defs/goal_audit_input"
        }
      }
    },
    "manifest_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "generated_at", "artifact_count", "source_registry"],
      "properties": {
        "path": {
          "const": "manifest.json"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "artifact_count": {
          "type": "integer",
          "minimum": 1
        },
        "source_registry": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "readiness_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "ready", "gates_total", "passed", "failed"],
      "properties": {
        "path": {
          "const": "reports/latest-release-readiness.json"
        },
        "ready": {
          "type": "boolean"
        },
        "gates_total": {
          "$ref": "#/$defs/count"
        },
        "passed": {
          "$ref": "#/$defs/count"
        },
        "failed": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "consumer_compatibility_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "consumer_count",
        "blocked_consumers",
        "manual_review_required",
        "runtime_blocking_count",
        "runtime_warning_count"
      ],
      "properties": {
        "path": {
          "const": "reports/release-consumer-compatibility.json"
        },
        "consumer_count": {
          "$ref": "#/$defs/count"
        },
        "blocked_consumers": {
          "$ref": "#/$defs/count"
        },
        "manual_review_required": {
          "type": "boolean"
        },
        "runtime_blocking_count": {
          "$ref": "#/$defs/count"
        },
        "runtime_warning_count": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "goal_audit_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "goal_status", "decision"],
      "properties": {
        "path": {
          "const": "docs/release-ledger-goal-completion-audit.json"
        },
        "goal_status": {
          "enum": ["complete", "not_complete"]
        },
        "decision": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "coverage",
        "operator_commands",
        "check_commands",
        "workflow_fragments",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "coverage": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "registry",
              "registry_artifacts",
              "schema",
              "source_contracts",
              "shard_release_distribution",
              "release_distribution",
              "verification_evidence",
              "error_action_routing",
              "downstream_impact",
              "consumer_compatibility",
              "evidence"
            ]
          },
          "uniqueItems": true
        },
        "operator_commands": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "check_commands": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "workflow_fragments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            ".github/workflows/verify-release.yml",
            ".github/workflows/release-draft.yml"
          ],
          "properties": {
            ".github/workflows/verify-release.yml": {
              "$ref": "#/$defs/non_empty_string_array"
            },
            ".github/workflows/release-draft.yml": {
              "$ref": "#/$defs/non_empty_string_array"
            }
          }
        },
        "status": {
          "const": "required"
        },
        "evidence_artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_artifact"
          }
        },
        "ci_outputs": {
          "$ref": "#/$defs/non_empty_string_array"
        }
      }
    },
    "evidence_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "manifest_bound"],
      "properties": {
        "path": {
          "$ref": "#/$defs/non_empty_string"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "manifest_bound": {
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/non_empty_string"
        },
        "schema": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    }
  }
}
