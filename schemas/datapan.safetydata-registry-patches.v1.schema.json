{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.datapan.dev/datapan.safetydata-registry-patches.v1.schema.json",
  "title": "Datapan Safety Data Registry Patches v1",
  "description": "Source-scoped patch evidence for adding Safety Data operation mappings to data.go.kr registry records.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "provider",
    "source_id",
    "generation_inputs",
    "summary",
    "patches",
    "skipped"
  ],
  "properties": {
    "schema_version": {
      "const": "datapan.safetydata-registry-patches.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "provider": {
      "const": "data.go.kr"
    },
    "source_id": {
      "const": "data_go_kr"
    },
    "generation_inputs": {
      "$ref": "#/$defs/generation_inputs"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "patches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/patch"
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skipped"
      }
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "generation_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry",
        "safetydata_operation_candidates"
      ],
      "properties": {
        "registry": {
          "$ref": "#/$defs/path"
        },
        "safetydata_operation_candidates": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_results",
        "patches",
        "operations_to_add",
        "already_applied",
        "skipped"
      ],
      "properties": {
        "candidate_results": {
          "$ref": "#/$defs/count"
        },
        "patches": {
          "$ref": "#/$defs/count"
        },
        "operations_to_add": {
          "$ref": "#/$defs/count"
        },
        "already_applied": {
          "$ref": "#/$defs/count"
        },
        "skipped": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "title",
        "organization",
        "action",
        "reason",
        "already_applied",
        "operation_count",
        "operations"
      ],
      "properties": {
        "dataset_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "title": {
          "$ref": "#/$defs/non_empty_string"
        },
        "organization": {
          "$ref": "#/$defs/non_empty_string"
        },
        "action": {
          "const": "add_operation_mapping"
        },
        "reason": {
          "const": "safetydata_operation_candidate"
        },
        "already_applied": {
          "type": "boolean"
        },
        "operation_count": {
          "const": 1
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/operation"
          }
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "endpoint",
        "request_params",
        "response_params",
        "source"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/non_empty_string"
        },
        "endpoint": {
          "type": "string",
          "pattern": "^https://www\\.safetydata\\.go\\.kr/V2/api/"
        },
        "request_params": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/param"
          }
        },
        "response_params": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/param"
          }
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "param": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "label"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/non_empty_string"
        },
        "label": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "url",
        "raw"
      ],
      "properties": {
        "system": {
          "const": "safetydata.go.kr"
        },
        "url": {
          "type": "string",
          "pattern": "^https://www\\.safetydata\\.go\\.kr/disaster-data/view\\?dataSn="
        },
        "raw": {
          "$ref": "#/$defs/source_raw"
        }
      }
    },
    "source_raw": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_sn",
        "api_view_url",
        "api_table_url",
        "source_api_name",
        "source_api_type",
        "source_data_format",
        "source_interface_id"
      ],
      "properties": {
        "data_sn": {
          "$ref": "#/$defs/non_empty_string"
        },
        "api_view_url": {
          "$ref": "#/$defs/non_empty_string"
        },
        "api_table_url": {
          "$ref": "#/$defs/non_empty_string"
        },
        "source_api_name": {
          "$ref": "#/$defs/non_empty_string"
        },
        "source_api_type": {
          "$ref": "#/$defs/non_empty_string"
        },
        "source_data_format": {
          "$ref": "#/$defs/non_empty_string"
        },
        "source_interface_id": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "skipped": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "reason"
      ],
      "properties": {
        "dataset_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "reason": {
          "enum": [
            "missing_response_params",
            "not_candidate"
          ]
        }
      }
    }
  }
}
