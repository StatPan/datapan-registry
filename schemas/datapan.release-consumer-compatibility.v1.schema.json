{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.datapan.dev/datapan.release-consumer-compatibility.v1.schema.json",
  "title": "Datapan Release Consumer Compatibility v1",
  "description": "Machine-readable compatibility matrix for release consumers of datapan-registry artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "provider",
    "source_id",
    "generation_inputs",
    "summary",
    "compatibility_path",
    "release_health_evidence",
    "manifest_evidence_contracts",
    "runtime_risk_evidence",
    "shard_policy",
    "shard_release_evidence",
    "consumers"
  ],
  "properties": {
    "schema_version": {
      "const": "datapan.release-consumer-compatibility.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "provider": {
      "const": "data.go.kr"
    },
    "source_id": {
      "const": "data_go_kr"
    },
    "generation_inputs": {
      "$ref": "#/$defs/generation_inputs"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "compatibility_path": {
      "$ref": "#/$defs/compatibility_path"
    },
    "release_health_evidence": {
      "$ref": "#/$defs/release_health_evidence"
    },
    "manifest_evidence_contracts": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/manifest_evidence_contract"
      }
    },
    "runtime_risk_evidence": {
      "$ref": "#/$defs/runtime_risk_evidence"
    },
    "shard_policy": {
      "$ref": "#/$defs/shard_policy"
    },
    "shard_release_evidence": {
      "$ref": "#/$defs/shard_release_evidence"
    },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/consumer"
      }
    }
  },
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_count",
        "proven_consumers",
        "blocked_consumers",
        "canonical_registry_required",
        "shard_assets_required"
      ],
      "properties": {
        "consumer_count": {
          "$ref": "#/$defs/count"
        },
        "proven_consumers": {
          "$ref": "#/$defs/count"
        },
        "blocked_consumers": {
          "$ref": "#/$defs/count"
        },
        "canonical_registry_required": {
          "type": "boolean"
        },
        "shard_assets_required": {
          "type": "boolean"
        }
      }
    },
    "generation_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "readiness"],
      "properties": {
        "manifest": {
          "$ref": "#/$defs/manifest_input"
        },
        "readiness": {
          "$ref": "#/$defs/readiness_input"
        }
      }
    },
    "manifest_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "generated_at", "artifact_count", "evidence_contracts"],
      "properties": {
        "path": {
          "$ref": "#/$defs/non_empty_string"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "artifact_count": {
          "type": "integer",
          "minimum": 1
        },
        "evidence_contracts": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "readiness_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "normalization",
        "normalized_sha256",
        "ready",
        "gates_total",
        "passed",
        "failed"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/non_empty_string"
        },
        "normalization": {
          "const": "omit_generated_at"
        },
        "normalized_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "ready": {
          "type": "boolean"
        },
        "gates_total": {
          "$ref": "#/$defs/count"
        },
        "passed": {
          "$ref": "#/$defs/count"
        },
        "failed": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "compatibility_path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "artifact_kind", "required", "status", "proof"],
      "properties": {
        "path": {
          "const": "data/data-go-kr.registry.json"
        },
        "artifact_kind": {
          "const": "registry"
        },
        "required": {
          "const": true
        },
        "status": {
          "enum": ["manifest_bound", "missing", "deprecated"]
        },
        "proof": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        }
      }
    },
    "release_health_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_bundle",
        "required_schemas",
        "required_ci_reports",
        "rollup_generation_contract",
        "required_shard_install_fields"
      ],
      "properties": {
        "artifact_bundle": {
          "const": "datapan-registry-release-health"
        },
        "required_schemas": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "required_ci_reports": {
          "type": "array",
          "minItems": 5,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "rollup_generation_contract": {
          "$ref": "#/$defs/rollup_generation_contract"
        },
        "required_shard_install_fields": {
          "type": "array",
          "minItems": 6,
          "items": {
            "enum": [
              "mode",
              "shards_asset_present",
              "shards_validated",
              "shards_inventory_present",
              "shards_count",
              "shards_records"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "rollup_generation_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator", "validator", "schema", "output", "inputs"],
      "properties": {
        "generator": {
          "const": "scripts/generate-release-health-rollup.py"
        },
        "validator": {
          "const": "scripts/validate-release-health-rollups.py"
        },
        "schema": {
          "const": "schemas/datapan.release-health-rollup.v1.schema.json"
        },
        "output": {
          "const": ".datapan/ci/release-health-rollup.json"
        },
        "inputs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/current_rollup_input"
            },
            {
              "$ref": "#/$defs/latest_rollup_input"
            }
          ]
        }
      }
    },
    "current_rollup_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "install_summary", "doctor_summary"],
      "properties": {
        "scope": {
          "const": "current"
        },
        "install_summary": {
          "const": ".datapan/ci/current-release-install-smoke.json"
        },
        "doctor_summary": {
          "const": ".datapan/ci/current-release-doctor-smoke.json"
        }
      }
    },
    "latest_rollup_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "install_summary", "doctor_summary"],
      "properties": {
        "scope": {
          "const": "latest"
        },
        "install_summary": {
          "const": ".datapan/ci/latest-release-install-smoke.json"
        },
        "doctor_summary": {
          "const": ".datapan/ci/latest-release-doctor-smoke.json"
        }
      }
    },
    "shard_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "asset_name",
        "required_for_release",
        "publication_status",
        "monolith_fallback_required",
        "downstream_tracking",
        "blocked_until"
      ],
      "properties": {
        "phase": {
          "const": "compatibility_period"
        },
        "asset_name": {
          "const": "data-go-kr-shards.tar.gz"
        },
        "required_for_release": {
          "const": false
        },
        "publication_status": {
          "enum": ["optional_draft_asset", "required_release_asset", "blocked"]
        },
        "monolith_fallback_required": {
          "const": true
        },
        "downstream_tracking": {
          "type": "string",
          "pattern": "^StatPan/datapan-cli#[0-9]+$"
        },
        "blocked_until": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        }
      }
    },
    "shard_release_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "workflow",
        "gate_name",
        "source_registry",
        "generated_inventory",
        "generated_archive",
        "archive_check",
        "required_commands"
      ],
      "properties": {
        "status": {
          "const": "ci_validated_optional_asset"
        },
        "workflow": {
          "const": ".github/workflows/verify-release.yml"
        },
        "gate_name": {
          "const": "Validate full registry shard release evidence"
        },
        "source_registry": {
          "const": "data/data-go-kr.registry.json"
        },
        "generated_inventory": {
          "const": ".datapan/ci/full-registry-shards/registry-shards.json"
        },
        "generated_archive": {
          "const": ".datapan/ci/full-data-go-kr-shards.tar.gz"
        },
        "archive_check": {
          "const": ".datapan/ci/full-shard-archive-check.txt"
        },
        "required_commands": {
          "type": "array",
          "minItems": 4,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "uniqueItems": true
        }
      }
    },
    "manifest_evidence_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "path", "kind", "schema", "bytes", "sha256", "required"],
      "properties": {
        "contract": {
          "enum": [
            "source_contracts",
            "source_runtime_evidence",
            "source_runtime_remediation",
            "error_action_routing",
            "downstream_impact",
            "source_reference_drift",
            "source_report_inventory"
          ]
        },
        "path": {
          "$ref": "#/$defs/non_empty_string"
        },
        "kind": {
          "$ref": "#/$defs/non_empty_string"
        },
        "schema": {
          "type": "string",
          "format": "uri"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "required": {
          "const": true
        }
      }
    },
    "runtime_risk_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_runtime_rollup",
        "source_runtime_remediation_map",
        "error_action_routing_rollup",
        "downstream_impact_rollup",
        "manual_review_required",
        "compatibility_effect",
        "required_contracts",
        "blocking_count",
        "warning_count",
        "sources_without_evidence",
        "blocker_ids",
        "warning_ids",
        "sources",
        "remediation_follow_up_required",
        "remediation_manual_review_boundaries",
        "error_action_blocking_rules",
        "error_action_manual_review_rules",
        "downstream_manual_review_changes"
      ],
      "properties": {
        "source_runtime_rollup": {
          "const": "reports/source-runtime-evidence-rollup.json"
        },
        "source_runtime_remediation_map": {
          "const": "reports/source-runtime-remediation-map.json"
        },
        "error_action_routing_rollup": {
          "const": "reports/error-action-routing-rollup.json"
        },
        "downstream_impact_rollup": {
          "const": "reports/registry-impact-plan.json"
        },
        "manual_review_required": {
          "type": "boolean"
        },
        "compatibility_effect": {
          "enum": [
            "manual_review_required_until_runtime_blockers_resolved",
            "runtime_evidence_clear"
          ]
        },
        "required_contracts": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {
              "const": "source_runtime_evidence"
            },
            {
              "const": "source_runtime_remediation"
            },
            {
              "const": "error_action_routing"
            },
            {
              "const": "downstream_impact"
            }
          ]
        },
        "blocking_count": {
          "$ref": "#/$defs/count"
        },
        "warning_count": {
          "$ref": "#/$defs/count"
        },
        "sources_without_evidence": {
          "$ref": "#/$defs/count"
        },
        "blocker_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "uniqueItems": true
        },
        "warning_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "uniqueItems": true
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/runtime_risk_source"
          }
        },
        "remediation_follow_up_required": {
          "$ref": "#/$defs/count"
        },
        "remediation_manual_review_boundaries": {
          "$ref": "#/$defs/count"
        },
        "error_action_blocking_rules": {
          "$ref": "#/$defs/count"
        },
        "error_action_manual_review_rules": {
          "$ref": "#/$defs/count"
        },
        "downstream_manual_review_changes": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "runtime_risk_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "blocking_count",
        "warning_count",
        "blocker_ids",
        "warning_ids"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "blocking_count": {
          "$ref": "#/$defs/count"
        },
        "warning_count": {
          "$ref": "#/$defs/count"
        },
        "blocker_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "uniqueItems": true
        },
        "warning_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "uniqueItems": true
        }
      }
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumer", "surfaces", "compatibility_mode", "status", "evidence", "notes"],
      "properties": {
        "consumer": {
          "enum": [
            "datapan-cli",
            "datapan-api",
            "datapan-data",
            "sdk",
            "mcp",
            "studio",
            "release-operator"
          ]
        },
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "compatibility_mode": {
          "enum": [
            "canonical_monolith",
            "registry_metadata",
            "no_served_contract",
            "shard_preferred_with_monolith_fallback"
          ]
        },
        "status": {
          "enum": ["proven", "additive", "blocked", "not_required"]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "notes": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    }
  }
}
