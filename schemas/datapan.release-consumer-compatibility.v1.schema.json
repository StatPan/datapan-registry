{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.datapan.dev/datapan.release-consumer-compatibility.v1.schema.json",
  "title": "Datapan Release Consumer Compatibility v1",
  "description": "Machine-readable compatibility matrix for release consumers of datapan-registry artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "provider",
    "source_id",
    "generation_inputs",
    "summary",
    "compatibility_path",
    "release_health_evidence",
    "manifest_evidence_contracts",
    "runtime_risk_evidence",
    "shard_policy",
    "shard_release_evidence",
    "consumers"
  ],
  "properties": {
    "schema_version": {
      "const": "datapan.release-consumer-compatibility.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "provider": {
      "const": "data.go.kr"
    },
    "source_id": {
      "const": "data_go_kr"
    },
    "generation_inputs": {
      "$ref": "#/$defs/generation_inputs"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "compatibility_path": {
      "$ref": "#/$defs/compatibility_path"
    },
    "release_health_evidence": {
      "$ref": "#/$defs/release_health_evidence"
    },
    "manifest_evidence_contracts": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/manifest_evidence_contract"
      }
    },
    "runtime_risk_evidence": {
      "$ref": "#/$defs/runtime_risk_evidence"
    },
    "shard_policy": {
      "$ref": "#/$defs/shard_policy"
    },
    "shard_release_evidence": {
      "$ref": "#/$defs/shard_release_evidence"
    },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/consumer"
      }
    }
  },
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_count",
        "proven_consumers",
        "blocked_consumers",
        "canonical_registry_required",
        "shard_assets_required"
      ],
      "properties": {
        "consumer_count": {
          "$ref": "#/$defs/count"
        },
        "proven_consumers": {
          "$ref": "#/$defs/count"
        },
        "blocked_consumers": {
          "$ref": "#/$defs/count"
        },
        "canonical_registry_required": {
          "type": "boolean"
        },
        "shard_assets_required": {
          "type": "boolean"
        }
      }
    },
    "generation_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "readiness"],
      "properties": {
        "manifest": {
          "$ref": "#/$defs/manifest_input"
        },
        "readiness": {
          "$ref": "#/$defs/readiness_input"
        }
      }
    },
    "manifest_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "generated_at", "artifact_count", "evidence_contracts"],
      "properties": {
        "path": {
          "$ref": "#/$defs/non_empty_string"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "artifact_count": {
          "type": "integer",
          "minimum": 1
        },
        "evidence_contracts": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "readiness_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "normalization",
        "normalized_sha256",
        "ready",
        "gates_total",
        "passed",
        "failed"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/non_empty_string"
        },
        "normalization": {
          "const": "omit_generated_at"
        },
        "normalized_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "ready": {
          "type": "boolean"
        },
        "gates_total": {
          "$ref": "#/$defs/count"
        },
        "passed": {
          "$ref": "#/$defs/count"
        },
        "failed": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "compatibility_path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "artifact_kind", "required", "status", "proof"],
      "properties": {
        "path": {
          "const": "data/data-go-kr.registry.json"
        },
        "artifact_kind": {
          "const": "registry"
        },
        "required": {
          "const": true
        },
        "status": {
          "enum": ["manifest_bound", "missing", "deprecated"]
        },
        "proof": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        }
      }
    },
    "release_health_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_bundle",
        "required_schemas",
        "required_ci_reports",
        "rollup_generation_contract",
        "required_shard_install_fields"
      ],
      "properties": {
        "artifact_bundle": {
          "const": "datapan-registry-release-health"
        },
        "required_schemas": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "required_ci_reports": {
          "type": "array",
          "minItems": 5,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "rollup_generation_contract": {
          "$ref": "#/$defs/rollup_generation_contract"
        },
        "required_shard_install_fields": {
          "type": "array",
          "minItems": 6,
          "items": {
            "enum": [
              "mode",
              "shards_asset_present",
              "shards_validated",
              "shards_inventory_present",
              "shards_count",
              "shards_records"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "rollup_generation_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator", "validator", "schema", "output", "inputs"],
      "properties": {
        "generator": {
          "const": "scripts/generate-release-health-rollup.py"
        },
        "validator": {
          "const": "scripts/validate-release-health-rollups.py"
        },
        "schema": {
          "const": "schemas/datapan.release-health-rollup.v1.schema.json"
        },
        "output": {
          "const": ".datapan/ci/release-health-rollup.json"
        },
        "inputs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/current_rollup_input"
            },
            {
              "$ref": "#/$defs/latest_rollup_input"
            }
          ]
        }
      }
    },
    "current_rollup_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "install_summary", "doctor_summary"],
      "properties": {
        "scope": {
          "const": "current"
        },
        "install_summary": {
          "const": ".datapan/ci/current-release-install-smoke.json"
        },
        "doctor_summary": {
          "const": ".datapan/ci/current-release-doctor-smoke.json"
        }
      }
    },
    "latest_rollup_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "install_summary", "doctor_summary"],
      "properties": {
        "scope": {
          "const": "latest"
        },
        "install_summary": {
          "const": ".datapan/ci/latest-release-install-smoke.json"
        },
        "doctor_summary": {
          "const": ".datapan/ci/latest-release-doctor-smoke.json"
        }
      }
    },
    "shard_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "asset_name",
        "required_for_release",
        "publication_status",
        "monolith_fallback_required",
        "downstream_tracking",
        "blocked_until"
      ],
      "properties": {
        "phase": {
          "const": "compatibility_period"
        },
        "asset_name": {
          "const": "data-go-kr-shards.tar.gz"
        },
        "required_for_release": {
          "const": false
        },
        "publication_status": {
          "enum": ["optional_draft_asset", "required_release_asset", "blocked"]
        },
        "monolith_fallback_required": {
          "const": true
        },
        "downstream_tracking": {
          "type": "string",
          "pattern": "^StatPan/datapan-cli#[0-9]+$"
        },
        "blocked_until": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        }
      }
    },
    "shard_release_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "workflow",
        "gate_name",
        "source_registry",
        "generated_inventory",
        "generated_archive",
        "archive_check",
        "required_commands",
        "release_distribution_footprint",
        "canonical_registry_bytes",
        "manifest_bound_bytes_excluding_self",
        "large_monolith_threshold_bytes",
        "registry_footprint_status",
        "canonical_registry_required",
        "shard_distribution_required",
        "monolith_fallback_required",
        "footprint_consumer_effect"
      ],
      "properties": {
        "status": {
          "const": "ci_validated_optional_asset"
        },
        "workflow": {
          "const": ".github/workflows/verify-release.yml"
        },
        "gate_name": {
          "const": "Validate full registry shard release evidence"
        },
        "source_registry": {
          "const": "data/data-go-kr.registry.json"
        },
        "generated_inventory": {
          "const": ".datapan/ci/full-registry-shards/registry-shards.json"
        },
        "generated_archive": {
          "const": ".datapan/ci/full-data-go-kr-shards.tar.gz"
        },
        "archive_check": {
          "const": ".datapan/ci/full-shard-archive-check.txt"
        },
        "required_commands": {
          "type": "array",
          "minItems": 4,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "uniqueItems": true
        },
        "release_distribution_footprint": {
          "const": "reports/release-distribution-footprint.json"
        },
        "canonical_registry_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "manifest_bound_bytes_excluding_self": {
          "type": "integer",
          "minimum": 1
        },
        "large_monolith_threshold_bytes": {
          "const": 100000000
        },
        "registry_footprint_status": {
          "const": "large_monolith_shard_additive"
        },
        "canonical_registry_required": {
          "const": true
        },
        "shard_distribution_required": {
          "const": false
        },
        "monolith_fallback_required": {
          "const": true
        },
        "footprint_consumer_effect": {
          "const": "canonical_registry_required_shards_optional"
        }
      }
    },
    "manifest_evidence_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "path", "kind", "schema", "bytes", "sha256", "required"],
      "properties": {
        "contract": {
          "enum": [
            "source_contracts",
            "source_runtime_evidence",
            "source_runtime_remediation",
            "credential_runtime_evidence_policy",
            "credential_runtime_collection_preflight",
            "credential_runtime_runner_readiness",
            "credential_runtime_receipt_collection_queue",
            "credential_runtime_review_handoff",
            "credential_runtime_manual_review_decision",
            "credential_runtime_manual_review_acceptance",
            "error_action_routing",
            "downstream_impact",
            "source_reference_drift",
            "source_report_inventory",
            "release_distribution_footprint",
            "release_consumer_decision"
          ]
        },
        "path": {
          "$ref": "#/$defs/non_empty_string"
        },
        "kind": {
          "$ref": "#/$defs/non_empty_string"
        },
        "schema": {
          "type": "string",
          "format": "uri"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "required": {
          "const": true
        }
      }
    },
    "runtime_risk_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_runtime_rollup",
        "source_runtime_remediation_map",
        "credential_runtime_evidence_policy",
        "credential_runtime_collection_preflight",
        "credential_runtime_runner_readiness",
        "credential_runtime_receipt_collection_queue",
        "credential_runtime_review_handoff",
        "credential_runtime_manual_review_decision",
        "credential_runtime_manual_review_acceptance",
        "error_action_routing_rollup",
        "downstream_impact_rollup",
        "manual_review_required",
        "compatibility_effect",
        "required_contracts",
        "blocking_count",
        "warning_count",
        "sources_without_evidence",
        "blocker_ids",
        "warning_ids",
        "sources",
        "remediation_follow_up_required",
        "remediation_manual_review_boundaries",
        "remediation_credential_policy_available",
        "remediation_receipt_contract_available",
        "remediation_reviewed_receipt_intake_available",
        "remediation_receipt_reviewed",
        "remediation_receipt_relief_eligible",
        "remediation_receipt_backed_relief_allowed",
        "remediation_receipt_backed_relief_status",
        "remediation_receipt_linked_findings",
        "remediation_receipt_linked_absent",
        "remediation_receipt_linked_relief_eligible",
        "credential_policy_sources",
        "credential_policy_manual_review_boundaries",
        "credential_policy_receipt_contract_available",
        "credential_policy_reviewed_receipt_intake_available",
        "credential_policy_receipt_present",
        "credential_policy_receipt_validated",
        "credential_policy_receipt_reviewed",
        "credential_policy_receipt_relief_eligible",
        "credential_policy_manual_review_reduction_allowed",
        "credential_policy_live_receipts",
        "credential_policy_reviewed_receipts",
        "credential_policy_default_ci_requires_credentials",
        "credential_collection_preflight_status",
        "credential_collection_preflight_candidate_batches_present",
        "credential_collection_preflight_candidate_batches_missing",
        "credential_collection_preflight_reviewed_receipts_present",
        "credential_collection_preflight_reviewed_receipts_missing",
        "credential_collection_preflight_default_ci_runnable_sources",
        "credential_collection_preflight_operator_environment_required_sources",
        "credential_collection_preflight_manual_review_reduction_allowed",
        "credential_runner_readiness_status",
        "credential_runner_ready_to_run_without_credentials",
        "credential_runner_blocked_on_operator_env",
        "credential_runner_blocked_on_candidate_batch",
        "credential_runner_reviewed_receipts_present",
        "credential_runner_reviewed_receipts_missing",
        "credential_runner_default_ci_requires_credentials",
        "credential_runner_checked_in_secrets_allowed",
        "credential_runner_manual_review_reduction_allowed",
        "credential_runner_local_session_artifacts_checked_in",
        "credential_policy_effect",
        "credential_policy_relief_gate_status",
        "credential_queue_status",
        "credential_queue_absent",
        "credential_queue_staged_only",
        "credential_queue_reviewed_rejected",
        "credential_queue_reviewed_accepted",
        "credential_queue_relief_eligible",
        "credential_queue_reviewed_receipts",
        "credential_queue_manual_review_reduction_allowed",
        "credential_queue_default_ci_requires_credentials",
        "credential_handoff_status",
        "credential_handoff_pending_review_sources",
        "credential_handoff_reviewed_receipts",
        "credential_handoff_relief_eligible_sources",
        "credential_handoff_global_manual_review_relief_allowed",
        "credential_handoff_manual_review_required",
        "credential_handoff_default_ci_requires_credentials",
        "credential_handoff_relief_decision",
        "manual_review_decision_status",
        "manual_review_decision_accepted",
        "manual_review_decision_reason",
        "manual_review_decision_boundary_accepted",
        "manual_review_acceptance_status",
        "manual_review_acceptance_accepted",
        "manual_review_acceptance_decision",
        "manual_review_acceptance_required_evidence",
        "manual_review_acceptance_boundary_accepted",
        "manual_review_acceptance_goal_completion_effect",
        "manual_review_reduction_allowed",
        "manual_review_reduction_status",
        "error_action_blocking_rules",
        "error_action_manual_review_rules",
        "downstream_manual_review_changes"
      ],
      "properties": {
        "source_runtime_rollup": {
          "const": "reports/source-runtime-evidence-rollup.json"
        },
        "source_runtime_remediation_map": {
          "const": "reports/source-runtime-remediation-map.json"
        },
        "credential_runtime_evidence_policy": {
          "const": "reports/credential-runtime-evidence-policy.json"
        },
        "credential_runtime_collection_preflight": {
          "const": "reports/credential-runtime-collection-preflight.json"
        },
        "credential_runtime_runner_readiness": {
          "const": "reports/credential-runtime-runner-readiness.json"
        },
        "credential_runtime_receipt_collection_queue": {
          "const": "reports/credential-runtime-receipt-collection-queue.json"
        },
        "credential_runtime_review_handoff": {
          "const": "reports/credential-runtime-review-handoff.json"
        },
        "credential_runtime_manual_review_decision": {
          "const": "reports/credential-runtime-manual-review-decision.json"
        },
        "credential_runtime_manual_review_acceptance": {
          "const": "reports/credential-runtime-manual-review-acceptance.json"
        },
        "error_action_routing_rollup": {
          "const": "reports/error-action-routing-rollup.json"
        },
        "downstream_impact_rollup": {
          "const": "reports/registry-impact-plan.json"
        },
        "manual_review_required": {
          "type": "boolean"
        },
        "compatibility_effect": {
          "enum": [
            "manual_review_required_until_runtime_blockers_resolved",
            "runtime_evidence_clear"
          ]
        },
        "required_contracts": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "prefixItems": [
            {
              "const": "source_runtime_evidence"
            },
            {
              "const": "source_runtime_remediation"
            },
            {
              "const": "credential_runtime_evidence_policy"
            },
            {
              "const": "credential_runtime_collection_preflight"
            },
            {
              "const": "credential_runtime_runner_readiness"
            },
            {
              "const": "credential_runtime_receipt_collection_queue"
            },
            {
              "const": "credential_runtime_review_handoff"
            },
            {
              "const": "credential_runtime_manual_review_decision"
            },
            {
              "const": "credential_runtime_manual_review_acceptance"
            },
            {
              "const": "error_action_routing"
            },
            {
              "const": "downstream_impact"
            }
          ]
        },
        "blocking_count": {
          "$ref": "#/$defs/count"
        },
        "warning_count": {
          "$ref": "#/$defs/count"
        },
        "sources_without_evidence": {
          "$ref": "#/$defs/count"
        },
        "blocker_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "uniqueItems": true
        },
        "warning_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "uniqueItems": true
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/runtime_risk_source"
          }
        },
        "remediation_follow_up_required": {
          "$ref": "#/$defs/count"
        },
        "remediation_manual_review_boundaries": {
          "$ref": "#/$defs/count"
        },
        "remediation_credential_policy_available": {
          "const": true
        },
        "remediation_receipt_contract_available": {
          "const": true
        },
        "remediation_reviewed_receipt_intake_available": {
          "const": true
        },
        "remediation_receipt_reviewed": {
          "type": "boolean"
        },
        "remediation_receipt_relief_eligible": {
          "type": "boolean"
        },
        "remediation_receipt_backed_relief_allowed": {
          "type": "boolean"
        },
        "remediation_receipt_backed_relief_status": {
          "enum": [
            "blocked_until_validated_credential_runtime_receipts_exist",
            "blocked_until_reviewed_validated_credential_runtime_receipts_exist",
            "allowed_by_reviewed_validated_credential_runtime_receipts"
          ]
        },
        "remediation_receipt_linked_findings": {
          "$ref": "#/$defs/count"
        },
        "remediation_receipt_linked_absent": {
          "$ref": "#/$defs/count"
        },
        "remediation_receipt_linked_relief_eligible": {
          "$ref": "#/$defs/count"
        },
        "credential_policy_sources": {
          "$ref": "#/$defs/count"
        },
        "credential_policy_manual_review_boundaries": {
          "$ref": "#/$defs/count"
        },
        "credential_policy_receipt_contract_available": {
          "const": true
        },
        "credential_policy_reviewed_receipt_intake_available": {
          "const": true
        },
        "credential_policy_receipt_present": {
          "type": "boolean"
        },
        "credential_policy_receipt_validated": {
          "type": "boolean"
        },
        "credential_policy_receipt_reviewed": {
          "type": "boolean"
        },
        "credential_policy_receipt_relief_eligible": {
          "type": "boolean"
        },
        "credential_policy_manual_review_reduction_allowed": {
          "type": "boolean"
        },
        "credential_policy_live_receipts": {
          "$ref": "#/$defs/count"
        },
        "credential_policy_reviewed_receipts": {
          "$ref": "#/$defs/count"
        },
        "credential_policy_default_ci_requires_credentials": {
          "type": "boolean"
        },
        "credential_collection_preflight_status": {
          "enum": [
            "collection_required_operator_environment_needed",
            "collection_inputs_ready_operator_environment_needed",
            "reviewed_receipts_complete"
          ]
        },
        "credential_collection_preflight_candidate_batches_present": {
          "$ref": "#/$defs/count"
        },
        "credential_collection_preflight_candidate_batches_missing": {
          "$ref": "#/$defs/count"
        },
        "credential_collection_preflight_reviewed_receipts_present": {
          "$ref": "#/$defs/count"
        },
        "credential_collection_preflight_reviewed_receipts_missing": {
          "$ref": "#/$defs/count"
        },
        "credential_collection_preflight_default_ci_runnable_sources": {
          "const": 0
        },
        "credential_collection_preflight_operator_environment_required_sources": {
          "$ref": "#/$defs/count"
        },
        "credential_collection_preflight_manual_review_reduction_allowed": {
          "const": false
        },
        "credential_runner_readiness_status": {
          "enum": [
