{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.datapan.dev/datapan.credential-runtime-collection-session.v1.schema.json",
  "title": "Datapan Credential Runtime Collection Session v1",
  "description": "Secret-free batch credential runtime collection session output emitted by scripts/run-credential-runtime-collection.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "queue", "summary", "results"],
  "properties": {
    "schema_version": {
      "const": "datapan.credential-runtime-collection-session.v1"
    },
    "queue": {
      "$ref": "#/$defs/path"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "succeeded",
        "skipped_not_ready",
        "failed",
        "checked_in_secrets_allowed",
        "next_action"
      ],
      "properties": {
        "sources": {
          "$ref": "#/$defs/count"
        },
        "succeeded": {
          "$ref": "#/$defs/count"
        },
        "skipped_not_ready": {
          "$ref": "#/$defs/count"
        },
        "failed": {
          "$ref": "#/$defs/count"
        },
        "checked_in_secrets_allowed": {
          "const": false
        },
        "next_action": {
          "const": "review_and_promote_staged_receipts"
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/succeeded_result"
          },
          {
            "$ref": "#/$defs/skipped_result"
          },
          {
            "$ref": "#/$defs/failed_result"
          }
        ]
      }
    }
  },
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "safe_string": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "(?i)(<secret>|credential_value|authorization:|bearer\\s+|api[_-]?secret|service[_-]?key=)"
      }
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9_]+$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\\\]+$",
      "not": {
        "pattern": "(?i)(<secret>|authorization|bearer)"
      }
    },
    "env_name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "succeeded_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "status",
        "staged_receipt_path",
        "next_action",
        "reviewed_receipt_promotion_command"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/source_id"
        },
        "status": {
          "const": "succeeded"
        },
        "staged_receipt_path": {
          "$ref": "#/$defs/path"
        },
        "next_action": {
          "const": "review_and_promote_staged_receipt"
        },
        "reviewed_receipt_promotion_command": {
          "$ref": "#/$defs/safe_string"
        }
      }
    },
    "skipped_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "status",
        "reasons",
        "missing_credential_envs",
        "candidate_batch",
        "candidate_batch_present",
        "reviewed_receipt_path",
        "reviewed_receipt_present",
        "next_action"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/source_id"
        },
        "status": {
          "const": "skipped_not_ready"
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "missing_credential_env",
              "missing_candidate_batch",
              "reviewed_receipt_present"
            ]
          },
          "uniqueItems": true
        },
        "missing_credential_envs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/env_name"
          },
          "uniqueItems": true
        },
        "candidate_batch": {
          "$ref": "#/$defs/path"
        },
        "candidate_batch_present": {
          "type": "boolean"
        },
        "reviewed_receipt_path": {
          "$ref": "#/$defs/path"
        },
        "reviewed_receipt_present": {
          "type": "boolean"
        },
        "next_action": {
          "const": "resolve_readiness_then_rerun_batch"
        }
      }
    },
    "failed_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "status", "error", "next_action"],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/source_id"
        },
        "status": {
          "const": "failed"
        },
        "error": {
          "$ref": "#/$defs/safe_string"
        },
        "next_action": {
          "const": "inspect_source_error_then_rerun_or_keep_manual_review_boundary"
        }
      }
    }
  }
}
