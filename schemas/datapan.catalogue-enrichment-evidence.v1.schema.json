{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.datapan.dev/datapan.catalogue-enrichment-evidence.v1.schema.json",
  "title": "Datapan Catalogue Enrichment Evidence v1",
  "description": "Source-bound operation enrichment tied to the immutable producer candidate and the canonical data.go.kr detail page actually observed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "original_candidate_sha256", "provider_index_sha256", "adapter_revision", "extractor_revision", "records"],
  "properties": {
    "schema_version": {"const": "datapan.catalogue-enrichment-evidence.v1"},
    "original_candidate_sha256": {"$ref": "#/$defs/sha256"},
    "provider_index_sha256": {"$ref": "#/$defs/sha256"},
    "adapter_revision": {"$ref": "#/$defs/sha256"},
    "extractor_revision": {"$ref": "#/$defs/sha256"},
    "records": {"type": "array", "items": {"$ref": "#/$defs/record"}},
    "worker_outcomes": {"type": "array", "items": {"$ref": "#/$defs/workerOutcome"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nullableSha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "nullableHttpUrl": {
      "anyOf": [
        {"type": "string", "format": "uri", "pattern": "^https?://"},
        {"type": "null"}
      ]
    },
    "api_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "id"],
      "properties": {
        "provider": {"const": "data.go.kr"},
        "id": {"type": "string", "pattern": "^[0-9]+$"}
      }
    },
    "worker_api_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "id"],
      "properties": {
        "provider": {"const": "data.go.kr"},
        "id": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "source_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "page_url", "effective_url", "page_sha256", "observed_at"],
      "properties": {
        "system": {"const": "data.go.kr"},
        "page_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "effective_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "page_sha256": {"$ref": "#/$defs/sha256"},
        "observed_at": {"type": "string", "format": "date-time"}
      }
    },
    "link_metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "dataset_id", "public_data_pk", "public_data_detail_pk", "page", "resolver"],
      "properties": {
        "method": {"const": "data_go_kr_select_api_link_url_v1"},
        "dataset_id": {"type": "string", "pattern": "^[0-9]+$"},
        "public_data_pk": {"type": "string", "pattern": "^[0-9]+$"},
        "public_data_detail_pk": {"type": ["string", "null"], "maxLength": 256},
        "page": {
          "type": "object", "additionalProperties": false,
          "required": ["url", "effective_url", "sha256", "bytes", "observed_at"],
          "properties": {
            "url": {"type": "string", "format": "uri", "pattern": "^https://www\\.data\\.go\\.kr/data/[0-9]+/openapi\\.do$"},
            "effective_url": {"type": "string", "format": "uri", "pattern": "^https://www\\.data\\.go\\.kr/data/[0-9]+/openapi\\.do$"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
            "observed_at": {"type": "string", "format": "date-time"}
          }
        },
        "resolver": {
          "type": "object", "additionalProperties": false,
          "required": ["request_url", "effective_url", "sha256", "bytes", "observed_at", "public_data_detail_pk", "resolved_url", "resolved_url_sha256"],
          "properties": {
            "request_url": {"type": "string", "format": "uri", "pattern": "^https://www\\.data\\.go\\.kr/tcs/dss/selectApiLinkUrl\\.do\\?publicDataPk=[0-9]+$"},
            "effective_url": {"type": "string", "format": "uri", "pattern": "^https://www\\.data\\.go\\.kr/tcs/dss/selectApiLinkUrl\\.do\\?publicDataPk=[0-9]+$"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "bytes": {"type": "integer", "minimum": 1, "maximum": 65536},
            "observed_at": {"type": "string", "format": "date-time"},
            "public_data_detail_pk": {"type": ["string", "null"], "maxLength": 256},
            "resolved_url": {"type": "string", "format": "uri", "pattern": "^https?://", "maxLength": 4096},
            "resolved_url_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api_key", "source_sha256", "guide_sha256", "observed_guide_url", "observed_guide_url_sha256", "operations", "operations_sha256", "status", "source_provenance"],
      "properties": {
        "api_key": {"$ref": "#/$defs/api_key"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "guide_sha256": {"$ref": "#/$defs/nullableSha256"},
        "observed_guide_url": {"$ref": "#/$defs/nullableHttpUrl"},
        "observed_guide_url_sha256": {"$ref": "#/$defs/nullableSha256"},
        "operations": {"type": "array", "items": {"type": "object"}},
        "operations_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"const": "enriched"},
        "source_provenance": {"$ref": "#/$defs/source_provenance"}
      }
    },
    "workerOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api_key", "source_sha256", "guide_sha256", "status"],
      "properties": {
        "api_key": {"$ref": "#/$defs/worker_api_key"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "guide_sha256": {"$ref": "#/$defs/nullableSha256"},
        "status": {"enum": ["retry", "quarantined"]},
        "failure_diagnostic": {"$ref": "#/$defs/failure_diagnostic"},
        "link_metadata": {"$ref": "#/$defs/link_metadata"}
      },
      "allOf": [{
        "if": {"anyOf": [
          {"required": ["failure_diagnostic"], "properties": {"failure_diagnostic": {"required": ["code"], "properties": {"code": {"const": "resolved_link_operation_contract_unproven"}}}}},
          {"required": ["link_metadata"]}
        ]},
        "then": {
          "required": ["link_metadata", "failure_diagnostic"],
          "properties": {
            "status": {"const": "quarantined"},
            "failure_diagnostic": {
              "required": ["code", "phase"],
              "properties": {"code": {"const": "resolved_link_operation_contract_unproven"}, "phase": {"const": "resolver"}}
            }
          }
        }
      }]
    },
    "failure_diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {"enum": ["timeout", "transport_error", "provider_http_error", "response_bytes_cap", "unsafe_redirect", "contract_or_parse_error", "missing_link_detail_operations", "unsafe_or_unregistered_operation_host", "observation_mismatch", "unexpected_error", "insufficient_budget_for_link_resolver", "resolved_link_operation_contract_unproven"]},
        "http_status": {"type": "integer", "minimum": 400, "maximum": 599},
        "phase": {"enum": ["page", "resolver"]}
      },
      "allOf": [{"if": {"properties": {"code": {"const": "provider_http_error"}}, "required": ["code"]}, "then": {}, "else": {"not": {"required": ["http_status"]}}}]
    }
  }
}
