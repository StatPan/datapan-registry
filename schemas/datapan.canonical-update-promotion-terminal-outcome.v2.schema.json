{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.datapan.dev/datapan.canonical-update-promotion-terminal-outcome.v2.schema.json",
  "title": "Datapan Canonical Update Promotion Terminal Outcome v2",
  "description": "Attempt-bound, bounded C execution evidence with a closed source-target disposition variant. Native Actions metadata authenticates the artifact and completion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "workflow_path",
    "invocation",
    "evaluator",
    "execution_status",
    "started_at",
    "completed_at",
    "failure_code",
    "outcome"
  ],
  "properties": {
    "schema_version": {
      "const": "datapan.canonical-update-promotion-terminal-outcome.v2"
    },
    "repository": {
      "type": "string",
      "pattern": "^[^\\s/]+/[^\\s/]+$"
    },
    "workflow_path": {
      "const": ".github/workflows/canonical-update-promotion.yml"
    },
    "invocation": {
      "$ref": "#/$defs/invocation"
    },
    "evaluator": {
      "$ref": "#/$defs/evaluator"
    },
    "execution_status": {
      "enum": [
        "started",
        "completed",
        "failed"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "failure_code": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9_]{1,96}$"
    },
    "outcome": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/outcome"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "execution_status": {
            "const": "started"
          }
        },
        "required": [
          "execution_status"
        ]
      },
      "then": {
        "properties": {
          "completed_at": {
            "type": "null"
          },
          "failure_code": {
            "type": "null"
          },
          "outcome": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_status": {
            "const": "completed"
          }
        },
        "required": [
          "execution_status"
        ]
      },
      "then": {
        "properties": {
          "completed_at": {
            "type": "string"
          },
          "failure_code": {
            "type": "null"
          },
          "outcome": {
            "$ref": "#/$defs/outcome"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_status": {
            "const": "failed"
          }
        },
        "required": [
          "execution_status"
        ]
      },
      "then": {
        "properties": {
          "completed_at": {
            "type": "string"
          },
          "failure_code": {
            "type": "string"
          },
          "outcome": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "run_id",
        "run_attempt",
        "event"
      ],
      "properties": {
        "mode": {
          "enum": [
            "recover-ready",
            "reconcile-prs",
            "refresh-owned-source",
            "reconcile-publication"
          ]
        },
        "run_id": {
          "type": "string",
          "pattern": "^[0-9]{1,20}$"
        },
        "run_attempt": {
          "type": "integer",
          "minimum": 1
        },
        "event": {
          "enum": [
            "schedule",
            "workflow_run",
            "workflow_dispatch",
            "local"
          ]
        }
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_sha",
        "workflow_checkout_sha",
        "working_tree_head_sha",
        "checkout_matches_source",
        "loaded_files_match_source"
      ],
      "properties": {
        "source_sha": {
          "$ref": "#/$defs/revision"
        },
        "workflow_checkout_sha": {
          "$ref": "#/$defs/revision"
        },
        "working_tree_head_sha": {
          "$ref": "#/$defs/revision"
        },
        "checkout_matches_source": {
          "type": "boolean"
        },
        "loaded_files_match_source": {
          "type": "boolean"
        }
      }
    },
    "main_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "manifest_sha256",
        "registry_path",
        "registry_bytes",
        "registry_sha256"
      ],
      "properties": {
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/digest"
        },
        "registry_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "registry_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "registry_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation_id",
        "checkpoint_sha256",
        "source_id",
        "source_scope",
        "status",
        "reason_code",
        "producer",
        "checkpoint_observation",
        "checkpoint_observation_count",
        "generation_baseline_sha256",
        "checkpoint_derivation_sha256",
        "composition",
        "pending_count",
        "detail_retry_count",
        "detail_unattempted_count"
      ],
      "properties": {
        "generation_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/digest"
            }
          ]
        },
        "checkpoint_sha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/digest"
            }
          ]
        },
        "source_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "source_scope": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "status": {
          "enum": [
            "blocked",
            "already_canonical",
            "selected",
            "already_represented"
          ]
        },
        "reason_code": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9_]{1,96}$"
        },
        "producer": {
          "$ref": "#/$defs/producer"
        },
        "checkpoint_observation": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/checkpoint_observation"
            }
          ]
        },
        "checkpoint_observation_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "generation_baseline_sha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/digest"
            }
          ]
        },
        "checkpoint_derivation_sha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/digest"
            }
          ]
        },
        "composition": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/composition"
            }
          ]
        },
        "pending_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "detail_retry_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "detail_unattempted_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "run_attempt",
        "head_sha",
        "artifact_id",
        "artifact_name",
        "artifact_expires_at",
        "bundle_manifest_sha256"
      ],
      "properties": {
        "run_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{6,20}$"
        },
        "run_attempt": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "head_sha": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/revision"
            }
          ]
        },
        "artifact_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{1,20}$"
        },
        "artifact_name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "artifact_expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "bundle_manifest_sha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/digest"
            }
          ]
        }
      }
    },
    "checkpoint_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "observed_at",
        "producer_run_id",
        "refresh_evidence_sha256",
        "collection_status",
        "execution_mode"
      ],
      "properties": {
        "claim": {
          "const": "checkpoint_reported_last_observation"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "producer_run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "refresh_evidence_sha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/digest"
            }
          ]
        },
        "collection_status": {
          "enum": [
            "success",
            "failure",
            "missing"
          ]
        },
        "execution_mode": {
          "enum": [
            "live",
            "fixture"
          ]
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_sha256",
        "registry_path",
        "registry_bytes",
        "registry_sha256",
        "composition_receipt_sha256"
      ],
      "properties": {
        "baseline_sha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/digest"
            }
          ]
        },
        "registry_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "registry_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "registry_sha256": {
          "$ref": "#/$defs/digest"
        },
        "composition_receipt_sha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/digest"
            }
          ]
        }
      }
    },
    "screened_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "status",
        "candidate_available",
        "evaluated_main",
        "selected_generation_id",
        "preparation_returned",
        "generation_count",
        "generation_results_truncated",
        "generations"
      ],
      "properties": {
        "kind": {
          "enum": [
            "recover-ready",
            "reconcile-prs",
            "refresh-owned-source",
            "reconcile-publication"
          ]
        },
        "status": {
          "enum": [
            "no-eligible-ready-processor-bundle",
            "no-undelivered-ready-processor-bundle",
            "already-canonical-payload",
            "candidate_preparation_returned",
            "mode_completed_without_recovery_outcome"
          ]
        },
        "candidate_available": {
          "type": "boolean"
        },
        "evaluated_main": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/main_identity"
            }
          ]
        },
        "selected_generation_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/digest"
            }
          ]
        },
        "preparation_returned": {
          "type": "boolean"
        },
        "generation_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "generation_results_truncated": {
          "type": "boolean"
        },
        "generations": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/generation"
          }
        }
      }
    },
    "outcome": {
      "oneOf": [
        {
          "$ref": "#/$defs/screened_outcome"
        },
        {
          "$ref": "#/$defs/source_target_outcome"
        }
      ]
    },
    "source_target_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "status",
        "target_disposition",
        "generation_count",
        "generation_results_truncated",
        "generations",
        "selected_generation_id",
        "candidate_available"
      ],
      "properties": {
        "kind": {
          "const": "source_target_disposition"
        },
        "status": {
          "enum": [
            "source-target-pending",
            "source-target-completed",
            "source-target-blocked"
          ]
        },
        "target_disposition": {
          "$ref": "#/$defs/source_target_disposition"
        },
        "generation_count": {
          "const": 0
        },
        "generation_results_truncated": {
          "const": false
        },
        "generations": {
          "type": "array",
          "maxItems": 0
        },
        "selected_generation_id": {
          "type": "null"
        },
        "candidate_available": {
          "const": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "source-target-pending"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "target_disposition": {
                "properties": {
                  "disposition": {
                    "const": "pending"
                  }
                },
                "required": [
                  "disposition"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "source-target-completed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "target_disposition": {
                "properties": {
                  "disposition": {
                    "const": "completed"
                  }
                },
                "required": [
                  "disposition"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "source-target-blocked"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "target_disposition": {
                "properties": {
                  "disposition": {
                    "const": "blocked"
                  }
                },
                "required": [
                  "disposition"
                ]
              }
            }
          }
        }
      ]
    },
    "source_target_disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "selection_key",
        "original_observation_sha256",
        "target_contract_sha256",
        "disposition",
        "reason",
        "journal_commit",
        "evidence_refs",
        "revision_ref",
        "purpose_ref"
      ],
      "properties": {
        "schema_version": {
          "const": "datapan.canonical-update-source-target-disposition.v1"
        },
        "selection_key": {
          "$ref": "#/$defs/digest"
        },
        "original_observation_sha256": {
          "$ref": "#/$defs/digest"
        },
        "target_contract_sha256": {
          "$ref": "#/$defs/digest"
        },
        "disposition": {
          "enum": [
            "pending",
            "completed",
            "blocked"
          ]
        },
        "reason": {
          "type": "string",
          "pattern": "^[a-z0-9_]{1,96}$"
        },
        "journal_commit": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/revision"
            }
          ]
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/source_target_journal_evidence"
              },
              {
                "$ref": "#/$defs/source_target_pr_evidence"
              },
              {
                "$ref": "#/$defs/source_target_noop_evidence"
              }
            ]
          }
        },
        "revision_ref": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/source_target_revision_ref"
            }
          ]
        },
        "purpose_ref": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/source_target_purpose_ref"
            }
          ]
        }
      }
    },
    "source_target_journal_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "commit_sha",
        "bytes",
        "sha256"
      ],
      "properties": {
        "kind": {
          "const": "canonical_update_state_journal"
        },
        "commit_sha": {
          "$ref": "#/$defs/revision"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "source_target_pr_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "repository",
        "number",
        "head_sha",
        "body_sha256",
        "state"
      ],
      "properties": {
        "kind": {
          "const": "github_pull_request"
        },
        "repository": {
          "type": "string",
          "pattern": "^[^\\s/]+/[^\\s/]+$"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "head_sha": {
          "$ref": "#/$defs/revision"
        },
        "body_sha256": {
          "$ref": "#/$defs/digest"
        },
        "state": {
          "enum": [
            "open",
            "merged"
          ]
        },
        "merge_sha": {
          "$ref": "#/$defs/revision"
        }
      }
    },
    "source_target_noop_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "journal_commit_sha",
        "selection_key",
        "record_sha256",
        "evaluator_repository",
        "evaluator_workflow_path",
        "evaluator_event",
        "evaluator_source_sha",
        "evaluator_run_id",
        "evaluator_run_attempt",
        "terminal_evaluator_sha256",
        "terminal_projection_sha256",
        "target_inventory_sha256",
        "native_status",
        "native_conclusion"
      ],
      "properties": {
        "kind": {
          "const": "canonical_update_source_target_noop_v2"
        },
        "journal_commit_sha": {
          "$ref": "#/$defs/revision"
        },
        "selection_key": {
          "$ref": "#/$defs/digest"
        },
        "record_sha256": {
          "$ref": "#/$defs/digest"
        },
        "evaluator_repository": {
          "type": "string",
          "pattern": "^[^\\s/]+/[^\\s/]+$"
        },
        "evaluator_workflow_path": {
          "const": ".github/workflows/canonical-update-promotion.yml"
        },
        "evaluator_event": {
          "enum": [
            "schedule",
            "workflow_run",
            "workflow_dispatch"
          ]
        },
        "evaluator_source_sha": {
          "$ref": "#/$defs/revision"
        },
        "evaluator_run_id": {
          "type": "string",
          "pattern": "^[0-9]{1,20}$"
        },
        "evaluator_run_attempt": {
          "type": "integer",
          "minimum": 1
        },
        "terminal_evaluator_sha256": {
          "$ref": "#/$defs/digest"
        },
        "terminal_projection_sha256": {
          "$ref": "#/$defs/digest"
        },
        "target_inventory_sha256": {
          "$ref": "#/$defs/digest"
        },
        "native_status": {
          "enum": [
            "queued",
            "in_progress",
            "completed"
          ]
        },
        "native_conclusion": {
          "enum": [
            "success",
            "failure",
            "cancelled",
            "timed_out",
            "action_required",
            "neutral",
            "skipped",
            "stale",
            "startup_failure",
            null
          ]
        }
      }
    },
    "source_target_revision_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "source_id",
        "scope",
        "generation_id",
        "registry_sha256",
        "head_sha",
        "pr_number",
        "owner_id",
        "branch",
        "body_sha256"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[^\\s/]+/[^\\s/]+$"
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "generation_id": {
          "$ref": "#/$defs/digest"
        },
        "registry_sha256": {
          "$ref": "#/$defs/digest"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/digest"
        },
        "head_sha": {
          "$ref": "#/$defs/revision"
        },
        "pr_number": {
          "type": "integer",
          "minimum": 0
        },
        "owner_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "body_sha256": {
          "$ref": "#/$defs/digest"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
