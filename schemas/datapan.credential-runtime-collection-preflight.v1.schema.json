{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.datapan.dev/datapan.credential-runtime-collection-preflight.v1.schema.json",
  "title": "Datapan Credential Runtime Collection Preflight v1",
  "description": "Secret-free checked-in preflight for credential-gated runtime receipt collection readiness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "goal_issue",
    "preflight_ticket",
    "provider",
    "inputs",
    "summary",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "datapan.credential-runtime-collection-preflight.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "goal_issue": {
      "const": 344
    },
    "preflight_ticket": {
      "const": 399
    },
    "provider": {
      "const": "datapan-registry"
    },
    "inputs": {
      "$ref": "#/$defs/inputs"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queue", "runner_plan_mode"],
      "properties": {
        "queue": {
          "const": "reports/credential-runtime-receipt-collection-queue.json"
        },
        "runner_plan_mode": {
          "const": "secret_free_default_ci_preflight"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "credential_gated_sources",
        "candidate_batches_present",
        "candidate_batches_missing",
        "reviewed_receipts_present",
        "reviewed_receipts_missing",
        "default_ci_runnable_sources",
        "operator_environment_required_sources",
        "manual_review_reduction_allowed",
        "preflight_status"
      ],
      "properties": {
        "sources": {
          "$ref": "#/$defs/count"
        },
        "credential_gated_sources": {
          "$ref": "#/$defs/count"
        },
        "candidate_batches_present": {
          "$ref": "#/$defs/count"
        },
        "candidate_batches_missing": {
          "$ref": "#/$defs/count"
        },
        "reviewed_receipts_present": {
          "$ref": "#/$defs/count"
        },
        "reviewed_receipts_missing": {
          "$ref": "#/$defs/count"
        },
        "default_ci_runnable_sources": {
          "const": 0
        },
        "operator_environment_required_sources": {
          "$ref": "#/$defs/count"
        },
        "manual_review_reduction_allowed": {
          "type": "boolean"
        },
        "preflight_status": {
          "enum": [
            "collection_required_operator_environment_needed",
            "collection_inputs_ready_operator_environment_needed",
            "reviewed_receipts_complete"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "provider",
        "credential_envs",
        "operator_environment_required",
        "default_ci_runnable",
        "candidate_batch",
        "candidate_batch_present",
        "runtime_evidence_plan",
        "staged_receipt_path",
        "staged_receipt_present",
        "reviewed_receipt_path",
        "reviewed_receipt_present",
        "current_receipt_state",
        "receipt_relief_eligible",
        "collection_preflight_command",
        "collection_run_command",
        "collection_command_redacted",
        "staged_receipt_validation_command",
        "reviewed_receipt_validation_command",
        "reviewed_receipt_promotion_command",
        "next_action"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "provider": {
          "$ref": "#/$defs/non_empty_string"
        },
        "credential_envs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "uniqueItems": true
        },
        "operator_environment_required": {
          "const": true
        },
        "default_ci_runnable": {
          "const": false
        },
        "candidate_batch": {
          "$ref": "#/$defs/non_empty_string"
        },
        "candidate_batch_present": {
          "type": "boolean"
        },
        "runtime_evidence_plan": {
          "$ref": "#/$defs/non_empty_string"
        },
        "staged_receipt_path": {
          "$ref": "#/$defs/non_empty_string"
        },
        "staged_receipt_present": {
          "type": "boolean"
        },
        "reviewed_receipt_path": {
          "$ref": "#/$defs/non_empty_string"
        },
        "reviewed_receipt_present": {
          "type": "boolean"
        },
        "current_receipt_state": {
          "enum": ["absent", "staged_only", "reviewed_rejected", "reviewed_accepted", "relief_eligible"]
        },
        "receipt_relief_eligible": {
          "type": "boolean"
        },
        "collection_preflight_command": {
          "$ref": "#/$defs/non_empty_string"
        },
        "collection_run_command": {
          "$ref": "#/$defs/non_empty_string"
        },
        "collection_command_redacted": {
          "$ref": "#/$defs/non_empty_string"
        },
        "staged_receipt_validation_command": {
          "$ref": "#/$defs/non_empty_string"
        },
        "reviewed_receipt_validation_command": {
          "const": "python3 scripts/validate-credential-runtime-receipts.py"
        },
        "reviewed_receipt_promotion_command": {
          "$ref": "#/$defs/non_empty_string"
        },
        "next_action": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    }
  }
}
