{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://statpan.com/schemas/datapan.canonical-stale-queue-recovery-policy.v1.schema.json",
  "title": "Canonical stale C queue recovery policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "default_branch",
    "workflow_path",
    "concurrency_group",
    "cancel_in_progress",
    "minimum_age_seconds",
    "maximum_runtime_seconds",
    "request_timeout_seconds",
    "maximum_api_requests",
    "maximum_response_bytes",
    "maximum_total_response_bytes",
    "maximum_run_pages",
    "maximum_queued_runs",
    "maximum_jobs_pages",
    "maximum_compare_pages",
    "maximum_compare_commits",
    "terminal_observations",
    "terminal_observation_window_seconds",
    "maximum_reservation_records",
    "maximum_journal_bytes",
    "maximum_sidecar_bytes"
  ],
  "properties": {
    "schema_version": { "const": "datapan.canonical-stale-queue-recovery-policy.v1" },
    "repository": { "const": "StatPan/datapan-registry" },
    "default_branch": { "const": "main" },
    "workflow_path": { "const": ".github/workflows/canonical-update-promotion.yml" },
    "concurrency_group": { "const": "canonical-update-promotion" },
    "cancel_in_progress": { "const": false },
    "minimum_age_seconds": { "const": 86400 },
    "maximum_runtime_seconds": { "const": 120 },
    "request_timeout_seconds": { "const": 8 },
    "maximum_api_requests": { "const": 96 },
    "maximum_response_bytes": { "const": 2097152 },
    "maximum_total_response_bytes": { "const": 16777216 },
    "maximum_run_pages": { "const": 2 },
    "maximum_queued_runs": { "const": 12 },
    "maximum_jobs_pages": { "const": 2 },
    "maximum_compare_pages": { "const": 4 },
    "maximum_compare_commits": { "const": 400 },
    "terminal_observations": { "const": 3 },
    "terminal_observation_window_seconds": { "const": 15 },
    "maximum_reservation_records": { "const": 64 },
    "maximum_journal_bytes": { "const": 8388608 },
    "maximum_sidecar_bytes": { "const": 262144 }
  }
}
