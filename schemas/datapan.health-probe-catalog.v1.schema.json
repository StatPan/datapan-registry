{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.datapan.dev/datapan.health-probe-catalog.v1.schema.json",
  "title": "Datapan Health Probe Catalog v1",
  "description": "Registry-owned immutable operation identities and safe one-shot probe policy. Mutable receipts, credentials, query values, response rows, and live status are excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "authority", "receipt_contract", "source_registry", "summary", "entries"],
  "properties": {
    "schema_version": {"const": "datapan.health-probe-catalog.v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "authority": {"const": "datapan-registry"},
    "receipt_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "operation_key_algorithm", "policy_authority"],
      "properties": {
        "schema": {"const": "https://schemas.datapan.dev/datapan.health-probe.v1.schema.json"},
        "operation_key_algorithm": {"const": "datapan-cli-health-operation-key-v1"},
        "policy_authority": {"const": "datapan-registry"}
      }
    },
    "source_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"const": "data/data-go-kr.registry.json"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries", "gateway_canaries", "external_adapter_canaries"],
      "properties": {
        "entries": {"type": "integer", "minimum": 2},
        "gateway_canaries": {"type": "integer", "minimum": 1},
        "external_adapter_canaries": {"type": "integer", "minimum": 1}
      }
    },
    "entries": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "policy", "aliases", "provider", "endpoint", "eligibility", "credential_requirement", "response_freshness", "empty_data_policy"],
      "properties": {
        "operation_id": {"type": "string", "pattern": "^dpr-op-[0-9]{8}$"},
        "policy": {"$ref": "#/$defs/policy"},
        "aliases": {"$ref": "#/$defs/aliases"},
        "provider": {"type": "string", "minLength": 1},
        "endpoint": {"$ref": "#/$defs/endpoint"},
        "eligibility": {"$ref": "#/$defs/eligibility"},
        "credential_requirement": {"$ref": "#/$defs/credential"},
        "execution": {"$ref": "#/$defs/execution"},
        "response_freshness": {"$ref": "#/$defs/freshness"},
        "empty_data_policy": {"const": "observation_only"}
      },
      "allOf": [
        {
          "if": {"properties": {"eligibility": {"properties": {"status": {"enum": ["eligible", "credential_required"]}}}}},
          "then": {"required": ["execution"]},
          "else": {"not": {"required": ["execution"]}}
        }
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "version", "authority", "max_level"],
      "properties": {
        "key": {"type": "string", "pattern": "^dpr-op-[0-9]{8}$"},
        "version": {"const": 1},
        "authority": {"const": "datapan-registry"},
        "max_level": {"enum": ["L2", "L3", "L4"]}
      }
    },
    "aliases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "operation_name", "upstream_operation_seq", "cli_operation_key"],
      "properties": {
        "dataset_id": {"type": "string", "minLength": 1},
        "operation_name": {"type": "string", "minLength": 1},
        "upstream_operation_seq": {"type": "string", "minLength": 1},
        "cli_operation_key": {"$ref": "#/$defs/sha256"}
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "path", "dependency_class"],
      "properties": {
        "host": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^/"},
        "dependency_class": {"enum": ["data_go_kr_gateway", "external_endpoint"]}
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason_code"],
      "properties": {
        "status": {"enum": ["eligible", "credential_required", "manual_action_required", "unsupported"]},
        "reason_code": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"}
      }
    },
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "type", "scope"],
      "properties": {
        "required": {"type": "boolean"},
        "type": {"enum": ["none", "service_key", "api_key"]},
        "scope": {"enum": ["none", "source", "operation"]}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_ceiling_ms", "request_budget", "safe_parameters"],
      "properties": {
        "timeout_ceiling_ms": {"type": "integer", "minimum": 1000, "maximum": 30000},
        "request_budget": {"const": 1},
        "safe_parameters": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/safe_parameter"}
        }
      }
    },
    "safe_parameter": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "strategy", "minimum", "maximum"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "strategy": {"const": "bounded_integer"},
            "minimum": {"type": "integer"},
            "maximum": {"type": "integer"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "strategy", "offset_years", "minimum_year", "maximum_year"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "strategy": {"const": "relative_year"},
            "offset_years": {"type": "integer", "minimum": -10, "maximum": 0},
            "minimum_year": {"type": "integer", "minimum": 2000},
            "maximum_year": {"type": "integer", "maximum": 2200}
          }
        }
      ]
    },
    "freshness": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "not_asserted_reason"],
          "properties": {
            "mode": {"const": "not_asserted"},
            "not_asserted_reason": {
              "enum": [
                "upstream_timestamp_contract_not_reviewed",
                "upstream_response_has_no_stable_timestamp"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "timestamp_path", "timestamp_format", "timezone", "maximum_age_seconds"],
          "properties": {
            "mode": {"const": "asserted"},
            "timestamp_path": {"type": "string", "minLength": 1},
            "timestamp_format": {"type": "string", "minLength": 1},
            "timezone": {"type": "string", "minLength": 1},
            "maximum_age_seconds": {"type": "integer", "minimum": 60}
          }
        }
      ]
    }
  }
}
