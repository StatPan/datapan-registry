{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.datapan.dev/datapan.catalogue-composition-receipt.v1.schema.json",
  "title": "Datapan Catalogue Composition Receipt v1",
  "description": "Deterministic evidence for an offline, source-backed catalogue composition.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "producer", "input_digests", "status", "scope", "outputs"],
  "properties": {
    "schema_version": {"const": "datapan.catalogue-composition-receipt.v1"},
    "producer": {"$ref": "#/$defs/producer"},
    "input_digests": {"$ref": "#/$defs/input_digests"},
    "same_observation_derivation": {"$ref": "#/$defs/same_observation_derivation"},
    "status": {"enum": ["ready_scoped", "no_safe_change", "no_change"]},
    "scope": {"$ref": "#/$defs/scope"},
    "outputs": {
      "type": "object",
      "minProperties": 5,
      "additionalProperties": {"$ref": "#/$defs/digest"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "sha256"],
      "properties": {
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "run_id", "run_url"],
      "properties": {
        "repository": {"const": "StatPan/datapan-registry"},
        "run_id": {"type": "string", "pattern": "^[0-9]{6,20}$"},
        "run_url": {"type": "string", "format": "uri", "pattern": "^https://github\\.com/StatPan/datapan-registry/actions/runs/[0-9]+$"}
      }
    },
    "input_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "candidate", "full_diff", "refresh_evidence", "provider_index", "source_policy", "registry_schema", "provider_index_schema", "diff_schema", "refresh_evidence_schema", "enrichment_evidence_schema", "composer", "receipt_schema"],
      "properties": {
        "baseline": {"$ref": "#/$defs/digest"},
        "candidate": {"$ref": "#/$defs/digest"},
        "full_diff": {"$ref": "#/$defs/digest"},
        "refresh_evidence": {"$ref": "#/$defs/digest"},
        "provider_index": {"$ref": "#/$defs/digest"},
        "source_policy": {"$ref": "#/$defs/digest"},
        "registry_schema": {"$ref": "#/$defs/digest"},
        "provider_index_schema": {"$ref": "#/$defs/digest"},
        "diff_schema": {"$ref": "#/$defs/digest"},
        "refresh_evidence_schema": {"$ref": "#/$defs/digest"},
        "enrichment_evidence_schema": {"$ref": "#/$defs/digest"},
        "composer": {"$ref": "#/$defs/digest"},
        "receipt_schema": {"$ref": "#/$defs/digest"},
        "enrichment_evidence": {"$ref": "#/$defs/digest"},
        "composition_baseline": {"$ref": "#/$defs/digest"}
      }
    },
    "original_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_scope",
        "producer_run_id",
        "producer_run_attempt",
        "producer_head_sha",
        "producer_artifact_id",
        "producer_artifact_name",
        "producer_artifact_sha256",
        "observed_at",
        "original_baseline_sha256",
        "candidate_sha256",
        "evidence_sha256",
        "diff_sha256",
        "source_policy_sha256",
        "provider_index_sha256",
        "observation_count"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_scope": {
          "type": "string",
          "minLength": 1
        },
        "producer_run_id": {
          "type": "string",
          "pattern": "^[0-9]{1,20}$"
        },
        "producer_run_attempt": {
          "type": "integer",
          "minimum": 1
        },
        "producer_head_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "producer_artifact_id": {
          "type": "string",
          "pattern": "^[0-9]{1,20}$"
        },
        "producer_artifact_name": {
          "type": "string",
          "pattern": "^upstream-catalog-refresh-[0-9]{1,20}$"
        },
        "producer_artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "original_baseline_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "evidence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "diff_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "provider_index_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "observation_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "processor_parent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation_id",
        "checkpoint_sha256",
        "generation_inputs_sha256",
        "bundle_manifest_sha256",
        "repository",
        "artifact_run_id",
        "artifact_id",
        "artifact_name",
        "artifact_expires_at",
        "original_baseline_sha256",
        "candidate_sha256",
        "enrichment_evidence_sha256",
        "composition_receipt_sha256",
        "composed_registry_sha256",
        "original_observation_sha256",
        "contribution_set_sha256",
        "contribution_count",
        "processor_generator_revision",
        "processor_extractor_revision"
      ],
      "properties": {
        "generation_id": {
          "$ref": "#/$defs/sha256"
        },
        "checkpoint_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "generation_inputs_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bundle_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "repository": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "artifact_run_id": {
          "type": "string",
          "pattern": "^[0-9]{1,20}$"
        },
        "artifact_id": {
          "type": "string",
          "pattern": "^[0-9]{1,20}$"
        },
        "artifact_name": {
          "type": "string",
          "pattern": "^upstream-catalogue-processing-[0-9]+-[1-9][0-9]*$"
        },
        "artifact_expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "original_baseline_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "enrichment_evidence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "composition_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "composed_registry_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "original_observation_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "contribution_set_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "contribution_count": {
          "type": "integer",
          "minimum": 0
        },
        "processor_generator_revision": {
          "$ref": "#/$defs/sha256"
        },
        "processor_extractor_revision": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "canonical_parent_readback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "journal_ref_sha",
        "journal_sha256",
        "journal_record_index",
        "journal_record_sha256",
        "canonical_producer_generation_id",
        "source_id",
        "source_scope",
        "registry_path",
        "registry_bytes",
        "registry_sha256",
        "manifest_sha256",
        "pr_number",
        "pr_branch",
        "pr_body_sha256",
        "pr_head_sha",
        "merge_sha",
        "merge_ack_run_id",
        "merge_ack_run_attempt",
        "merge_ack_run_url",
        "merge_ack_observed_at",
        "merge_ack_manifest_sha256",
        "merge_ack_source_sha"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "journal_ref_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "journal_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "journal_record_index": {
          "type": "integer",
          "minimum": 0
        },
        "journal_record_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonical_producer_generation_id": {
          "$ref": "#/$defs/sha256"
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_scope": {
          "type": "string",
          "minLength": 1
        },
        "registry_path": {
          "const": "data/data-go-kr.registry.json"
        },
        "registry_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "registry_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "pr_number": {
          "type": "integer",
          "minimum": 1
        },
        "pr_branch": {
          "type": "string",
          "minLength": 1
        },
        "pr_body_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "pr_head_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "merge_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "merge_ack_run_id": {
          "type": "integer",
          "minimum": 1
        },
        "merge_ack_run_attempt": {
          "type": "integer",
          "minimum": 1
        },
        "merge_ack_run_url": {
          "type": "string",
          "format": "uri"
        },
        "merge_ack_observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "merge_ack_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "merge_ack_source_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "composition_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "main_sha",
        "manifest_sha256",
        "registry_path",
        "registry_sha256",
        "registry_bytes"
      ],
      "properties": {
        "main_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "registry_path": {
          "const": "data/data-go-kr.registry.json"
        },
        "registry_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "registry_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "same_observation_derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "derivation_revision",
        "original_observation",
        "resume_parent_processor",
        "canonical_parent_processor",
        "canonical_parent_readback",
        "composition_baseline",
        "derivation_processor_revision_sha256",
        "ancestor_generation_ids"
      ],
      "properties": {
        "schema_version": {
          "const": "datapan.same-observation-derivation.v1"
        },
        "derivation_revision": {
          "const": "same-observation-composition/v1"
        },
        "original_observation": {
          "$ref": "#/$defs/original_observation"
        },
        "resume_parent_processor": {
          "$ref": "#/$defs/processor_parent"
        },
        "canonical_parent_processor": {
          "$ref": "#/$defs/processor_parent"
        },
        "canonical_parent_readback": {
          "$ref": "#/$defs/canonical_parent_readback"
        },
        "composition_baseline": {
          "$ref": "#/$defs/composition_baseline"
        },
        "derivation_processor_revision_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "ancestor_generation_ids": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
        "items": {
          "$ref": "#/$defs/sha256"
        }
        }
      }
    },
    "api_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "id"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full_scope_fresh", "publication_allowed", "global_counts", "applied_api_keys", "retained_pending_api_keys", "quarantined_api_keys"],
      "properties": {
        "full_scope_fresh": {"const": false},
        "publication_allowed": {"const": false},
        "global_counts": {"type": "object"},
        "applied_api_keys": {"type": "array", "items": {"$ref": "#/$defs/api_key"}},
        "retained_pending_api_keys": {"type": "array", "items": {"$ref": "#/$defs/api_key"}},
        "quarantined_api_keys": {"type": "array", "items": {"$ref": "#/$defs/api_key"}}
      }
    }
  }
}
