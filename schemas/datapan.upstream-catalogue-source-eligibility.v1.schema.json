  "$id": "https://registry.statpan.com/schemas/datapan.upstream-catalogue-source-eligibility.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "evidence": {
            "type": "null"
          },
          "selection_key": {
            "type": "null"
          }
        }
      },
      "if": {
        "properties": {
          "action": {
            "enum": [
              "rebuild",
              "resume",
              "revalidate_c"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "$ref": "#/$defs/evidence"
          },
          "selection_key": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          }
        }
      }
    }
  ],
  "properties": {
    "action": {
      "enum": [
        "rebuild",
        "resume",
        "revalidate_c",
        "no_op",
        "deferred",
        "requires_new_a",
        "blocked"
      ]
    },
    "evaluation": {
      "$ref": "#/$defs/evaluation"
    },
    "evidence": {
      "oneOf": [
        {
          "$ref": "#/$defs/evidence"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason_code": {
      "pattern": "^[a-z0-9_]{1,96}$",
      "type": "string"
    },
    "repository": {
      "pattern": "^[^/\\s]+/[^/\\s]+$",
      "type": "string"
    },
    "schema_version": {
      "const": "datapan.upstream-catalogue-source-eligibility.v1"
    },
    "selection_key": {
      "oneOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_id": {
      "minLength": 1,
      "type": "string"
    },
    "source_scope": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "repository",
    "source_id",
    "source_scope",
    "action",
    "reason_code",
    "evaluation",
    "selection_key",
    "evidence"
  ],
  "title": "Datapan upstream catalogue source eligibility v1",
  "type": "object"
}
