{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.datapan.dev/datapan.credential-runtime-manual-review-decision.v1.schema.json",
  "title": "Datapan Credential Runtime Manual-Review Decision v1",
  "description": "Checked-in decision record for explicit manual-review release acceptance of credential-gated runtime boundaries.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "goal_issue",
    "decision_ticket",
    "provider",
    "inputs",
    "summary",
    "decision",
    "validation_contract"
  ],
  "properties": {
    "schema_version": {
      "const": "datapan.credential-runtime-manual-review-decision.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "goal_issue": {
      "const": 344
    },
    "decision_ticket": {
      "const": 391
    },
    "provider": {
      "const": "datapan-registry"
    },
    "inputs": {
      "$ref": "#/$defs/inputs"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "decision": {
      "$ref": "#/$defs/decision"
    },
    "validation_contract": {
      "$ref": "#/$defs/validation_contract"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "nullable_string": {
      "type": ["string", "null"]
    },
    "nullable_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credential_runtime_review_handoff",
        "release_consumer_compatibility"
      ],
      "properties": {
        "credential_runtime_review_handoff": {
          "const": "reports/credential-runtime-review-handoff.json"
        },
        "release_consumer_compatibility": {
          "const": "reports/release-consumer-compatibility.json"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted",
        "decision_status",
        "manual_review_release_boundary_accepted",
        "default_ci_requires_credentials",
        "checked_in_secrets_allowed"
      ],
      "properties": {
        "accepted": {
          "type": "boolean"
        },
        "decision_status": {
          "enum": ["not_asserted", "accepted"]
        },
        "manual_review_release_boundary_accepted": {
          "type": "boolean"
        },
        "default_ci_requires_credentials": {
          "const": false
        },
        "checked_in_secrets_allowed": {
          "const": false
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted",
        "decision_status",
        "reviewer",
        "reviewed_at",
        "reason",
        "handoff_sha256",
        "compatibility_sha256",
        "expires_at",
        "revalidation_triggers"
      ],
      "properties": {
        "accepted": {
          "type": "boolean"
        },
        "decision_status": {
          "enum": ["not_asserted", "accepted"]
        },
        "reviewer": {
          "$ref": "#/$defs/nullable_string"
        },
        "reviewed_at": {
          "$ref": "#/$defs/nullable_string"
        },
        "reason": {
          "$ref": "#/$defs/non_empty_string"
        },
        "handoff_sha256": {
          "$ref": "#/$defs/nullable_sha256"
        },
        "compatibility_sha256": {
          "$ref": "#/$defs/nullable_sha256"
        },
        "expires_at": {
          "$ref": "#/$defs/nullable_string"
        },
        "revalidation_triggers": {
          "type": "array",
          "items": {
            "enum": [
              "credential_receipt_state_changes",
              "consumer_compatibility_changes",
              "source_runtime_blocker_changes",
              "release_manifest_changes",
              "acceptance_expiry"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "validation_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validator",
        "acceptance_generator",
        "default_ci_mode"
      ],
      "properties": {
        "validator": {
          "const": "python3 scripts/validate-credential-runtime-manual-review-decision.py"
        },
        "acceptance_generator": {
          "const": "python3 scripts/generate-credential-runtime-manual-review-acceptance.py --check"
        },
        "default_ci_mode": {
          "const": "secret_free_decision_validation"
        }
      }
    }
  }
}
