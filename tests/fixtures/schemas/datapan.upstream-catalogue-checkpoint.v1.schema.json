{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.datapan.dev/datapan.upstream-catalogue-checkpoint.v1.schema.json",
  "title": "Datapan Upstream Catalogue Checkpoint v1",
  "description": "Small durable source-generation state. Large source inputs and result bundles remain digest-bound Actions artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "source_id", "source_scope", "generation_id", "generation_inputs",
    "observed_at", "last_observation", "observation_count", "last_heartbeat_at", "last_progress_at",
    "status", "attempts_consumed", "attempts_by_id", "detail_retry_reset_ids", "request_reservation", "detail_records", "detail_queue_cursor", "output_digests",
    "output_artifact", "input_artifacts", "lease", "fencing_token", "outcome", "checkpoint_sha256"
  ],
  "properties": {
    "schema_version": {"const": "datapan.upstream-catalogue-checkpoint.v1"},
    "source_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "source_scope": {"type": "string", "minLength": 1, "maxLength": 128},
    "generation_id": {"$ref": "#/$defs/digest"},
    "generation_inputs": {"$ref": "#/$defs/generation_inputs"},
    "observed_at": {"type": "string", "format": "date-time"},
    "last_observation": {"$ref": "#/$defs/observation"},
    "observation_count": {"type": "integer", "minimum": 1},
    "last_heartbeat_at": {"type": "string", "format": "date-time"},
    "last_progress_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["queued", "validating", "enriching", "composing", "ready", "no-change", "retry", "quarantined"]},
    "attempts_consumed": {"type": "integer", "minimum": 0, "maximum": 100000},
    "attempts_by_id": {
      "type": "object", "maxProperties": 4096,
      "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 100}
    },
    "detail_retry_reset_ids": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "request_reservation": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["owner_run_id", "generation_id", "fencing_token", "reserved_at", "expires_at", "attempt_budget", "reserved_attempts", "attempts_made", "records"],
          "properties": {
            "owner_run_id": {"type": "string", "minLength": 1, "maxLength": 128},
            "generation_id": {"$ref": "#/$defs/digest"},
            "fencing_token": {"type": "integer", "minimum": 1},
            "reserved_at": {"type": "string", "format": "date-time"},
            "expires_at": {"type": "string", "format": "date-time"},
            "attempt_budget": {"type": "integer", "minimum": 0, "maximum": 100},
            "reserved_attempts": {"type": "integer", "minimum": 0, "maximum": 100},
            "attempts_made": {"type": "integer", "minimum": 0, "maximum": 100},
            "records": {
              "type": "array", "maxItems": 48,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["id", "attempts_reserved", "source_sha256", "guide_sha256"],
                "properties": {
                  "id": {"type": "string", "minLength": 1, "maxLength": 128},
                  "attempts_reserved": {"type": "integer", "minimum": 1, "maximum": 100},
                  "source_sha256": {"$ref": "#/$defs/digest"},
                  "guide_sha256": {"$ref": "#/$defs/nullable_digest"}
                }
              }
            }
          }
        }
      ]
    },
    "detail_records": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/detail_record"}},
    "detail_queue_cursor": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "output_digests": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/artifact_digest"}},
    "output_artifact": {"$ref": "#/$defs/output_artifact"},
    "input_artifacts": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/input_artifact"}},
    "lease": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/lease"}]},
    "fencing_token": {"type": "integer", "minimum": 0},
    "outcome": {
      "type": "object", "maxProperties": 24,
      "properties": {
        "detail_failure_counts": {
          "type": "object", "maxProperties": 12,
          "propertyNames": {"enum": ["timeout", "transport_error", "provider_http_error", "response_bytes_cap", "unsafe_redirect", "contract_or_parse_error", "missing_link_detail_operations", "unsafe_or_unregistered_operation_host", "observation_mismatch", "unexpected_error", "insufficient_budget_for_link_resolver", "resolved_link_operation_contract_unproven"]},
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "detail_reason_unavailable_count": {"type": "integer", "minimum": 0},
        "detail_unattempted_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": {"type": ["string", "integer", "number", "boolean", "null", "array", "object"]}
    },
    "checkpoint_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nullable_digest": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
    "original_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_scope",
        "producer_run_id",
        "producer_run_attempt",
        "producer_head_sha",
        "producer_artifact_id",
        "producer_artifact_name",
        "producer_artifact_sha256",
        "observed_at",
        "original_baseline_sha256",
        "candidate_sha256",
        "evidence_sha256",
        "diff_sha256",
        "source_policy_sha256",
        "provider_index_sha256",
        "observation_count"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_scope": {
          "type": "string",
          "minLength": 1
        },
        "producer_run_id": {
          "type": "string",
          "pattern": "^[0-9]{1,20}$"
        },
        "producer_run_attempt": {
          "type": "integer",
          "minimum": 1
        },
        "producer_head_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "producer_artifact_id": {
          "type": "string",
          "pattern": "^[0-9]{1,20}$"
        },
        "producer_artifact_name": {
          "type": "string",
          "pattern": "^upstream-catalog-refresh-[0-9]{1,20}$"
        },
        "producer_artifact_sha256": {
          "$ref": "#/$defs/digest"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "original_baseline_sha256": {
          "$ref": "#/$defs/digest"
        },
        "candidate_sha256": {
          "$ref": "#/$defs/digest"
        },
        "evidence_sha256": {
          "$ref": "#/$defs/digest"
        },
        "diff_sha256": {
          "$ref": "#/$defs/digest"
        },
        "source_policy_sha256": {
          "$ref": "#/$defs/digest"
        },
        "provider_index_sha256": {
          "$ref": "#/$defs/digest"
        },
        "observation_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "processor_parent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation_id",
        "checkpoint_sha256",
        "generation_inputs_sha256",
        "bundle_manifest_sha256",
        "repository",
        "artifact_run_id",
        "artifact_id",
        "artifact_name",
        "artifact_expires_at",
        "original_baseline_sha256",
        "candidate_sha256",
        "enrichment_evidence_sha256",
        "composition_receipt_sha256",
        "composed_registry_sha256",
        "original_observation_sha256",
        "contribution_set_sha256",
        "contribution_count",
        "processor_generator_revision",
        "processor_extractor_revision"
      ],
      "properties": {
        "generation_id": {
          "$ref": "#/$defs/digest"
        },
        "checkpoint_sha256": {
          "$ref": "#/$defs/digest"
        },
        "generation_inputs_sha256": {
          "$ref": "#/$defs/digest"
        },
        "bundle_manifest_sha256": {
          "$ref": "#/$defs/digest"
        },
        "repository": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "artifact_run_id": {
          "type": "string",
          "pattern": "^[0-9]{1,20}$"
        },
        "artifact_id": {
          "type": "string",
          "pattern": "^[0-9]{1,20}$"
        },
        "artifact_name": {
          "type": "string",
          "pattern": "^upstream-catalogue-processing-[0-9]+-[1-9][0-9]*$"
        },
        "artifact_expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "original_baseline_sha256": {
          "$ref": "#/$defs/digest"
        },
        "candidate_sha256": {
          "$ref": "#/$defs/digest"
        },
        "enrichment_evidence_sha256": {
          "$ref": "#/$defs/digest"
        },
        "composition_receipt_sha256": {
          "$ref": "#/$defs/digest"
        },
        "composed_registry_sha256": {
          "$ref": "#/$defs/digest"
        },
        "original_observation_sha256": {
          "$ref": "#/$defs/digest"
        },
        "contribution_set_sha256": {
          "$ref": "#/$defs/digest"
        },
        "contribution_count": {
          "type": "integer",
          "minimum": 0
        },
        "processor_generator_revision": {
          "$ref": "#/$defs/digest"
        },
        "processor_extractor_revision": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "canonical_parent_readback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "journal_ref_sha",
        "journal_sha256",
        "journal_record_index",
        "journal_record_sha256",
        "canonical_producer_generation_id",
        "source_id",
        "source_scope",
        "registry_path",
        "registry_bytes",
        "registry_sha256",
        "manifest_sha256",
        "pr_number",
        "pr_branch",
        "pr_body_sha256",
        "pr_head_sha",
        "merge_sha",
        "merge_ack_run_id",
        "merge_ack_run_attempt",
        "merge_ack_run_url",
        "merge_ack_observed_at",
        "merge_ack_manifest_sha256",
        "merge_ack_source_sha"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "journal_ref_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "journal_sha256": {
          "$ref": "#/$defs/digest"
        },
        "journal_record_index": {
          "type": "integer",
          "minimum": 0
        },
        "journal_record_sha256": {
          "$ref": "#/$defs/digest"
        },
        "canonical_producer_generation_id": {
          "$ref": "#/$defs/digest"
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_scope": {
          "type": "string",
          "minLength": 1
        },
        "registry_path": {
          "const": "data/data-go-kr.registry.json"
        },
        "registry_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "registry_sha256": {
          "$ref": "#/$defs/digest"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/digest"
        },
        "pr_number": {
          "type": "integer",
          "minimum": 1
        },
        "pr_branch": {
          "type": "string",
          "minLength": 1
        },
        "pr_body_sha256": {
          "$ref": "#/$defs/digest"
        },
        "pr_head_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "merge_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "merge_ack_run_id": {
          "type": "integer",
          "minimum": 1
        },
        "merge_ack_run_attempt": {
          "type": "integer",
          "minimum": 1
        },
        "merge_ack_run_url": {
          "type": "string",
          "format": "uri"
        },
        "merge_ack_observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "merge_ack_manifest_sha256": {
          "$ref": "#/$defs/digest"
        },
        "merge_ack_source_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "composition_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "main_sha",
        "manifest_sha256",
        "registry_path",
        "registry_sha256",
        "registry_bytes"
      ],
      "properties": {
        "main_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/digest"
        },
        "registry_path": {
          "const": "data/data-go-kr.registry.json"
        },
        "registry_sha256": {
          "$ref": "#/$defs/digest"
        },
        "registry_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "same_observation_derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "derivation_revision",
        "original_observation",
        "resume_parent_processor",
        "canonical_parent_processor",
        "canonical_parent_readback",
        "composition_baseline",
        "derivation_processor_revision_sha256",
        "ancestor_generation_ids"
      ],
      "properties": {
        "schema_version": {
          "const": "datapan.same-observation-derivation.v1"
        },
        "derivation_revision": {
          "const": "same-observation-composition/v1"
        },
        "original_observation": {
          "$ref": "#/$defs/original_observation"
        },
        "resume_parent_processor": {
          "$ref": "#/$defs/processor_parent"
        },
        "canonical_parent_processor": {
          "$ref": "#/$defs/processor_parent"
        },
        "canonical_parent_readback": {
          "$ref": "#/$defs/canonical_parent_readback"
        },
        "composition_baseline": {
          "$ref": "#/$defs/composition_baseline"
        },
        "derivation_processor_revision_sha256": {
          "$ref": "#/$defs/digest"
        },
        "ancestor_generation_ids": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    "generation_inputs": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "source_scope", "baseline_sha256", "candidate_sha256", "observation_failure_sha256", "policy_sha256", "adapter_revision", "generator_revision", "extractor_revision"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "source_scope": {"type": "string", "minLength": 1},
        "baseline_sha256": {"$ref": "#/$defs/nullable_digest"},
        "candidate_sha256": {"$ref": "#/$defs/nullable_digest"},
        "observation_failure_sha256": {"$ref": "#/$defs/nullable_digest"},
        "policy_sha256": {"$ref": "#/$defs/digest"},
        "adapter_revision": {"$ref": "#/$defs/digest"},
        "generator_revision": {"$ref": "#/$defs/digest"},
        "extractor_revision": {"$ref": "#/$defs/digest"},
        "same_observation_derivation": {"$ref": "#/$defs/same_observation_derivation"}
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["observed_at", "producer_run_id", "refresh_evidence_sha256", "collection_status", "execution_mode"],
      "properties": {
        "observed_at": {"type": "string", "format": "date-time"},
        "producer_run_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "refresh_evidence_sha256": {"$ref": "#/$defs/nullable_digest"},
        "collection_status": {"enum": ["success", "failure", "missing"]},
        "execution_mode": {"enum": ["live", "fixture"]}
      }
    },
    "artifact_digest": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 128},
        "sha256": {"$ref": "#/$defs/digest"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 536870912}
      }
    },
    "output_artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "run_id", "name", "artifact_id", "expires_at", "bundle_manifest_sha256"],
      "properties": {
        "repository": {"type": "string", "minLength": 1, "maxLength": 200},
        "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "artifact_id": {"type": ["string", "null"], "maxLength": 128},
        "expires_at": {"type": "string", "format": "date-time"},
        "bundle_manifest_sha256": {"$ref": "#/$defs/nullable_digest"}
      }
    },
    "input_artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "name", "artifact_id", "expires_at", "candidate_sha256", "evidence_sha256", "diff_sha256"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "artifact_id": {"type": ["string", "null"], "maxLength": 128},
        "expires_at": {"type": "string", "format": "date-time"},
        "candidate_sha256": {"$ref": "#/$defs/nullable_digest"},
        "evidence_sha256": {"$ref": "#/$defs/nullable_digest"},
        "diff_sha256": {"$ref": "#/$defs/nullable_digest"}
      }
    },
    "lease": {
      "type": "object", "additionalProperties": false,
      "required": ["owner_run_id", "expires_at", "fencing_token"],
      "properties": {
        "owner_run_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "expires_at": {"type": "string", "format": "date-time"},
        "fencing_token": {"type": "integer", "minimum": 1}
      }
    },
    "detail_record": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source_sha256", "guide_sha256", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "source_sha256": {"$ref": "#/$defs/digest"},
        "guide_sha256": {"$ref": "#/$defs/nullable_digest"},
        "status": {"enum": ["retained_unchanged", "enriched", "retry", "quarantined"]},
        "failure_diagnostic": {"$ref": "#/$defs/failure_diagnostic"},
        "link_metadata": {"$ref": "#/$defs/link_metadata"}
      },
      "allOf": [{
        "if": {"anyOf": [
          {"required": ["failure_diagnostic"], "properties": {"failure_diagnostic": {"required": ["code"], "properties": {"code": {"const": "resolved_link_operation_contract_unproven"}}}}},
          {"required": ["link_metadata"]}
        ]},
        "then": {
          "required": ["link_metadata", "failure_diagnostic"],
          "properties": {
            "status": {"const": "quarantined"},
            "failure_diagnostic": {
              "required": ["code", "phase"],
              "properties": {"code": {"const": "resolved_link_operation_contract_unproven"}, "phase": {"const": "resolver"}}
            }
          }
        }
      }]
    },
    "link_metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "dataset_id", "public_data_pk", "public_data_detail_pk", "page", "resolver"],
      "properties": {
        "method": {"const": "data_go_kr_select_api_link_url_v1"},
        "dataset_id": {"type": "string", "pattern": "^[0-9]+$"},
        "public_data_pk": {"type": "string", "pattern": "^[0-9]+$"},
        "public_data_detail_pk": {"type": ["string", "null"], "maxLength": 256},
        "page": {
          "type": "object", "additionalProperties": false,
          "required": ["url", "effective_url", "sha256", "bytes", "observed_at"],
          "properties": {
            "url": {"type": "string", "format": "uri", "pattern": "^https://www\\.data\\.go\\.kr/data/[0-9]+/openapi\\.do$"},
            "effective_url": {"type": "string", "format": "uri", "pattern": "^https://www\\.data\\.go\\.kr/data/[0-9]+/openapi\\.do$"},
            "sha256": {"$ref": "#/$defs/digest"},
            "bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
            "observed_at": {"type": "string", "format": "date-time"}
          }
        },
        "resolver": {
          "type": "object", "additionalProperties": false,
          "required": ["request_url", "effective_url", "sha256", "bytes", "observed_at", "public_data_detail_pk", "resolved_url", "resolved_url_sha256"],
          "properties": {
            "request_url": {"type": "string", "format": "uri", "pattern": "^https://www\\.data\\.go\\.kr/tcs/dss/selectApiLinkUrl\\.do\\?publicDataPk=[0-9]+$"},
            "effective_url": {"type": "string", "format": "uri", "pattern": "^https://www\\.data\\.go\\.kr/tcs/dss/selectApiLinkUrl\\.do\\?publicDataPk=[0-9]+$"},
            "sha256": {"$ref": "#/$defs/digest"},
            "bytes": {"type": "integer", "minimum": 1, "maximum": 65536},
            "observed_at": {"type": "string", "format": "date-time"},
            "public_data_detail_pk": {"type": ["string", "null"], "maxLength": 256},
            "resolved_url": {"type": "string", "format": "uri", "pattern": "^https?://", "maxLength": 4096},
            "resolved_url_sha256": {"$ref": "#/$defs/digest"}
          }
        }
      }
    },
    "failure_diagnostic": {
      "type": "object", "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {"enum": ["timeout", "transport_error", "provider_http_error", "response_bytes_cap", "unsafe_redirect", "contract_or_parse_error", "missing_link_detail_operations", "unsafe_or_unregistered_operation_host", "observation_mismatch", "unexpected_error", "insufficient_budget_for_link_resolver", "resolved_link_operation_contract_unproven"]},
        "http_status": {"type": "integer", "minimum": 400, "maximum": 599},
        "phase": {"enum": ["page", "resolver"]}
      },
      "allOf": [{"if": {"properties": {"code": {"const": "provider_http_error"}}, "required": ["code"]}, "then": {}, "else": {"not": {"required": ["http_status"]}}}]
    }
  }
}
